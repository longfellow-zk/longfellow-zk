import LfzkV2.Current.MdocIdentifiers
import LfzkV2.Current.ProofOutput

/-! Golden vectors of the tagged transcript encoding (Rust commit 4, branch
tx-encoding): the exact SHA-256 preimages that the Rust tests
`runtime::v2::zk::tests::binary_zk_comparison` and
`mdoc::runtime::tests::next::test_all_next_zk` hash, written with the Lean
codecs and compared byte for byte by kernel evaluation.

- The standalone GF(2^128) proof's nodes 1 to 9: every per-boundary message
  kind of the deployed format (fingerprint response, sumcheck round, cross
  and claims, packing U and A, a Polygero response) and the seal node, each
  with its strand header and parent digest.
- The 1-attribute mdoc proof's node 0: the statement head, the session, the
  setup constants as recorded, both `PublicInputs` messages and the
  `Commitment`, which `TaggedFormat.first` writes from the request and root.
- The proof body's physical order on a small geometry, its frontier and seal.

The digests in the vectors (the parents and the Rust tests' pinned SHA-256
values) are SHA-256 outputs; the model treats SHA-256 as an oracle, so only
their preimages are compared. Field elements are their canonical
little-endian encodings; the raw codecs below read any such bytes. -/
noncomputable section
namespace LfzkV2.Current.Tests.TaggedFormat
open TranscriptV2.Framing (Byte FieldCodec encodeLE)
open TranscriptV2.Strand (Input)
open TaggedCodec

private def rawField (width : ℕ) (positive : 0 < width) (buffer : width ≤ 128) :
    FieldCodec (Fin width → Byte) where
  width := width
  positive := positive
  buffer := buffer
  encode := (PrefixCodec.vector PrefixCodec.byte width).encode
  decode bytes := do
    let (value,rest) ← (PrefixCodec.vector PrefixCodec.byte width).decode bytes
    if rest = [] then some value else none
  length value := by rw [PrefixCodec.bytes_encode,List.length_ofFn]
  inverse value := by
    have hi := (PrefixCodec.vector PrefixCodec.byte width).inverse value []
    simp only [List.append_nil] at hi
    simp [hi]
  canonical bytes value h := by
    simp only [Option.bind_eq_bind,Option.bind_eq_some_iff] at h
    obtain ⟨⟨decoded,rest⟩,hd,h⟩ := h
    split at h
    · rename_i hr
      cases Option.some.inj h
      have hc := (PrefixCodec.vector PrefixCodec.byte width).canonical bytes decoded rest hd
      change rest = [] at hr
      rw [hr,List.append_nil] at hc
      exact hc.symm
    · contradiction

private def fields : Fields
  | .binary => Fin 16 → Byte
  | .prime => Fin 32 → Byte

private def repr : ProofBodyCodec.Representations fields (Fin 3 → Byte) where
  binary := rawField 16 (by decide) (by decide)
  prime := rawField 32 (by decide) (by decide)
  binaryWidth := rfl
  primeWidth := rfl
  advice := PrefixCodec.vector PrefixCodec.byte 3
  adviceWidth := 3
  adviceLength value := by rw [PrefixCodec.bytes_encode,List.length_ofFn]
  adviceWrites := PrefixCodec.vector PrefixCodec.byte 3
  adviceWritesWidth := 3
  adviceWritesLength value := by rw [PrefixCodec.bytes_encode,List.length_ofFn]

/-- The standalone proof's profile: k = 8, s = 2, 64 columns, packing
degree 128 (one GF(2^128) element per 128 cells). -/
private def geometry : Geometry where
  binary := ⟨[⟨[],[],1⟩],[]⟩
  prime := ⟨[⟨[],[],1⟩],[]⟩
  binaryCells := 0
  primeCells := 0
  packingDegree := 128
  packingPositive := by decide
  rowDimension := 8
  maskingDegree := 2
  columns := 64
  openings := 2
  openingsPositive := by decide
  openings_lt := by decide
  openings_le := by decide
  responseFits := by decide
  productFits := by decide

/-- Byte `j` of a little-endian natural. -/
private def byteAt (n j : ℕ) : Byte := ⟨n / 256^j % 256,Nat.mod_lt _ (by decide)⟩

private def digest (n : ℕ) : Digest := fun j => byteAt n j.val
private def element16 (n : ℕ) : Fin 16 → Byte := fun j => byteAt n j.val
private def element32 (n : ℕ) : Fin 32 → Byte := fun j => byteAt n j.val
/-- Elements `i` of a little-endian concatenation of 16-byte elements. -/
private def slice16 (count n : ℕ) : Fin count → Fin 16 → Byte := fun i j => byteAt n (16*i.val+j.val)
private def slice32 (count n : ℕ) : Fin count → Fin 32 → Byte := fun i j => byteAt n (32*i.val+j.val)

/-- Long byte lists are compared by `List.beq`, whose kernel evaluation
does not nest. -/
private theorem eq_of_beq {a b : Bytes} (h : List.beq a b = true) : a = b :=
  beq_iff_eq.mp (h : (a == b) = true)

/-- A continuation node: its strand header, its one parent and its payload. -/
private def nodeInput (id : TranscriptV2.Strand.Word) (parent : ℕ) (payload : Bytes) : Bytes :=
  (Input.node id [digest parent] payload).encode

