/-! ## Standalone proof: one node per message kind -/

-- Node 1: both fingerprint responses of the one field, then ROUND.
example : nodeInput 1 d0 ((tagged TaggedFormat.fingerprintTag
      (elementPair (TaggedFormat.fieldId .binary) repr.binary)).encode (element16 v1a,element16 v1b) ++
      TaggedFormat.round) = encodeLE 120 n1 := by decide +kernel

-- Nodes 2 and 3: a sumcheck round's two coefficients.
example : nodeInput 2 d1 ((TaggedFormat.roleCodec (g := geometry) repr (.sumcheck .binary 0 0)).encode
      (element16 v2a,element16 v2b) ++ TaggedFormat.wire.terminator .sumcheck) = encodeLE 120 n2 := by
  decide +kernel

example : nodeInput 3 d2 ((TaggedFormat.roleCodec (g := geometry) repr (.sumcheck .binary 0 1)).encode
      (element16 v3a,element16 v3b) ++ TaggedFormat.wire.terminator .sumcheck) = encodeLE 120 n3 := by
  decide +kernel

-- Node 4: the cross coefficient; node 5: the two terminal claims.
example : nodeInput 4 d3 ((TaggedFormat.roleCodec (g := geometry) repr (.terminal .binary 0)).encode
      (element16 v4) ++ TaggedFormat.wire.terminator .terminal) = encodeLE 104 n4 := by decide +kernel

example : nodeInput 5 d4 ((TaggedFormat.roleCodec (g := geometry) repr (.combine .binary 0 [] [] true)).encode
      (element16 v5a,element16 v5b) ++ TaggedFormat.wire.terminator .combine) = encodeLE 120 n5 := by
  decide +kernel

-- Node 6: packing U, one element per coordinate.
example : nodeInput 6 d5 ((TaggedFormat.roleCodec (g := geometry) repr .packing).encode
      (slice16 128 v6) ++ TaggedFormat.wire.terminator .packing) = encodeLE 2136 n6 := by decide +kernel

-- Node 7: packing A, the batching boundary's message at degree 128.
example : nodeInput 7 d6 ((tagged TaggedFormat.packingATag
      (element (TaggedFormat.fieldId .binary) repr.binary)).encode (element16 v7) ++
      TaggedFormat.wire.terminator .batching) = encodeLE 104 n7 := by decide +kernel

-- Node 8: the Polygero response, H on k+s nodes then Z on 2k.
example : nodeInput 8 d7 ((TaggedFormat.response (g := geometry) repr .binary).encode
      ⟨slice16 10 v8h,slice16 16 v8z⟩ ++ TaggedFormat.wire.terminator .opening) = encodeLE 528 n8 := by
  decide +kernel

-- Node 9: the seal node frames the whole proof (its magic included).
example : nodeInput 9 d8 (TaggedFormat.wire.sealFrame (encodeLE 3844 body9)) = encodeLE 3924 n9 := by
  decide +kernel


/-! ## Mdoc proof: node 0

The vector's node 0 in consecutive slices: the root header, the statement
head with the session, the setup constants, the two `PublicInputs`
messages, and the `Commitment` with ROUND. Long slices are written as
32-byte little-endian chunks, which the kernel decodes cheaply. -/

-- Messages about these long byte lists print only their head, and the
-- large kernel evaluations run one at a time.
set_option pp.deepTerms false
set_option pp.maxSteps 1000
set_option Elab.async false

/-- Whole 32-byte little-endian chunks, then a last partial chunk. -/
private def bytesOf (chunks : List ℕ) (lastLength last : ℕ) : Bytes :=
  chunks.flatMap (encodeLE 32) ++ encodeLE lastLength last

/-- The kernel evaluates `List.ofFn` at a depth of its length, so long
vectors are split into short ones first. -/
private theorem ofFn_split {α : Type} (a b : ℕ) {f : Fin (a+b) → α} :
    List.ofFn f = List.ofFn (fun i : Fin a => f (Fin.castAdd b i)) ++
      List.ofFn (fun j : Fin b => f (Fin.natAdd a j)) :=
  List.ofFn_add

