import LfzkV2.Current.TaggedGrammar
import LfzkV2.Current.MdocRuntime

/-! The deployed registry parses the Rust golden node payloads at the v2 tip
(`runtime::v2` golden tests): the 1-attribute mdoc statement node and every
node of the standalone GF(2^128) proof, each to one `Grammar` node with
nothing left over, the last one sealed. Kernel evaluation, no native code. -/
namespace LfzkV2.Current.Tests.TaggedGrammar
open TranscriptV2.Framing (encodeLE)
open LfzkV2.Current.TaggedGrammar

/-- The payload is one node with the given terminator and no trailing byte. -/
private def parses (payload : Bytes) (terminal : Grammar.End) : Bool :=
  match (Grammar.node table registry).decode payload with
  | some (node,[]) => decide (node.terminal = terminal)
  | _ => false

/-- Bytes from little-endian chunks of at most 64 bytes. -/
private def chunks (parts : List (ℕ × ℕ)) : Bytes := parts.flatMap fun part => encodeLE part.1 part.2

