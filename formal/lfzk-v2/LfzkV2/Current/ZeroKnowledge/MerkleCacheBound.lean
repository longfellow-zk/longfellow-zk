import LfzkV2.Current.ZeroKnowledge.MerkleCache

/-! Hiding with a retained background oracle. The only newly programmed
points are honest commitment inputs. The error has the same collision and
hidden-nonce terms as the empty-cache proof; prior-query freshness is charged
by the separate causal refresh argument. -/
noncomputable section
namespace LfzkV2.Current.ZeroKnowledge.MerkleCache
open Merkle Merkle.MH Merkle.RandomOracle Finset
open scoped Classical

variable {Salt Message Digest Enc Observed : Type}
variable [Inhabited Digest] [DecidableEq Enc]
variable [Fintype Salt] [DecidableEq Salt] [Fintype Digest] [DecidableEq Digest]
variable [DecidableEq Observed]
variable (C : Codec Salt Message Digest Enc) (n : ℕ) (I : Finset (Fin n))
variable {T queries : ℕ} (background : Enc → Digest)
variable (first second : (Fin T → Digest) → Fin n → Message) (different : Finset (Fin n))
variable (observer : (Fin T → Digest) → OpeningView n I Salt Digest → Tree Enc Digest Observed queries)
variable (fits : 2*n-2 < T)

/-- Root, authentication and post-proof oracle access are generated by one
prepared total oracle. Its noncommitment answers retain the prior table. -/
def experiment (messages : (Fin T → Digest) → Fin n → Message)
    (sample : HidingSample n T Salt Digest) : Observed :=
  ((observer sample.2 (openingView C n sample.1 (messages sample.2) sample.2 background I)).run
    (prepared C n sample.1 (messages sample.2) sample.2 background)).1

def bad : Finset (HidingSample n T Salt Digest) :=
  univ.filter fun sample =>
    ¬ commitInputsInjective C n sample.1 (first sample.2)
      (commitOracle C n sample.1 (first sample.2) sample.2) ∨
    ¬ commitInputsInjective C n sample.1 (second sample.2)
      (commitOracle C n sample.1 (second sample.2) sample.2) ∨
    ∃ qa ∈ ((observer sample.2 (openingViewOf n I sample.1 sample.2 fits)).run
        (prepared C n sample.1 (first sample.2) sample.2 background)).2,
      ∃ i ∈ different,
        qa.1 = C.leafEnc (sample.1 i,first sample.2 i) ∨
        qa.1 = C.leafEnc (sample.1 i,second sample.2 i)

omit [DecidableEq Salt] [DecidableEq Digest] [DecidableEq Observed] in
theorem experiment_eq_off_bad (positive : 0 < n) (fitsAll : 2*n-1 ≤ T)
    (agree : ∀ labels i, i ∉ different → first labels i = second labels i)
    (sample : HidingSample n T Salt Digest)
    (good : sample ∉ bad C n I background first second different observer fits) :
    experiment C n I background observer first sample =
      experiment C n I background observer second sample := by
  rw [bad] at good
  simp only [mem_filter,mem_univ,true_and,not_or] at good
  obtain ⟨hfirst,hsecond,miss⟩ := good
  have hfirst := not_not.mp hfirst
  have hsecond := not_not.mp hsecond
  unfold experiment
  rw [openingView_eq C n sample.1 (first sample.2) sample.2 background positive I hfirst fits fitsAll,
    openingView_eq C n sample.1 (second sample.2) sample.2 background positive I hsecond fits fitsAll]
  apply congrArg Prod.fst
  symm
  apply Tree.run_congr_on_trace
  intro qa hqa
  rw [Tree.trace_sound _ _ qa hqa]
  apply prepared_compatible
  apply commitSeen_baseCompat C n positive sample.1 sample.1 (second sample.2) (first sample.2)
    sample.2 hsecond hfirst fits different (fun i hi => ⟨rfl,(agree sample.2 i hi).symm⟩)
  intro i hi
  have absent : qa.1 ≠ C.leafEnc (sample.1 i,first sample.2 i) ∧
      qa.1 ≠ C.leafEnc (sample.1 i,second sample.2 i) := by
    constructor <;> intro equal
    · exact miss ⟨qa,hqa,i,hi,Or.inl equal⟩
    · exact miss ⟨qa,hqa,i,hi,Or.inr equal⟩
  exact absent.symm

omit [DecidableEq Observed] in
theorem bad_card_le (positive : 0 < n) (injective : C.Inj)
    (hidden : ∀ i ∈ different, i ∉ I)
    (first_injective : ∀ labels i, Function.Injective fun nonce : Salt => C.leafEnc (nonce,first labels i))
    (second_injective : ∀ labels i, Function.Injective fun nonce : Salt => C.leafEnc (nonce,second labels i)) :
    (bad C n I background first second different observer fits).card ≤
      openingHidingNumerator (Fintype.card Salt) (Fintype.card Digest) n queries T different.card := by
  let collision (messages : (Fin T → Digest) → Fin n → Message) :=
    univ.filter fun sample : HidingSample n T Salt Digest =>
      ¬ commitInputsInjective C n sample.1 (messages sample.2)
        (commitOracle C n sample.1 (messages sample.2) sample.2)
  let hit (i : Fin n) := univ.filter fun sample : HidingSample n T Salt Digest =>
    commitInputsInjective C n sample.1 (first sample.2)
      (commitOracle C n sample.1 (first sample.2) sample.2) ∧
    (C.leafEnc (sample.1 i,first sample.2 i) ∈
      ((observer sample.2 (openingViewOf n I sample.1 sample.2 fits)).run
        (prepared C n sample.1 (first sample.2) sample.2 background)).2.map Prod.fst ∨
    C.leafEnc (sample.1 i,second sample.2 i) ∈
      ((observer sample.2 (openingViewOf n I sample.1 sample.2 fits)).run
        (prepared C n sample.1 (first sample.2) sample.2 background)).2.map Prod.fst)
  have cover : bad C n I background first second different observer fits ⊆
      (collision first ∪ collision second) ∪ different.biUnion hit := by
    intro sample hs
    simp only [bad,mem_filter,mem_univ,true_and] at hs
    by_cases hfirst : commitInputsInjective C n sample.1 (first sample.2)
        (commitOracle C n sample.1 (first sample.2) sample.2)
    · rcases hs with h | h | ⟨qa,hqa,i,hi,equal⟩
      · exact (h hfirst).elim
      · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨mem_univ _,h⟩))
      · apply mem_union_right
        apply mem_biUnion.mpr
        refine ⟨i,hi,mem_filter.mpr ⟨mem_univ _,hfirst,?_⟩⟩
        rcases equal with equal | equal
        · exact Or.inl (List.mem_map.mpr ⟨qa,hqa,equal⟩)
        · exact Or.inr (List.mem_map.mpr ⟨qa,hqa,equal⟩)
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨mem_univ _,hfirst⟩))
  have collision_le (messages : (Fin T → Digest) → Fin n → Message)
      (nonce_injective : ∀ labels i, Function.Injective fun nonce : Salt => C.leafEnc (nonce,messages labels i)) :
      (collision messages).card ≤
        2*((Fintype.card Digest)^T*(n^2*(Fintype.card Salt)^(n-1))) +
          (Fintype.card Salt)^n*((2*n-1)*(2*n-2)/2*(Fintype.card Digest)^(T-1)) := by
    apply le_trans (card_le_card ?_)
      (commitInjective_failure_card_le C n positive T messages (by omega) injective nonce_injective)
    intro sample hs
    exact mem_filter.mpr ⟨mem_univ _,(mem_filter.mp hs).2⟩
  have hit_le : ∀ i ∈ different,
      (hit i).card ≤ (Fintype.card Salt)^(n-1)*(Fintype.card Digest)^T*(2*queries) := by
    intro i hi
    have hidden_i := hidden i hi
    apply leafCatch_prod_card_le C n positive background first second fits i
      (fun rest labels => observer labels
        ⟨labels ⟨2*n-2,fits⟩,
          { nonce := fun j => rest ⟨j.val,fun same => hidden_i (same ▸ j.property)⟩
            frontierValue := fun vertex => labels ⟨2*n-1-vertex.val,by
              have h := Heap.mem_frontier_iff.mp vertex.property
              rw [Heap.mem_nodes] at h
              omega⟩ }⟩)
      (fun labels => first_injective labels i) (fun labels => second_injective labels i)
      (hit i) (fun sample hs => (mem_filter.mp hs).2.1)
    intro sample hs
    exact (mem_filter.mp hs).2.2
  apply le_trans (card_le_card cover)
  apply le_trans ((card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _))
  rw [openingHidingNumerator]
  apply Nat.add_le_add
  · have hfirst := collision_le first first_injective
    have hsecond := collision_le second second_injective
    omega
  · apply le_trans card_biUnion_le
    apply le_trans (sum_le_sum hit_le)
    rw [sum_const,smul_eq_mul]

include fits in
/-- A full retained-cache opening experiment is statistically hiding. This
is conditional on no guessed commitment input only in the separate refresh
step; the hiding bound here quantifies every backend nonce and common label.
The observer sees neither hidden columns nor the background table. -/
theorem opening_hiding [Nonempty Salt] (positive : 0 < n) (fitsAll : 2*n-1 ≤ T) (injective : C.Inj)
    (hidden : ∀ i ∈ different, i ∉ I)
    (agree : ∀ labels i, i ∉ different → first labels i = second labels i)
    (first_injective : ∀ labels i, Function.Injective fun nonce : Salt => C.leafEnc (nonce,first labels i))
    (second_injective : ∀ labels i, Function.Injective fun nonce : Salt => C.leafEnc (nonce,second labels i)) :
    StatClose (MerkleSimulation.openingError
      (Fintype.card Salt) (Fintype.card Digest) n different.card queries)
      (experiment C n I background observer first) (experiment C n I background observer second) := by
  have counted : CountingClose
      (openingHidingNumerator (Fintype.card Salt) (Fintype.card Digest) n queries T different.card)
      (experiment C n I background observer first) (experiment C n I background observer second) := by
    apply CountingClose.of_certificate
    exact ⟨bad C n I background first second different observer fits,
      bad_card_le C n I background first second different observer fits positive injective hidden
        first_injective second_injective,
      experiment_eq_off_bad C n I background first second different observer fits positive fitsAll agree⟩
  apply StatClose.mono _ (LfzkV1.ZkMerkle.statClose_of_countingClose counted)
  rw [Fintype.card_prod,Fintype.card_fun,Fintype.card_fin,Fintype.card_fun,Fintype.card_fin]
  push_cast
  exact MerkleSimulation.openingNumerator_ratio_le _ _ _ _ _ _
    Fintype.card_pos Fintype.card_pos positive (by omega)

end LfzkV2.Current.ZeroKnowledge.MerkleCache
