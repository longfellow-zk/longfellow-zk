      Acc mt p.1 p.2.1 p.2.2 ∧
        extract mt p.1 p.2.1 p.2.2 = none) :
    let Ssetup := setup2 body rootOf₁ rootOf₂ avOf pubOf msgOf₁ msgOf₂
