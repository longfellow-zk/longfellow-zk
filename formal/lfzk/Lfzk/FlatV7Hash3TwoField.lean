        (Ssetup.proof ω.1 ω.2) (Ssetup.challenges ω.1 ω.2)).card : ℚ) /
      ((Fintype.card D : ℚ) ^ TM *
        (Fintype.card C : ℚ) ^ Fintype.card
          (Pt2 D C X Msg₁ Msg₂ v7Hash3.params.nl v7SigHahn.params.nl
            v7Hash3.params.rounds v7SigHahn.params.rounds)) ≤
      keyBound +
