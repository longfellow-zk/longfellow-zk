        ((v7Hash3_flatSide H).LD (σ mt key)) (ms₁ mt key)) tape₁ ∧
    ZkLayerStepAccepts .accepted .start
      (steps (nl := v7SigHahn.params.nl) (w := v7SigHahn.params.rounds)
        (L₂.toZkSide.V (σ mt key))
        (L₂.toZkSide.LD (σ mt key)) (ms₂ mt key)) tape₂
