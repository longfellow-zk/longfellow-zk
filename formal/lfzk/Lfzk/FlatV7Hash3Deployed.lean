          pubOf (Ssetup.proof mt ro)) a₁ ∧
      L₂.toZkSide.Good
        (Ssetup.context mt ro, avOf (Ssetup.proof mt ro),
          pubOf (Ssetup.proof mt ro)) a₂ ∧
      common₁ a₁ = common₂ a₂ := Iff.rfl

