import polygero.Algebra.PolynomialChallenges.Shift.Growth
import polygero.Algebra.PolynomialChallenges.Shift.Residual

namespace RecursivePolygero.Local.Shift
open Polynomial Finset Submodule RecursivePolygero.Local Codes
variable {F : Type*} [Field F] {n k m s : ℕ}

theorem shift_pow_evaluate (x : Fin n → F) (p : F[X]) (j : ℕ) :
    ((shift x)^j) (evaluate x p) = evaluate x (X^j*p) := by
  ext i
  simp [shift_pow_apply, evaluate]

theorem evalSpace_le_growth (x : Fin n → F) (U : Submodule F (Fin n → F))
    (a r : ℕ) (ha : 1 ≤ a) (hE : evalSpace x a ≤ U) :
    evalSpace x (a+r) ≤ growthChain (shift x) U r := by
  apply (evalSpace_le_iff x _ _).mpr
  intro j hj
  let b := min r j
  have hb : b ≤ r := min_le_left _ _
  have hbj : b ≤ j := min_le_right _ _
  have hc : j-b < a := by dsimp [b]; omega
  have h := shift_mem_growthChain (shift x) U (evaluate x (X^(j-b)))
    (hE ((evalSpace_le_iff x a _).mp le_rfl _ hc)) b
  rw [shift_pow_evaluate, ← pow_add, Nat.add_sub_of_le hbj] at h
  exact growthChain_mono (shift x) U hb h

theorem multiplyWord_mem (x : Fin n → F) (U : Submodule F (Fin n → F))
    (w : Fin n → F) (p : F[X]) (hp : p ∈ degreeLT F (s+1))
    (h : ∀ j ≤ s, ((shift x)^j) w ∈ U) : multiplyWord x p w ∈ U := by
  classical
  have he : multiplyWord x p w = ∑ j ∈ p.support, p.coeff j • ((shift x)^j) w := by
    ext i
    simp only [multiplyWord, Polynomial.eval_eq_sum, Polynomial.sum,
      Finset.sum_apply, Pi.smul_apply, smul_eq_mul, shift_pow_apply, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [he]
  apply U.sum_mem
  intro j hj
  apply U.smul_mem
  apply h
  have hz := (Polynomial.degree_lt_iff_coeff_zero _ _).mp (mem_degreeLT.mp hp)
  by_contra hn
  exact (Polynomial.mem_support_iff.mp hj) (hz j (by omega))

noncomputable def seed (x : Fin n → F) (W : Fin m → Word F n) (k : ℕ) :=
  evalSpace x k ⊔ Submodule.span F (Set.range W)

/-- The space generated by the evaluation code and successive shifts of the rows. -/
noncomputable def receivedSpace (x : Fin n → F) (W : Fin m → Word F n) (k s : ℕ) :=
  growthChain (shift x) (seed x W k) s

theorem aggregateSpace_eq_receivedSpace (C : RSCode F n (k+s)) (W : Fin m → Word F n)
    (hk : 1 ≤ k) : aggregateSpace C W s = receivedSpace C.node W k s := by
  apply le_antisymm
  · apply sup_le (evalSpace_le_growth C.node _ k s hk le_sup_left)
    rintro _ ⟨B,rfl⟩
    change response C W B ∈ _
    have he : response C W B = ∑ i, multiplyWord C.node (B i).1 (W i) := by
      ext j; simp [response,multiplyWord]
    rw [he]
    apply Submodule.sum_mem
    intro i _
    apply multiplyWord_mem C.node _ _ _ (B i).2
    intro j hj
    apply growthChain_mono (shift C.node) (seed C.node W k) hj
    exact shift_mem_growthChain _ _ _ ((show Submodule.span F (Set.range W) ≤ seed C.node W k from le_sup_right) (Submodule.subset_span ⟨i,rfl⟩)) j
  · apply growthChain_le
    intro w hw j hj
    have hs : seed C.node W k ≤ (aggregateSpace C W s).comap ((shift C.node)^j) := by
      apply sup_le
      · rintro _ ⟨p,hp,rfl⟩
        change ((shift C.node)^j) (evaluate C.node p) ∈ aggregateSpace C W s
        rw [shift_pow_evaluate]
        apply (show evalSpace C.node (k+s) ≤ aggregateSpace C W s from le_sup_left)
        refine ⟨X^j*p, ?_, rfl⟩
        apply mem_degreeLT.mpr
        have hd := Polynomial.degree_mul_le (X^j : F[X]) p
        rw [degree_X_pow] at hd
        have hpd := mem_degreeLT.mp hp
        calc
          (X^j*p).degree ≤ (j : WithBot ℕ)+p.degree := hd
          _ < (j : WithBot ℕ)+(k : WithBot ℕ) := WithBot.add_lt_add_left (by simp) hpd
          _ ≤ ((k+s : ℕ) : WithBot ℕ) := by exact_mod_cast (show j+k ≤ k+s by omega)
      · apply Submodule.span_le.mpr
        rintro _ ⟨i,rfl⟩
        exact row_shift_mem C W i j hj
    exact hs hw

/-- The last increment is at most one: otherwise all `s+1` preceding
increments, including the one from `Eval_(k-1)`, would be at least two. -/
theorem slow_growth (x : Fin n → F) (hx : Function.Injective x)
    (W : Fin m → Word F n) (k s : ℕ) (hk : 1 ≤ k) (hR : k+s ≤ n)
    (hbudget : Module.finrank F (receivedSpace x W k s) ≤ k+2*s) :
    Module.finrank F (grow (shift x) (receivedSpace x W k s)) ≤
      Module.finrank F (receivedSpace x W k s)+1 := by
  let V := growthChain (shift x) (seed x W k)
  by_contra hn
  have hfast : ∀ j ≤ s, Module.finrank F (V j)+2 ≤ Module.finrank F (V (j+1)) := by
    intro j hj
    induction hj using Nat.decreasingInduction with
    | self =>
      change Module.finrank F (V s)+2 ≤ Module.finrank F (grow (shift x) (V s))
      exact Nat.succ_le_of_lt (lt_of_not_ge hn)
    | of_succ j _ ih =>
      have hb := quotient_growth_bound (shift x) (V j) (V (j+1))
        le_sup_left le_sup_right
      change Module.finrank F (V (j+1+1))+_ ≤ _ at hb
      omega
  have hbase := quotient_growth_bound (shift x) (evalSpace x (k-1)) (seed x W k)
    ((evalSpace_mono x (by omega)).trans le_sup_left) (by
      rintro _ ⟨w,⟨p,hp,rfl⟩,rfl⟩
      rw [shift_evaluate]
      apply (show evalSpace x k ≤ seed x W k from le_sup_left)
      refine ⟨X*p, ?_, rfl⟩
      apply mem_degreeLT.mpr
      rw [Polynomial.degree_lt_iff_coeff_zero]
      intro j hj
      obtain ⟨j,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
      rw [coeff_X_mul]
      exact (Polynomial.degree_lt_iff_coeff_zero _ _).mp (mem_degreeLT.mp hp) j (by omega))
  rw [finrank_evalSpace x hx (by omega)] at hbase
  have hb : k+1 ≤ Module.finrank F (V 0) := by
    have hf := hfast 0 (by omega)
    change Module.finrank F (V 0)+2 ≤ Module.finrank F (V 1) at hf
    change Module.finrank F (V 1)+(k-1) ≤ 2*Module.finrank F (V 0) at hbase
    omega
  have lower : ∀ j ≤ s, k+1+2*j ≤ Module.finrank F (V j) := by
    intro j
    induction j with
    | zero => intro _; simpa using hb
    | succ j ih => intro hj; have := ih (by omega); have := hfast j (by omega); omega
  have hl := lower s le_rfl
  change k+1+2*s ≤ Module.finrank F (receivedSpace x W k s) at hl
  omega

end RecursivePolygero.Local.Shift
