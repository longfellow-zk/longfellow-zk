{
  "protocol": "Scalar Ligero V1, V2, V3; one repetition; V2 and V3 preserve the full witness layout",
  "probability_model": "Public-coin IOP; oracle committed before the uniform challenge; response precedes the independent uniform fixed-size column query",
  "interactive_bound": "For every false statement, acceptance probability <= 2^(-target_bits)",
  "extraction_bound": "For every statement and prover, probability of acceptance and failure of the response-assisted extractor <= 2^(-target_bits)",
  "uniform_envelope_bound": "A single envelope fixed from the oracle and statement dominates every response; its challenge mean <= 2^(-target_bits)",
  "scope": "Ligero components only; excludes sumcheck, Merkle binding, and adaptive Fiat-Shamir compilation. Exact Lean-certified bounds with no global optimality claim.",
  "extractor": "Decode the full proximity-tested matrix first on the supplied response agreement columns, allowing g common errors; then check the original constraints. No access to sampled queries. Finite mathematical specification; no execution-time theorem.",
