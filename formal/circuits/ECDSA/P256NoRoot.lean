module

public import ECDSA.NoRoot
public import ECDSA.Pratt

/-!
# The P-256 cubic has no root in `F_p`

`x^3 - 3x + b` is the P-256 curve equation, so this is exactly
`CurveHasNoPointsOfOrder2 p256_params`.  Everything below is a *checked certificate*:

* `rTri` is `X^p mod f`, verified by reducing `powTri` in the kernel;
* `U, V` are Bezout polynomials with `U*f + V*g = 1` where `g = rTri - X`;
* `W` witnesses that identity integrally, `U*f + V*g - 1 = p*W` over `ZZ`, which is what lets
  `linear_combination` discharge it with `ring` -- `ring` cannot reduce modulo `p`, but it can
  verify an identity that holds over `ZZ`, and `(p : ZMod p) = 0` removes the remainder.
-/

@[expose] public section

set_option maxRecDepth 100000
set_option exponentiation.threshold 400

namespace ECDSA

abbrev pp : ℕ := 115792089210356248762697446949407573530086143415290314195533631308867097853951
abbrev aa : ℕ := 115792089210356248762697446949407573530086143415290314195533631308867097853948
abbrev bb : ℕ := 41058363725152142129326129780047268409114441015993725554835256314039467401291

/-- `X^p mod (X^3 + aa*X + bb)`, as advice. -/
def rTri : Tri := (66434390973925144466073271287821796038003695194169110494110089305650096453661, 12402202686218762177567235911775779164004716598278868847786114277539554646092, 24678849118215552148312087830792888746041224110560601850711771001608500700145)

theorem rTri_ok : powTri pp aa bb 300 (0, 1, 0) pp = rTri := by decide

instance : Fact (Nat.Prime pp) := ⟨prime_115792089210356248762697446949407573530086143415290314195533631308867097853951⟩

theorem p256_cubic_no_root (x : ZMod pp) :
    x ^ 3 + (aa : ZMod pp) * x + (bb : ZMod pp) ≠ 0 := by
  intro h1
  -- `x` is also a root of `g = rTri - X`, because `x^p = x`.
  have hx : evalTri rTri x = x := by
    have h := evalTri_powTri pp aa bb x h1 300 (0, 1, 0) pp (by decide)
    rw [rTri_ok] at h
    simpa [evalTri, ZMod.pow_card] using h
  have h2 : (66434390973925144466073271287821796038003695194169110494110089305650096453661 : ZMod pp) + (12402202686218762177567235911775779164004716598278868847786114277539554646092 : ZMod pp) * x + (24678849118215552148312087830792888746041224110560601850711771001608500700145 : ZMod pp) * x ^ 2 - x = 0 := by
    simp only [evalTri, rTri] at hx
    push_cast at hx
    linear_combination hx
  have hp : (115792089210356248762697446949407573530086143415290314195533631308867097853951 : ZMod pp) = 0 := by exact_mod_cast ZMod.natCast_self pp
  push_cast at h1
  have : (1 : ZMod pp) = 0 := by
    linear_combination ((107286402702237026811154678719514266289498743974321057492273529440068429825344 : ZMod pp) + (6389611969556882025875921584714237703390037729321797349080302270353162149340 : ZMod pp) * x) * h1 + ((76626890310466861426869089647039036757962535851890885406097439786770458211455 : ZMod pp) + (74462945259064871768191128030512052509059297803194871526163573358218695456204 : ZMod pp) * x + (34768139465301476436978405170953382516735956999154666452188405812258086013549 : ZMod pp) * x^2) * h2 - ((82006162939704079939581181709976996092266308199183309578158969013154857761758 : ZMod pp) + (160481657210292944356723964264545526708873436893099286578027577197691306529851 : ZMod pp) * x + (50644519275446308109248730646041827234392125521364766985800694765571451422148 : ZMod pp) * x^2 + (19594268650736750401918991328041959909110035062448741686819397381038349806533 : ZMod pp) * x^3 + (7410157929066101016865484023617449031630549387091645260359016622210978818695 : ZMod pp) * x^4) * hp
  exact one_ne_zero this

end ECDSA

end
