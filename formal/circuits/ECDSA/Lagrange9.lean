/-! ## The range check

`valid_index` asserts that the 9-point interpolant through `(node_i, δ_{i,8})` vanishes on the
wire. That polynomial has degree 8 with roots exactly at nodes `0 … 7`, so factoring it is what
turns the assertion into "the wire carries one of the eight digits". -/

/-- The range interpolant, factored. -/
theorem range_factor (u : F) :
    (0 : F) + (22951646254195613594034672520329001181856360569816472992328987634436156896051 : F) * u + (46290989235658044985265876671068965221514348851960926947366235195129681307238 : F) * u ^ 2 + (79838243454675319784905019194370169839364083085733590768673926517910708181765 : F) * u ^ 3 + (82349836188307070449799031742676004686224350020273145218292760382780774681440 : F) * u ^ 4 + (2568131839691494926985173411074100263623004309254051673347121770782599262299 : F) * u ^ 5 + (43743049933845030151884689282412102606735179319390624282493501962172986603019 : F) * u ^ 6 + (10292719896644459801544679666713638703335852013699955701862875620956301607276 : F) * u ^ 7 + (59182634592258681856541808433042991602960053209357651560499675107053086627885 : F) * u ^ 8
      = (59182634592258681856541808433042991602960053209357651560499675107053086627885 : F) * (u + 8) * (u + 6) * (u + 4) * (u + 2) * u * (u - 2) * (u - 4) * (u - 6) := by
  linear_combination ((0 : F) + (9421 : F) * u + (1178 : F) * u ^ 2 + (-3205 : F) * u ^ 3 + (-400 : F) * u ^ 4 + (229 : F) * u ^ 5 + (29 : F) * u ^ 6 + (-4 : F) * u ^ 7 + (0 : F) * u ^ 8) * hp (F := F)

/-- The leading coefficient is a unit, so it cannot absorb the vanishing. -/
theorem range_lead_ne_zero : (59182634592258681856541808433042991602960053209357651560499675107053086627885 : F) ≠ 0 := by
  have h : ((59182634592258681856541808433042991602960053209357651560499675107053086627885 : ℕ) : F) ≠ 0 := by
    rw [Ne, CharP.cast_eq_zero_iff F 115792089210356248762697446949407573530086143415290314195533631308867097853951]
    norm_num
  simpa using h

/-- **What `valid_index` buys.** The wire carries one of the eight lookup nodes. -/
theorem isDigit_of_range (u : F)
    (h : (0 : F) + (22951646254195613594034672520329001181856360569816472992328987634436156896051 : F) * u + (46290989235658044985265876671068965221514348851960926947366235195129681307238 : F) * u ^ 2 + (79838243454675319784905019194370169839364083085733590768673926517910708181765 : F) * u ^ 3 + (82349836188307070449799031742676004686224350020273145218292760382780774681440 : F) * u ^ 4 + (2568131839691494926985173411074100263623004309254051673347121770782599262299 : F) * u ^ 5 + (43743049933845030151884689282412102606735179319390624282493501962172986603019 : F) * u ^ 6 + (10292719896644459801544679666713638703335852013699955701862875620956301607276 : F) * u ^ 7 + (59182634592258681856541808433042991602960053209357651560499675107053086627885 : F) * u ^ 8 = 0) :
    u = -8 ∨ u = -6 ∨ u = -4 ∨ u = -2 ∨ u = 0 ∨ u = 2 ∨ u = 4 ∨ u = 6 := by
  have hlead : (59182634592258681856541808433042991602960053209357651560499675107053086627885 : F) ≠ 0 := range_lead_ne_zero (F := F)
  rw [range_factor] at h
  simp only [mul_eq_zero] at h
  rcases h with ((((((((h | h) | h) | h) | h) | h) | h) | h) | h)
  · exact absurd h hlead
  · exact Or.inl (by linear_combination h)
  · exact Or.inr (Or.inl (by linear_combination h))
  · exact Or.inr (Or.inr (Or.inl (by linear_combination h)))
  · exact Or.inr (Or.inr (Or.inr (Or.inl (by linear_combination h))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (by linear_combination h)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (by linear_combination h))))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (by linear_combination h)))))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (by linear_combination h)))))))

