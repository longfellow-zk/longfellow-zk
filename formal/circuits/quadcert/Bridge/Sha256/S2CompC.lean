/-- **The schedule recurrence for `W28`, over the deployed circuit.** -/
theorem sched28 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS28.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 28))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 13)))
          + SHA256.ofBits (bitsOf inputs (wordBits 21))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 26)))
          + SHA256.ofBits (bitsOf inputs (wordBits 12))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS28 inputs i = 0 ∨ lvS28 inputs i = 1 :=
    lvBits28 inputs hin0 hbz
  have hone : lvS28 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS28a (lvS28 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS28a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS28a (lvS28 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS28b (lvS28 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS28b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS28b (lvS28 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS28c (lvS28 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS28c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS28c (lvS28 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS28d (lvS28 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS28d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS28d (lvS28 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS28 (lvS28 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS28_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS28p (lvS28 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS28a (lvS28 inputs)) (gS28b (lvS28 inputs)) (gS28c (lvS28 inputs))
      (gS28d (lvS28 inputs)) (dsS28 (lvS28 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 21993)
      hma hmb hmc hmd hmp (by norm_num [gS28a]) (by norm_num [gS28b])
      (by norm_num [gS28c]) (by norm_num [gS28d]) (by norm_num [dsS28]) (by norm_num)
      (zval_S28 inputs hin0) (allWrap4 inputs hin0 hroot 12 (by norm_num))
  rw [gS28a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS28a (lvS28 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS28a (lvS28 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS28b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS28b (lvS28 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS28b (lvS28 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS28c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS28c (lvS28 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS28c (lvS28 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS28d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS28d (lvS28 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS28d (lvS28 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS28_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS28p (lvS28 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS28p (lvS28 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 13))) := by
    rw [hvA, ← bwS28a_eq, SHA256.sigma0_bits (bwS28a inputs) (by rfl)
      (fun b hb => by rw [bwS28a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS28a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 26))) := by
    rw [hvC, ← bwS28c_eq, SHA256.sigma1_bits (bwS28c inputs) (by rfl)
      (fun b hb => by rw [bwS28c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS28c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 21)) := by
    rw [hvB, ← bwS28b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 12)) := by
    rw [hvD, ← bwS28d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 28)) := by
    rw [hvP, ← bwS28p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

/-! #### Composition for `W29` -/

/-- The cone's leaf valuation. -/
noncomputable def lvS29 (inputs : Nat → F) : Nat → F :=
  fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS29.getD h 0)

noncomputable def vS29a (lv : Nat → F) : Nat → F
  | 0 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS29 260) (lv 153)
  | 1 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS29 216) (lv 152)
