/-- **The schedule recurrence for `W33`, over the deployed circuit.** -/
theorem sched33 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS33.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 33))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 18)))
          + SHA256.ofBits (bitsOf inputs (wordBits 26))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 31)))
          + SHA256.ofBits (bitsOf inputs (wordBits 17))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS33 inputs i = 0 ∨ lvS33 inputs i = 1 :=
    lvBits33 inputs hin0 hbz
  have hone : lvS33 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS33a (lvS33 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS33a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS33a (lvS33 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS33b (lvS33 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS33b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS33b (lvS33 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS33c (lvS33 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS33c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS33c (lvS33 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS33d (lvS33 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS33d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS33d (lvS33 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS33 (lvS33 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS33_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS33p (lvS33 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS33a (lvS33 inputs)) (gS33b (lvS33 inputs)) (gS33c (lvS33 inputs))
      (gS33d (lvS33 inputs)) (dsS33 (lvS33 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 29863)
      hma hmb hmc hmd hmp (by norm_num [gS33a]) (by norm_num [gS33b])
      (by norm_num [gS33c]) (by norm_num [gS33d]) (by norm_num [dsS33]) (by norm_num)
      (zval_S33 inputs hin0) (allWrap4 inputs hin0 hroot 17 (by norm_num))
  rw [gS33a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS33a (lvS33 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS33a (lvS33 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS33b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS33b (lvS33 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS33b (lvS33 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS33c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS33c (lvS33 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS33c (lvS33 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS33d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS33d (lvS33 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS33d (lvS33 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS33_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS33p (lvS33 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS33p (lvS33 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 18))) := by
    rw [hvA, ← bwS33a_eq, SHA256.sigma0_bits (bwS33a inputs) (by rfl)
      (fun b hb => by rw [bwS33a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS33a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 31))) := by
    rw [hvC, ← bwS33c_eq, SHA256.sigma1_bits (bwS33c inputs) (by rfl)
      (fun b hb => by rw [bwS33c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS33c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 26)) := by
    rw [hvB, ← bwS33b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 17)) := by
    rw [hvD, ← bwS33d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 33)) := by
    rw [hvP, ← bwS33p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

end Sha256Blk
