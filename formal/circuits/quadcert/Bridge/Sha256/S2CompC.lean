/-- **The schedule recurrence for `W32`, over the deployed circuit.** -/
theorem sched32 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS32.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 32))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 17)))
          + SHA256.ofBits (bitsOf inputs (wordBits 25))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 30)))
          + SHA256.ofBits (bitsOf inputs (wordBits 16))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS32 inputs i = 0 ∨ lvS32 inputs i = 1 :=
    lvBits32 inputs hin0 hbz
  have hone : lvS32 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS32a (lvS32 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS32a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS32a (lvS32 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS32b (lvS32 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS32b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS32b (lvS32 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS32c (lvS32 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS32c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS32c (lvS32 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS32d (lvS32 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS32d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS32d (lvS32 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS32 (lvS32 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS32_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS32p (lvS32 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS32a (lvS32 inputs)) (gS32b (lvS32 inputs)) (gS32c (lvS32 inputs))
      (gS32d (lvS32 inputs)) (dsS32 (lvS32 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 1422)
      hma hmb hmc hmd hmp (by norm_num [gS32a]) (by norm_num [gS32b])
      (by norm_num [gS32c]) (by norm_num [gS32d]) (by norm_num [dsS32]) (by norm_num)
      (zval_S32 inputs hin0) (allWrap4 inputs hin0 hroot 16 (by norm_num))
  rw [gS32a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS32a (lvS32 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS32a (lvS32 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS32b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS32b (lvS32 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS32b (lvS32 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS32c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS32c (lvS32 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS32c (lvS32 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS32d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS32d (lvS32 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS32d (lvS32 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS32_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS32p (lvS32 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS32p (lvS32 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 17))) := by
    rw [hvA, ← bwS32a_eq, SHA256.sigma0_bits (bwS32a inputs) (by rfl)
      (fun b hb => by rw [bwS32a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS32a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 30))) := by
    rw [hvC, ← bwS32c_eq, SHA256.sigma1_bits (bwS32c inputs) (by rfl)
      (fun b hb => by rw [bwS32c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS32c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 25)) := by
    rw [hvB, ← bwS32b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 16)) := by
    rw [hvD, ← bwS32d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 32)) := by
    rw [hvP, ← bwS32p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

