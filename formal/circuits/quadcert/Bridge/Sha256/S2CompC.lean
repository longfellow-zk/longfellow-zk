/-- **The schedule recurrence for `W30`, over the deployed circuit.** -/
theorem sched30 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS30.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 30))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 15)))
          + SHA256.ofBits (bitsOf inputs (wordBits 23))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 28)))
          + SHA256.ofBits (bitsOf inputs (wordBits 14))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS30 inputs i = 0 ∨ lvS30 inputs i = 1 :=
    lvBits30 inputs hin0 hbz
  have hone : lvS30 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS30a (lvS30 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS30a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS30a (lvS30 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS30b (lvS30 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS30b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS30b (lvS30 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS30c (lvS30 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS30c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS30c (lvS30 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS30d (lvS30 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS30d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS30d (lvS30 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS30 (lvS30 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS30_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS30p (lvS30 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS30a (lvS30 inputs)) (gS30b (lvS30 inputs)) (gS30c (lvS30 inputs))
      (gS30d (lvS30 inputs)) (dsS30 (lvS30 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 28768)
      hma hmb hmc hmd hmp (by norm_num [gS30a]) (by norm_num [gS30b])
      (by norm_num [gS30c]) (by norm_num [gS30d]) (by norm_num [dsS30]) (by norm_num)
      (zval_S30 inputs hin0) (allWrap4 inputs hin0 hroot 14 (by norm_num))
  rw [gS30a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS30a (lvS30 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS30a (lvS30 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS30b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS30b (lvS30 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS30b (lvS30 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS30c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS30c (lvS30 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS30c (lvS30 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS30d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS30d (lvS30 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS30d (lvS30 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS30_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS30p (lvS30 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS30p (lvS30 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 15))) := by
    rw [hvA, ← bwS30a_eq, SHA256.sigma0_bits (bwS30a inputs) (by rfl)
      (fun b hb => by rw [bwS30a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS30a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 28))) := by
    rw [hvC, ← bwS30c_eq, SHA256.sigma1_bits (bwS30c inputs) (by rfl)
      (fun b hb => by rw [bwS30c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS30c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 23)) := by
    rw [hvB, ← bwS30b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 14)) := by
    rw [hvD, ← bwS30d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 30)) := by
    rw [hvP, ← bwS30p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

