  exact bits_of_boolNodes_idx raw (cnstw F) inputs nodeFn nodefn_ok cnstw_0 hc2 hone bpR6_15
    hshape hltc (fun j hj => hbz j (by rw [hlen] at hj; exact hj))

/-- Booleanity of every template leaf, index `0` (the constant one) included. -/
theorem lvBitsR6_15 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_15.getD j (0, 0)).1 = 0) :
    ∀ i, i < 225 → interpDag (raw.toDag (cnstw F)) inputs (mpR6_15.getD i 0) = 0
      ∨ interpDag (raw.toDag (cnstw F)) inputs (mpR6_15.getD i 0) = 1 := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  intro i hi
  rcases Nat.eq_zero_or_pos i with rfl | hpos
  · refine Or.inr ?_
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  · have hb := leafBitsR6_15 inputs hin0 hbz (i - 1) (by omega)
    have hall : (List.range 224).all
        (fun j => decide ((bpR6_15.getD j (0, 0)).2 = mpR6_15.getD (j + 1) 0)) = true := by
      decide +kernel
    simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at hall
    have heq := hall (i - 1) (by omega)
    rw [show i - 1 + 1 = i from by omega] at heq
    rwa [heq] at hb

