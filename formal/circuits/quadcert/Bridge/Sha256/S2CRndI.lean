    SHA256F.wrap_seven_words (p := p256w) (gR7_3a (lvR7_3 inputs)) (gR7_3b (lvR7_3 inputs)) (gR7_3c (lvR7_3 inputs)) (gR7_3d (lvR7_3 inputs)) (gR7_3e (lvR7_3 inputs)) (gR7_3f (lvR7_3 inputs))
      (dsR7_3 (lvR7_3 inputs)) 3921009573 (interpDag (raw.toDag (cnstw F)) inputs 20915)
