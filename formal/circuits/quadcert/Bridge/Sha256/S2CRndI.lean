    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf7 k) = 0) :
    stateWord inputs 4 0 = SHA256.w32 (
      stateWord inputs 3 7 + SHA256.Sigma1 (stateWord inputs 3 4)
        + SHA256.Ch (stateWord inputs 3 4) (stateWord inputs 3 5) (stateWord inputs 3 6)
