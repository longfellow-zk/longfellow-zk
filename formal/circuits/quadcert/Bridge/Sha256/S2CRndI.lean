  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 289 → lvR7_2 inputs i = 0 ∨ lvR7_2 inputs i = 1 :=
    lvBitsR7_2 inputs hin0 hbz
  have hone : lvR7_2 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR7_2a (lvR7_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_2a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_2a (lvR7_2 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR7_2b (lvR7_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_2b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_2b (lvR7_2 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR7_2c (lvR7_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_2c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_2c (lvR7_2 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR7_2d (lvR7_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_2d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_2d (lvR7_2 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR7_2e (lvR7_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_2e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_2e (lvR7_2 inputs) hone c0 c1 hlv i hi
  have hmf : ∀ q ∈ gR7_2f (lvR7_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_2f_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_2f (lvR7_2 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR7_2 (lvR7_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR7_2_eq]
    intro q hq
