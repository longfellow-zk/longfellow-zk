  have hmf : ∀ q ∈ gR7_3f (lvR7_3 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_3f_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_3f (lvR7_3 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR7_3 (lvR7_3 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR7_3_eq]
    intro q hq
