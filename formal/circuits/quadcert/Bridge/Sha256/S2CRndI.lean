    SHA256F.wrap_seven_words (p := p256w) (gR7_2a (lvR7_2 inputs)) (gR7_2b (lvR7_2 inputs)) (gR7_2c (lvR7_2 inputs)) (gR7_2d (lvR7_2 inputs)) (gR7_2e (lvR7_2 inputs)) (gR7_2f (lvR7_2 inputs))
      (dsR7_2 (lvR7_2 inputs)) 3049323471 (interpDag (raw.toDag (cnstw F)) inputs 29122)
