    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_43b (lvR6_43 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_43c (lvR6_43 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_43c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
