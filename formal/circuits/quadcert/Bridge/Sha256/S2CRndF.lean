      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_44d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_44d (lvR6_44 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_44d (lvR6_44 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_44e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_44e (lvR6_44 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_44e (lvR6_44 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_44_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_44p (lvR6_44 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_44p (lvR6_44 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have heA : A = SHA256.ofBits (bwR6_44outa40 inputs) := by rw [hvA]; rfl
  have heB : B = SHA256.ofBits (bwR6_44oute40 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_44oute43 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_44oute43 inputs) (by rfl)
      (fun q hq => by rw [bwR6_44oute43_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_44c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_44oute43 inputs))
      (SHA256.ofBits (bwR6_44oute42 inputs)) (SHA256.ofBits (bwR6_44oute41 inputs)) := by
    rw [hvD, SHA256.Ch_bits (bwR6_44oute43 inputs) (bwR6_44oute42 inputs)
      (bwR6_44oute41 inputs) (by rfl)
      (fun q hq => by rw [bwR6_44oute43_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_44oute42_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_44oute41_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_44d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_44outw28 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_44oute44 inputs) := by rw [hvP]; rfl
