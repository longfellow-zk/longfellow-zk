    SHA256F.wrap_six_words (p := p256w) (gR6_41a (lvR6_41 inputs)) (gR6_41b (lvR6_41 inputs)) (gR6_41c (lvR6_41 inputs)) (gR6_41d (lvR6_41 inputs)) (gR6_41e (lvR6_41 inputs))
      (dsR6_41 (lvR6_41 inputs)) 2820302411 (interpDag (raw.toDag (cnstw F)) inputs 35435)
      hma hmb hmc hmd hme hmp
