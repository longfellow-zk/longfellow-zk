theorem rndR6_41 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_41.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 42 4 = SHA256.w32 (
      stateWord inputs 41 3 + (stateWord inputs 41 7 + SHA256.Sigma1 (stateWord inputs 41 4)
        + SHA256.Ch (stateWord inputs 41 4) (stateWord inputs 41 5) (stateWord inputs 41 6)
        + SHA256.K.getD 41 0 + wWord inputs 41)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_41 inputs i = 0 ∨ lvR6_41 inputs i = 1 :=
    lvBitsR6_41 inputs hin0 hbz
  have hone : lvR6_41 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_41a (lvR6_41 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_41a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_41a (lvR6_41 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_41b (lvR6_41 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_41b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_41b (lvR6_41 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_41c (lvR6_41 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_41c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_41c (lvR6_41 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR6_41d (lvR6_41 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_41d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_41d (lvR6_41 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_41e (lvR6_41 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_41e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_41e (lvR6_41 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR6_41 (lvR6_41 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_41_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_41p (lvR6_41 inputs) hone c0 c1 hlv i hi
