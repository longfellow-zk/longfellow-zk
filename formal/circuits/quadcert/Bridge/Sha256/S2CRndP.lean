/-- **Round 60, `n = 7`: the compression step over the deployed circuit.** -/
theorem rndR7_60 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 288 → interpDag (raw.toDag (cnstw F)) inputs (bpR7_60.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf7 k) = 0) :
    stateWord inputs 61 0 = SHA256.w32 (
      stateWord inputs 60 7 + SHA256.Sigma1 (stateWord inputs 60 4)
        + SHA256.Ch (stateWord inputs 60 4) (stateWord inputs 60 5) (stateWord inputs 60 6)
        + SHA256.K.getD 60 0 + wWord inputs 60
        + (SHA256.Sigma0 (stateWord inputs 60 0) + SHA256.Maj (stateWord inputs 60 0) (stateWord inputs 60 1) (stateWord inputs 60 2))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 289 → lvR7_60 inputs i = 0 ∨ lvR7_60 inputs i = 1 :=
    lvBitsR7_60 inputs hin0 hbz
  have hone : lvR7_60 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR7_60a (lvR7_60 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_60a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_60a (lvR7_60 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR7_60b (lvR7_60 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_60b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_60b (lvR7_60 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR7_60c (lvR7_60 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_60c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR7_60c (lvR7_60 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR7_60d (lvR7_60 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR7_60d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
