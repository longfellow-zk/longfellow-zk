/-- **Round 15, `n = 7`: the compression step over the deployed circuit.** -/
theorem rndR7_15 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 288 → interpDag (raw.toDag (cnstw F)) inputs (bpR7_15.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf7 k) = 0) :
    stateWord inputs 16 0 = SHA256.w32 (
      stateWord inputs 15 7 + SHA256.Sigma1 (stateWord inputs 15 4)
        + SHA256.Ch (stateWord inputs 15 4) (stateWord inputs 15 5) (stateWord inputs 15 6)
        + SHA256.K.getD 15 0 + wWord inputs 15
        + (SHA256.Sigma0 (stateWord inputs 15 0) + SHA256.Maj (stateWord inputs 15 0) (stateWord inputs 15 1) (stateWord inputs 15 2))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 289 → lvR7_15 inputs i = 0 ∨ lvR7_15 inputs i = 1 :=
