theorem nbR7_8c (inputs : Nat → F)
    (hlv : ∀ i, i < 289 → lvR7_8 inputs i = 0 ∨ lvR7_8 inputs i = 1) :
    ∀ j, j < 32 → SHA256F.natBit (vR7_8c (lvR7_8 inputs) j)
      = SHA256.chb ((bwR7_8oute7 inputs).getD j 0) ((bwR7_8oute6 inputs).getD j 0)
          ((bwR7_8oute5 inputs).getD j 0) := by
  intro j hj
  match j, hj with
  | 0, _ =>
      show SHA256F.natBit (Quadcert.chVal (lvR7_8 inputs 167) (lvR7_8 inputs 95)
          (lvR7_8 inputs 96))
