/-- Working variable `i` after `t` rounds. -/
def stateBits (t i : Nat) : List Nat :=
  if i < 4 then (if i < t then outaBits (t - 1 - i) else hinBits (i - t))
  else (if i - 4 < t then outeBits (t - 1 - (i - 4)) else hinBits (i - t))

/-- Before the first round the state is the incoming chaining value. This is
    `sha256_soundness`'s `hinit`, and it holds by unfolding. -/
theorem stateBits_zero (i : Nat) : stateBits 0 i = hinBits i := by
  simp only [stateBits]
  split
  · rw [if_neg (by omega), Nat.sub_zero]
  · rw [if_neg (by omega), Nat.sub_zero]

/-- **The six copied working variables**, for every round at once: `b ← a`, `c ← b`, `d ← c` and
    `f ← e`, `g ← f`, `h ← g`. `sha256_soundness`'s `hshift` needs no per-round generation. -/
theorem stateBits_shift (t i : Nat) (h : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 4 ∨ i = 5 ∨ i = 6) :
    stateBits (t + 1) (i + 1) = stateBits t i := by
  rcases h with rfl | rfl | rfl | rfl | rfl | rfl <;> cases t <;>
    simp only [stateBits] <;> norm_num <;>
    split <;> (try split) <;> first | rfl | (congr 1; omega)

variable {F : Type} [Field F]

/-- The eight state words as `Nat`s. -/
noncomputable def stateWord (inputs : Nat → F) (t i : Nat) : Nat :=
  SHA256.ofBits (bitsOf inputs (stateBits t i))

/-- The incoming chaining words as `Nat`s. -/
noncomputable def hWord (inputs : Nat → F) (i : Nat) : Nat :=
  SHA256.ofBits (bitsOf inputs (hinBits i))

/-- The message-schedule words as `Nat`s. -/
noncomputable def wWord (inputs : Nat → F) (t : Nat) : Nat :=
  SHA256.ofBits (bitsOf inputs (wordBits t))

/-- The outgoing chaining words as `Nat`s. -/
noncomputable def outWord (inputs : Nat → F) (i : Nat) : Nat :=
  SHA256.ofBits (bitsOf inputs (h1Bits i))

/-- The 16-word message block. -/
noncomputable def msgBlock (inputs : Nat → F) : List Nat :=
  (List.range 16).map (wWord inputs)

theorem msgBlock_length (inputs : Nat → F) : (msgBlock inputs).length = 16 := by
  simp [msgBlock]

/-- **`hinit`.** -/
theorem hinit (inputs : Nat → F) (i : Nat) : stateWord inputs 0 i = hWord inputs i := by
  rw [stateWord, hWord, stateBits_zero]

/-- **`hcopy`.** The 16 message words are the schedule's first 16 entries because they are
    literally the same wires -- `wordBits t` is `input_block t` for `t < 16`. -/
theorem hcopy (inputs : Nat → F) (t : Nat) (ht : t < 16) :
    wWord inputs t = (msgBlock inputs).getD t 0 := by
  simp only [msgBlock, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range, ht]
  simp

/-- **`hshift`.** -/
theorem hshift (inputs : Nat → F) (t : Nat) :
    stateWord inputs (t + 1) 1 = stateWord inputs t 0 ∧
    stateWord inputs (t + 1) 2 = stateWord inputs t 1 ∧
    stateWord inputs (t + 1) 3 = stateWord inputs t 2 ∧
    stateWord inputs (t + 1) 5 = stateWord inputs t 4 ∧
    stateWord inputs (t + 1) 6 = stateWord inputs t 5 ∧
    stateWord inputs (t + 1) 7 = stateWord inputs t 6 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    (simp only [stateWord]; congr 1; congr 1)
  · exact stateBits_shift t 0 (by tauto)
  · exact stateBits_shift t 1 (by tauto)
  · exact stateBits_shift t 2 (by tauto)
  · exact stateBits_shift t 4 (by tauto)
  · exact stateBits_shift t 5 (by tauto)
  · exact stateBits_shift t 6 (by tauto)

end Sha256Blk
