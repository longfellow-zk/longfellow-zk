  rw [gR6_11c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_11c (lvR6_11 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbR6_11c (lvR6_11 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_11d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_11d (lvR6_11 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_11d (lvR6_11 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_11e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_11e (lvR6_11 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_11e (lvR6_11 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_11_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_11p (lvR6_11 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_11p (lvR6_11 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have heA : A = SHA256.ofBits (bwR6_11outa7 inputs) := by rw [hvA]; rfl
  have heB : B = SHA256.ofBits (bwR6_11oute7 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_11oute10 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_11oute10 inputs) (by rfl)
      (fun q hq => by rw [bwR6_11oute10_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_11c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_11oute10 inputs))
      (SHA256.ofBits (bwR6_11oute9 inputs)) (SHA256.ofBits (bwR6_11oute8 inputs)) := by
    rw [hvD, SHA256.Ch_bits (bwR6_11oute10 inputs) (bwR6_11oute9 inputs)
      (bwR6_11oute8 inputs) (by rfl)
      (fun q hq => by rw [bwR6_11oute10_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_11oute9_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_11oute8_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_11d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_11inputblock11 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_11oute11 inputs) := by rw [hvP]; rfl
  simp only [stateWord, wWord, ← bwR6_11oute11_eq, ← bwR6_11inputblock11_eq, ← bwR6_11outa7_eq, ← bwR6_11oute10_eq, ← bwR6_11oute7_eq, ← bwR6_11oute8_eq, ← bwR6_11oute9_eq]
