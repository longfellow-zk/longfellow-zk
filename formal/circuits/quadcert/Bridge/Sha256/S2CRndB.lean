/-- **Round 11, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_11 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_11.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 12 4 = SHA256.w32 (
      stateWord inputs 11 3 + (stateWord inputs 11 7 + SHA256.Sigma1 (stateWord inputs 11 4)
        + SHA256.Ch (stateWord inputs 11 4) (stateWord inputs 11 5) (stateWord inputs 11 6)
        + SHA256.K.getD 11 0 + wWord inputs 11)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_11 inputs i = 0 ∨ lvR6_11 inputs i = 1 :=
    lvBitsR6_11 inputs hin0 hbz
  have hone : lvR6_11 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_11a (lvR6_11 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_11a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_11a (lvR6_11 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_11b (lvR6_11 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_11b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_11b (lvR6_11 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_11c (lvR6_11 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_11c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_11c (lvR6_11 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR6_11d (lvR6_11 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_11d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_11d (lvR6_11 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_11e (lvR6_11 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_11e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_11e (lvR6_11 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR6_11 (lvR6_11 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_11_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_11p (lvR6_11 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, E, P, hA, hB, hC, hD, hE, hP, hAlt, hBlt, hClt, hDlt, hElt, hPlt, hres⟩ :=
    SHA256F.wrap_six_words (p := p256w) (gR6_11a (lvR6_11 inputs)) (gR6_11b (lvR6_11 inputs)) (gR6_11c (lvR6_11 inputs)) (gR6_11d (lvR6_11 inputs)) (gR6_11e (lvR6_11 inputs))
      (dsR6_11 (lvR6_11 inputs)) 1426881987 (interpDag (raw.toDag (cnstw F)) inputs 23801)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_11a]) (by norm_num [gR6_11b]) (by norm_num [gR6_11c]) (by norm_num [gR6_11d]) (by norm_num [gR6_11e]) (by norm_num [dsR6_11])
      (by norm_num) (by norm_num) (zval_R6_11 inputs hin0)
      (allWrap6 inputs hin0 hroot 11 (by norm_num))
  rw [gR6_11a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_11a (lvR6_11 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbR6_11a (lvR6_11 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_11b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_11b (lvR6_11 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbR6_11b (lvR6_11 inputs) hone c0 c1 hlv i hi) hB
