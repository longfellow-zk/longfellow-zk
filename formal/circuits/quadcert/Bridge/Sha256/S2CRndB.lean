  have hlv : ∀ i, i < 225 → lvR6_9 inputs i = 0 ∨ lvR6_9 inputs i = 1 :=
    lvBitsR6_9 inputs hin0 hbz
  have hone : lvR6_9 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_9a (lvR6_9 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_9a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_9a (lvR6_9 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_9b (lvR6_9 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_9b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_9b (lvR6_9 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_9c (lvR6_9 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_9c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_9c (lvR6_9 inputs) hone c0 c1 hlv i hi
