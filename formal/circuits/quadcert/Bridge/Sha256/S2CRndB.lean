    stateWord inputs 15 4 = SHA256.w32 (
      stateWord inputs 14 3 + (stateWord inputs 14 7 + SHA256.Sigma1 (stateWord inputs 14 4)
        + SHA256.Ch (stateWord inputs 14 4) (stateWord inputs 14 5) (stateWord inputs 14 6)
        + SHA256.K.getD 14 0 + wWord inputs 14)) := by
