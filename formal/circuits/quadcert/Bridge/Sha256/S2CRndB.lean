  rw [gR6_12d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_12d (lvR6_12 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_12d (lvR6_12 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_12e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_12e (lvR6_12 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_12e (lvR6_12 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_12_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_12p (lvR6_12 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_12p (lvR6_12 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have heA : A = SHA256.ofBits (bwR6_12outa8 inputs) := by rw [hvA]; rfl
  have heB : B = SHA256.ofBits (bwR6_12oute8 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_12oute11 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_12oute11 inputs) (by rfl)
      (fun q hq => by rw [bwR6_12oute11_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_12c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_12oute11 inputs))
      (SHA256.ofBits (bwR6_12oute10 inputs)) (SHA256.ofBits (bwR6_12oute9 inputs)) := by
    rw [hvD, SHA256.Ch_bits (bwR6_12oute11 inputs) (bwR6_12oute10 inputs)
      (bwR6_12oute9 inputs) (by rfl)
      (fun q hq => by rw [bwR6_12oute11_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_12oute10_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_12oute9_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_12d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_12inputblock12 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_12oute12 inputs) := by rw [hvP]; rfl
  simp only [stateWord, wWord, ← bwR6_12oute12_eq, ← bwR6_12inputblock12_eq, ← bwR6_12outa8_eq, ← bwR6_12oute10_eq, ← bwR6_12oute11_eq, ← bwR6_12oute8_eq, ← bwR6_12oute9_eq]
  rw [← heP, ← heA, ← heB, ← heC, ← heD, ← heE]
  rw [hres]
