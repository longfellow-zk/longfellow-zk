  have hlv : ∀ i, i < 225 → lvR6_14 inputs i = 0 ∨ lvR6_14 inputs i = 1 :=
    lvBitsR6_14 inputs hin0 hbz
  have hone : lvR6_14 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
