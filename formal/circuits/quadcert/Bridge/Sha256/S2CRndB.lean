    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 10 4 = SHA256.w32 (
      stateWord inputs 9 3 + (stateWord inputs 9 7 + SHA256.Sigma1 (stateWord inputs 9 4)
        + SHA256.Ch (stateWord inputs 9 4) (stateWord inputs 9 5) (stateWord inputs 9 6)
        + SHA256.K.getD 9 0 + wWord inputs 9)) := by
