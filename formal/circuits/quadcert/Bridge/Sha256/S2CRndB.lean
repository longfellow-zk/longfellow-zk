    rw [gR6_9d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_9d (lvR6_9 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_9e (lvR6_9 inputs), q.2 = 0 ∨ q.2 = 1 := by
