/-- **The schedule recurrence for `W19`, over the deployed circuit.** -/
theorem sched19 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS19.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 19))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 4)))
          + SHA256.ofBits (bitsOf inputs (wordBits 12))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 17)))
          + SHA256.ofBits (bitsOf inputs (wordBits 3))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS19 inputs i = 0 ∨ lvS19 inputs i = 1 :=
    lvBits19 inputs hin0 hbz
  have hone : lvS19 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS19a (lvS19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS19a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS19a (lvS19 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS19b (lvS19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS19b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS19b (lvS19 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS19c (lvS19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS19c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS19c (lvS19 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS19d (lvS19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS19d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS19d (lvS19 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS19 (lvS19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS19_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS19p (lvS19 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS19a (lvS19 inputs)) (gS19b (lvS19 inputs)) (gS19c (lvS19 inputs))
      (gS19d (lvS19 inputs)) (dsS19 (lvS19 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 35985)
      hma hmb hmc hmd hmp (by norm_num [gS19a]) (by norm_num [gS19b])
      (by norm_num [gS19c]) (by norm_num [gS19d]) (by norm_num [dsS19]) (by norm_num)
      (zval_S19 inputs hin0) (allWrap4 inputs hin0 hroot 3 (by norm_num))
  rw [gS19a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS19a (lvS19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS19a (lvS19 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS19b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS19b (lvS19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS19b (lvS19 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS19c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS19c (lvS19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS19c (lvS19 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS19d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS19d (lvS19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS19d (lvS19 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS19_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS19p (lvS19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS19p (lvS19 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 4))) := by
    rw [hvA, ← bwS19a_eq, SHA256.sigma0_bits (bwS19a inputs) (by rfl)
      (fun b hb => by rw [bwS19a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS19a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 17))) := by
    rw [hvC, ← bwS19c_eq, SHA256.sigma1_bits (bwS19c inputs) (by rfl)
      (fun b hb => by rw [bwS19c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS19c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 12)) := by
    rw [hvB, ← bwS19b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 3)) := by
    rw [hvD, ← bwS19d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 19)) := by
    rw [hvP, ← bwS19p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

