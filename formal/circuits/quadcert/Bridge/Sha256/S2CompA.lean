/-- **The schedule recurrence for `W18`, over the deployed circuit.** -/
theorem sched18 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS18.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 18))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 3)))
          + SHA256.ofBits (bitsOf inputs (wordBits 11))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 16)))
          + SHA256.ofBits (bitsOf inputs (wordBits 2))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS18 inputs i = 0 ∨ lvS18 inputs i = 1 :=
    lvBits18 inputs hin0 hbz
  have hone : lvS18 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS18a (lvS18 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS18a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS18a (lvS18 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS18b (lvS18 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS18b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS18b (lvS18 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS18c (lvS18 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS18c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS18c (lvS18 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS18d (lvS18 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS18d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS18d (lvS18 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS18 (lvS18 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS18_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS18p (lvS18 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS18a (lvS18 inputs)) (gS18b (lvS18 inputs)) (gS18c (lvS18 inputs))
      (gS18d (lvS18 inputs)) (dsS18 (lvS18 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 34468)
      hma hmb hmc hmd hmp (by norm_num [gS18a]) (by norm_num [gS18b])
      (by norm_num [gS18c]) (by norm_num [gS18d]) (by norm_num [dsS18]) (by norm_num)
      (zval_S18 inputs hin0) (allWrap4 inputs hin0 hroot 2 (by norm_num))
  rw [gS18a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS18a (lvS18 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS18a (lvS18 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS18b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS18b (lvS18 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS18b (lvS18 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS18c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS18c (lvS18 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS18c (lvS18 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS18d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS18d (lvS18 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS18d (lvS18 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS18_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS18p (lvS18 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS18p (lvS18 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 3))) := by
    rw [hvA, ← bwS18a_eq, SHA256.sigma0_bits (bwS18a inputs) (by rfl)
      (fun b hb => by rw [bwS18a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS18a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 16))) := by
    rw [hvC, ← bwS18c_eq, SHA256.sigma1_bits (bwS18c inputs) (by rfl)
      (fun b hb => by rw [bwS18c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS18c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 11)) := by
    rw [hvB, ← bwS18b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 2)) := by
    rw [hvD, ← bwS18d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 18)) := by
    rw [hvP, ← bwS18p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

