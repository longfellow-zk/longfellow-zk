/-- **The schedule recurrence for `W16`, over the deployed circuit.** -/
theorem sched16 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS16.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 16))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 1)))
          + SHA256.ofBits (bitsOf inputs (wordBits 9))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 14)))
          + SHA256.ofBits (bitsOf inputs (wordBits 0))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS16 inputs i = 0 ∨ lvS16 inputs i = 1 :=
    lvBits16 inputs hin0 hbz
  have hone : lvS16 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS16a (lvS16 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS16a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS16a (lvS16 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS16b (lvS16 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS16b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS16b (lvS16 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS16c (lvS16 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS16c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS16c (lvS16 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS16d (lvS16 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS16d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS16d (lvS16 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS16 (lvS16 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS16_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS16p (lvS16 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS16a (lvS16 inputs)) (gS16b (lvS16 inputs)) (gS16c (lvS16 inputs))
      (gS16d (lvS16 inputs)) (dsS16 (lvS16 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 35132)
      hma hmb hmc hmd hmp (by norm_num [gS16a]) (by norm_num [gS16b])
      (by norm_num [gS16c]) (by norm_num [gS16d]) (by norm_num [dsS16]) (by norm_num)
      (zval_S16 inputs hin0) (allWrap4 inputs hin0 hroot 0 (by norm_num))
  rw [gS16a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS16a (lvS16 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS16a (lvS16 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS16b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS16b (lvS16 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS16b (lvS16 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS16c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS16c (lvS16 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS16c (lvS16 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS16d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS16d (lvS16 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS16d (lvS16 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS16_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS16p (lvS16 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS16p (lvS16 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 1))) := by
    rw [hvA, ← bwS16a_eq, SHA256.sigma0_bits (bwS16a inputs) (by rfl)
      (fun b hb => by rw [bwS16a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS16a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 14))) := by
    rw [hvC, ← bwS16c_eq, SHA256.sigma1_bits (bwS16c inputs) (by rfl)
      (fun b hb => by rw [bwS16c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS16c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 9)) := by
    rw [hvB, ← bwS16b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 0)) := by
    rw [hvD, ← bwS16d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 16)) := by
    rw [hvP, ← bwS16p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

/-! #### Composition for `W17` -/

/-- The cone's leaf valuation. -/
noncomputable def lvS17 (inputs : Nat → F) : Nat → F :=
  fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS17.getD h 0)

noncomputable def vS17a (lv : Nat → F) : Nat → F
  | 0 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS17 260) (lv 111)
  | 1 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS17 216) (lv 109)
