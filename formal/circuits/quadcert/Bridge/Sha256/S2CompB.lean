/-- **The schedule recurrence for `W25`, over the deployed circuit.** -/
theorem sched25 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS25.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 25))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 10)))
          + SHA256.ofBits (bitsOf inputs (wordBits 18))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 23)))
          + SHA256.ofBits (bitsOf inputs (wordBits 9))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS25 inputs i = 0 ∨ lvS25 inputs i = 1 :=
    lvBits25 inputs hin0 hbz
  have hone : lvS25 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS25a (lvS25 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS25a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS25a (lvS25 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS25b (lvS25 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS25b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS25b (lvS25 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS25c (lvS25 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS25c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS25c (lvS25 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS25d (lvS25 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS25d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS25d (lvS25 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS25 (lvS25 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS25_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS25p (lvS25 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS25a (lvS25 inputs)) (gS25b (lvS25 inputs)) (gS25c (lvS25 inputs))
      (gS25d (lvS25 inputs)) (dsS25 (lvS25 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 31512)
      hma hmb hmc hmd hmp (by norm_num [gS25a]) (by norm_num [gS25b])
      (by norm_num [gS25c]) (by norm_num [gS25d]) (by norm_num [dsS25]) (by norm_num)
      (zval_S25 inputs hin0) (allWrap4 inputs hin0 hroot 9 (by norm_num))
  rw [gS25a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS25a (lvS25 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS25a (lvS25 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS25b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS25b (lvS25 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS25b (lvS25 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS25c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS25c (lvS25 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS25c (lvS25 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS25d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS25d (lvS25 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS25d (lvS25 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS25_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS25p (lvS25 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS25p (lvS25 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 10))) := by
    rw [hvA, ← bwS25a_eq, SHA256.sigma0_bits (bwS25a inputs) (by rfl)
      (fun b hb => by rw [bwS25a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS25a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 23))) := by
    rw [hvC, ← bwS25c_eq, SHA256.sigma1_bits (bwS25c inputs) (by rfl)
      (fun b hb => by rw [bwS25c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS25c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 18)) := by
    rw [hvB, ← bwS25b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 9)) := by
    rw [hvD, ← bwS25d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 25)) := by
    rw [hvP, ← bwS25p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

