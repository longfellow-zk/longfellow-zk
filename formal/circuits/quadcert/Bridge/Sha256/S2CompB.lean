/-- **The schedule recurrence for `W23`, over the deployed circuit.** -/
theorem sched23 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS23.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 23))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 8)))
          + SHA256.ofBits (bitsOf inputs (wordBits 16))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 21)))
          + SHA256.ofBits (bitsOf inputs (wordBits 7))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS23 inputs i = 0 ∨ lvS23 inputs i = 1 :=
    lvBits23 inputs hin0 hbz
  have hone : lvS23 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS23a (lvS23 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS23a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS23a (lvS23 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS23b (lvS23 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS23b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS23b (lvS23 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS23c (lvS23 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS23c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS23c (lvS23 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS23d (lvS23 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS23d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS23d (lvS23 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS23 (lvS23 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS23_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS23p (lvS23 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS23a (lvS23 inputs)) (gS23b (lvS23 inputs)) (gS23c (lvS23 inputs))
      (gS23d (lvS23 inputs)) (dsS23 (lvS23 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 18245)
      hma hmb hmc hmd hmp (by norm_num [gS23a]) (by norm_num [gS23b])
      (by norm_num [gS23c]) (by norm_num [gS23d]) (by norm_num [dsS23]) (by norm_num)
      (zval_S23 inputs hin0) (allWrap4 inputs hin0 hroot 7 (by norm_num))
  rw [gS23a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS23a (lvS23 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS23a (lvS23 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS23b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS23b (lvS23 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS23b (lvS23 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS23c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS23c (lvS23 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS23c (lvS23 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS23d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS23d (lvS23 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS23d (lvS23 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS23_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS23p (lvS23 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS23p (lvS23 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 8))) := by
    rw [hvA, ← bwS23a_eq, SHA256.sigma0_bits (bwS23a inputs) (by rfl)
      (fun b hb => by rw [bwS23a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS23a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 21))) := by
    rw [hvC, ← bwS23c_eq, SHA256.sigma1_bits (bwS23c inputs) (by rfl)
      (fun b hb => by rw [bwS23c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS23c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 16)) := by
    rw [hvB, ← bwS23b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 7)) := by
    rw [hvD, ← bwS23d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 23)) := by
    rw [hvP, ← bwS23p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

