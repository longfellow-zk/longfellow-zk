/-- **The schedule recurrence for `W22`, over the deployed circuit.** -/
theorem sched22 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS22.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 22))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 7)))
          + SHA256.ofBits (bitsOf inputs (wordBits 15))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 20)))
          + SHA256.ofBits (bitsOf inputs (wordBits 6))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS22 inputs i = 0 ∨ lvS22 inputs i = 1 :=
    lvBits22 inputs hin0 hbz
  have hone : lvS22 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS22a (lvS22 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS22a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS22a (lvS22 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS22b (lvS22 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS22b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS22b (lvS22 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS22c (lvS22 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS22c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS22c (lvS22 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS22d (lvS22 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS22d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS22d (lvS22 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS22 (lvS22 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS22_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS22p (lvS22 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS22a (lvS22 inputs)) (gS22b (lvS22 inputs)) (gS22c (lvS22 inputs))
      (gS22d (lvS22 inputs)) (dsS22 (lvS22 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 33009)
      hma hmb hmc hmd hmp (by norm_num [gS22a]) (by norm_num [gS22b])
      (by norm_num [gS22c]) (by norm_num [gS22d]) (by norm_num [dsS22]) (by norm_num)
      (zval_S22 inputs hin0) (allWrap4 inputs hin0 hroot 6 (by norm_num))
  rw [gS22a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS22a (lvS22 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS22a (lvS22 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS22b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS22b (lvS22 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS22b (lvS22 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS22c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS22c (lvS22 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS22c (lvS22 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS22d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS22d (lvS22 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS22d (lvS22 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS22_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS22p (lvS22 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS22p (lvS22 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 7))) := by
    rw [hvA, ← bwS22a_eq, SHA256.sigma0_bits (bwS22a inputs) (by rfl)
      (fun b hb => by rw [bwS22a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS22a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 20))) := by
    rw [hvC, ← bwS22c_eq, SHA256.sigma1_bits (bwS22c inputs) (by rfl)
      (fun b hb => by rw [bwS22c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS22c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 15)) := by
    rw [hvB, ← bwS22b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 6)) := by
    rw [hvD, ← bwS22d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 22)) := by
    rw [hvP, ← bwS22p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

/-! #### Composition for `W23` -/

/-- The cone's leaf valuation. -/
noncomputable def lvS23 (inputs : Nat → F) : Nat → F :=
  fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS23.getD h 0)

noncomputable def vS23a (lv : Nat → F) : Nat → F
  | 0 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS23 260) (lv 134)
  | 1 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS23 216) (lv 133)
