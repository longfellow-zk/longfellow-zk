/-- **The schedule recurrence for `W24`, over the deployed circuit.** -/
theorem sched24 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS24.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 24))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 9)))
          + SHA256.ofBits (bitsOf inputs (wordBits 17))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 22)))
          + SHA256.ofBits (bitsOf inputs (wordBits 8))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS24 inputs i = 0 ∨ lvS24 inputs i = 1 :=
    lvBits24 inputs hin0 hbz
  have hone : lvS24 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS24a (lvS24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS24a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS24a (lvS24 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS24b (lvS24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS24b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS24b (lvS24 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS24c (lvS24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS24c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS24c (lvS24 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS24d (lvS24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS24d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS24d (lvS24 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS24 (lvS24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS24_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS24p (lvS24 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS24a (lvS24 inputs)) (gS24b (lvS24 inputs)) (gS24c (lvS24 inputs))
      (gS24d (lvS24 inputs)) (dsS24 (lvS24 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 33130)
      hma hmb hmc hmd hmp (by norm_num [gS24a]) (by norm_num [gS24b])
      (by norm_num [gS24c]) (by norm_num [gS24d]) (by norm_num [dsS24]) (by norm_num)
      (zval_S24 inputs hin0) (allWrap4 inputs hin0 hroot 8 (by norm_num))
  rw [gS24a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS24a (lvS24 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS24a (lvS24 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS24b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS24b (lvS24 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS24b (lvS24 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS24c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS24c (lvS24 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS24c (lvS24 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS24d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS24d (lvS24 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS24d (lvS24 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS24_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS24p (lvS24 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS24p (lvS24 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 9))) := by
    rw [hvA, ← bwS24a_eq, SHA256.sigma0_bits (bwS24a inputs) (by rfl)
      (fun b hb => by rw [bwS24a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS24a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 22))) := by
    rw [hvC, ← bwS24c_eq, SHA256.sigma1_bits (bwS24c inputs) (by rfl)
      (fun b hb => by rw [bwS24c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS24c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 17)) := by
    rw [hvB, ← bwS24b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 8)) := by
    rw [hvD, ← bwS24d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 24)) := by
    rw [hvP, ← bwS24p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

