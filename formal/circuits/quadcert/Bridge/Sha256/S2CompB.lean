/-- **The schedule recurrence for `W26`, over the deployed circuit.** -/
theorem sched26 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS26.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 26))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 11)))
          + SHA256.ofBits (bitsOf inputs (wordBits 19))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 24)))
          + SHA256.ofBits (bitsOf inputs (wordBits 10))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS26 inputs i = 0 ∨ lvS26 inputs i = 1 :=
    lvBits26 inputs hin0 hbz
  have hone : lvS26 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS26a (lvS26 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS26a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS26a (lvS26 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS26b (lvS26 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS26b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS26b (lvS26 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS26c (lvS26 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS26c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS26c (lvS26 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS26d (lvS26 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS26d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS26d (lvS26 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS26 (lvS26 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS26_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS26p (lvS26 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS26a (lvS26 inputs)) (gS26b (lvS26 inputs)) (gS26c (lvS26 inputs))
      (gS26d (lvS26 inputs)) (dsS26 (lvS26 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 25895)
      hma hmb hmc hmd hmp (by norm_num [gS26a]) (by norm_num [gS26b])
      (by norm_num [gS26c]) (by norm_num [gS26d]) (by norm_num [dsS26]) (by norm_num)
      (zval_S26 inputs hin0) (allWrap4 inputs hin0 hroot 10 (by norm_num))
  rw [gS26a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS26a (lvS26 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS26a (lvS26 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS26b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS26b (lvS26 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS26b (lvS26 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS26c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS26c (lvS26 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS26c (lvS26 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS26d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS26d (lvS26 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS26d (lvS26 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS26_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS26p (lvS26 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS26p (lvS26 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 11))) := by
    rw [hvA, ← bwS26a_eq, SHA256.sigma0_bits (bwS26a inputs) (by rfl)
      (fun b hb => by rw [bwS26a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS26a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 24))) := by
    rw [hvC, ← bwS26c_eq, SHA256.sigma1_bits (bwS26c inputs) (by rfl)
      (fun b hb => by rw [bwS26c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS26c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 19)) := by
    rw [hvB, ← bwS26b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 10)) := by
    rw [hvD, ← bwS26d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 26)) := by
    rw [hvP, ← bwS26p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

