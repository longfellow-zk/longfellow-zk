theorem nbR7_16c (inputs : Nat → F)
    (hlv : ∀ i, i < 289 → lvR7_16 inputs i = 0 ∨ lvR7_16 inputs i = 1) :
    ∀ j, j < 32 → SHA256F.natBit (vR7_16c (lvR7_16 inputs) j)
      = SHA256.chb ((bwR7_16oute15 inputs).getD j 0) ((bwR7_16oute14 inputs).getD j 0)
          ((bwR7_16oute13 inputs).getD j 0) := by
  intro j hj
  match j, hj with
  | 0, _ =>
      show SHA256F.natBit (Quadcert.chVal (lvR7_16 inputs 3) (lvR7_16 inputs 4)
          (lvR7_16 inputs 249))
        = SHA256.chb (SHA256F.natBit (lvR7_16 inputs 3)) (SHA256F.natBit (lvR7_16 inputs 4)) (SHA256F.natBit (lvR7_16 inputs 249))
      exact natBit_chVal (hlv 3 (by norm_num)) (hlv 4 (by norm_num))
        (hlv 249 (by norm_num))
