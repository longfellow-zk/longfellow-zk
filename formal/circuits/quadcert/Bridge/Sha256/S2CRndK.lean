theorem nbR7_19e (inputs : Nat → F) (hone : lvR7_19 inputs 0 = 1)
    (c0 : cnstw F 0 = 1) (c1 : cnstw F 1 = -2)
    (hlv : ∀ i, i < 289 → lvR7_19 inputs i = 0 ∨ lvR7_19 inputs i = 1) :
