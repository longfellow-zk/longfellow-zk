      = SHA256.xb (SHA256.xb ((bwR7_19outa18 inputs).getD ((j + 2) % 32) 0)
          ((bwR7_19outa18 inputs).getD ((j + 13) % 32) 0))
          ((bwR7_19outa18 inputs).getD ((j + 22) % 32) 0) := by
  intro j hj
  match j, hj with
  | 0, _ =>
      show SHA256F.natBit (Quadcert.xorVal
          (midLeafVal (cnstw F) (lvR7_19 inputs) 289 mvR7_19 481) (lvR7_19 inputs 174))
