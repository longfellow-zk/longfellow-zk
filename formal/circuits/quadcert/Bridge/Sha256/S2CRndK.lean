/-- **Round 23, `n = 7`: the compression step over the deployed circuit.** -/
theorem rndR7_23 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 288 → interpDag (raw.toDag (cnstw F)) inputs (bpR7_23.getD j (0, 0)).1 = 0)
