/-- **Round 18, `n = 7`: the compression step over the deployed circuit.** -/
theorem rndR7_18 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 288 → interpDag (raw.toDag (cnstw F)) inputs (bpR7_18.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf7 k) = 0) :
    stateWord inputs 19 0 = SHA256.w32 (
      stateWord inputs 18 7 + SHA256.Sigma1 (stateWord inputs 18 4)
        + SHA256.Ch (stateWord inputs 18 4) (stateWord inputs 18 5) (stateWord inputs 18 6)
        + SHA256.K.getD 18 0 + wWord inputs 18
        + (SHA256.Sigma0 (stateWord inputs 18 0) + SHA256.Maj (stateWord inputs 18 0) (stateWord inputs 18 1) (stateWord inputs 18 2))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
