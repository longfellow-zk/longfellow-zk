/-- **Round 40, `n = 7`: the compression step over the deployed circuit.** -/
theorem rndR7_40 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 288 → interpDag (raw.toDag (cnstw F)) inputs (bpR7_40.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf7 k) = 0) :
    stateWord inputs 41 0 = SHA256.w32 (
      stateWord inputs 40 7 + SHA256.Sigma1 (stateWord inputs 40 4)
        + SHA256.Ch (stateWord inputs 40 4) (stateWord inputs 40 5) (stateWord inputs 40 6)
        + SHA256.K.getD 40 0 + wWord inputs 40
        + (SHA256.Sigma0 (stateWord inputs 40 0) + SHA256.Maj (stateWord inputs 40 0) (stateWord inputs 40 1) (stateWord inputs 40 2))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 289 → lvR7_40 inputs i = 0 ∨ lvR7_40 inputs i = 1 :=
    lvBitsR7_40 inputs hin0 hbz
  have hone : lvR7_40 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
