theorem coneS46 : coneIs nodeFn tnS46 (fun i => mpS46.getD i 0) = true := by decide +kernel

theorem mapS46_lt : ∀ i, i < tnS46.length → mpS46.getD i 0 < raw.nodes.length := by
  intro i hi
  have hlen : tnS46.length = 266 := by rfl
  rw [hlen] at hi
  rw [nodes_len]
  have hb : (List.range 266).all (fun j => decide (mpS46.getD j 0 < 37139)) = true := by
    decide +kernel
  simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at hb
  exact hb i hi

/-- **The regrouping, of the circuit.** `tmpl_zS46` transported along the cone match: the
    assertion's `z` wire really is `σ₀(W31) + W39 + σ₁(W44) + W30` minus `W46`,
    as bit-linear forms over the circuit's own wires. -/
theorem zval_S46 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1) :
    interpDag (raw.toDag (cnstw F)) inputs 21869
      = (((gS46a (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS46.getD h 0)) ++ gS46b (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS46.getD h 0)) ++ gS46c (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS46.getD h 0)) ++ gS46d (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS46.getD h 0)))).map
          (fun q => (q.1 : F) * q.2)).sum
        - ((dsS46 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS46.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have htr := coneIs_transfer raw (cnstw F) inputs nodeFn nodefn_ok tnS46
    (fun i => mpS46.getD i 0) coneS46 mapS46_lt 265 (by decide)
  have hone : (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS46.getD h 0)) 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  show interpDag (raw.toDag (cnstw F)) inputs (mpS46.getD 265 0) = _
  rw [htr, tmpl_zS46 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS46.getD h 0)) hone]

