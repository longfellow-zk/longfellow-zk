    exact hin0
  · have hb := leafBitsR7_47 inputs hin0 hbz (i - 1) (by omega)
    have hall : (List.range 288).all
        (fun j => decide ((bpR7_47.getD j (0, 0)).2 = mpR7_47.getD (j + 1) 0)) = true := by
