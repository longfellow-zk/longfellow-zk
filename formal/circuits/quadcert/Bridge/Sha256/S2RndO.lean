/-- Booleanity of every template leaf, index `0` (the constant one) included. -/
theorem lvBitsR7_55 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 288 → interpDag (raw.toDag (cnstw F)) inputs (bpR7_55.getD j (0, 0)).1 = 0) :
