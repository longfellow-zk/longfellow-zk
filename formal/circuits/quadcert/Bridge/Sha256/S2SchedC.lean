theorem zval_S31 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1) :
    interpDag (raw.toDag (cnstw F)) inputs 6609
      = (((gS31a (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS31.getD h 0)) ++ gS31b (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS31.getD h 0)) ++ gS31c (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS31.getD h 0)) ++ gS31d (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS31.getD h 0)))).map
          (fun q => (q.1 : F) * q.2)).sum
        - ((dsS31 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS31.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have htr := coneIs_transfer raw (cnstw F) inputs nodeFn nodefn_ok tnS31
    (fun i => mpS31.getD i 0) coneS31 mapS31_lt 265 (by decide)
  have hone : (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS31.getD h 0)) 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  show interpDag (raw.toDag (cnstw F)) inputs (mpS31.getD 265 0) = _
  rw [htr, tmpl_zS31 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS31.getD h 0)) hone]

