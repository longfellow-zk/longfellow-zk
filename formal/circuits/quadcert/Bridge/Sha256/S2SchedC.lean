        - ((dsS28 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS28.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
