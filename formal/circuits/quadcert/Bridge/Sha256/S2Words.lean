variable {F : Type} [Field F]

/-- The `Nat` bits behind a list of wires. -/
noncomputable def bitsOf (inputs : Nat → F) (ns : List Nat) : List Nat :=
  ns.map (fun n => SHA256F.natBit (interpDag (raw.toDag (cnstw F)) inputs n))

theorem bitsOf_length (inputs : Nat → F) (ns : List Nat) :
    (bitsOf inputs ns).length = ns.length := by simp [bitsOf]

theorem bitsOf_isBit (inputs : Nat → F) (ns : List Nat) :
    ∀ b ∈ bitsOf inputs ns, SHA256.IsBit b := by
  intro b hb
  simp only [bitsOf, List.mem_map] at hb
  obtain ⟨n, _, rfl⟩ := hb
  exact SHA256F.natBit_isBit _

theorem bitsOf_getD (inputs : Nat → F) (ns : List Nat) (i : Nat) (hi : i < ns.length) :
    (bitsOf inputs ns).getD i 0
      = SHA256F.natBit (interpDag (raw.toDag (cnstw F)) inputs (ns.getD i 0)) := by
  simp only [bitsOf, List.getD_eq_getElem?_getD, List.getElem?_map]
  rw [List.getElem?_eq_getElem hi]
  simp

end Sha256Blk
