    exact hin0
  · have hb := leafBits59 inputs hin0 hbz (i - 1) (by omega)
    have hall : (List.range 160).all
        (fun j => decide ((bpS59.getD j (0, 0)).2 = mpS59.getD (j + 1) 0)) = true := by
