    exact hin0
  show interpDag (raw.toDag (cnstw F)) inputs (mpS58.getD 265 0) = _
  rw [htr, tmpl_zS58 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS58.getD h 0)) hone]

