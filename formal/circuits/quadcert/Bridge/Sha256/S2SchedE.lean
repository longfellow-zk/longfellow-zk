/-- Booleanity of the 160 input leaves, by index. -/
theorem leafBits45 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS45.getD j (0, 0)).1 = 0) :
    ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS45.getD j (0, 0)).2 = 0
      ∨ interpDag (raw.toDag (cnstw F)) inputs (bpS45.getD j (0, 0)).2 = 1 := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hone : interpDag (raw.toDag (cnstw F)) inputs 0 = 1 := by
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have hc2 : cnstw F 2 = -1 := by
    show ((constNat 2 : Nat) : F) = -1
    have h : constNat 2 = p256w - 1 := by rfl
    rw [h, Quadcert.cast_sub_eq_neg p256w 1 (by norm_num), Nat.cast_one]
  have hshape : bpS45.all
      (fun q => nodeEq (nodeFn q.1) (.sum [(0, 0, q.2), (2, q.2, q.2)])) = true := by
    decide +kernel
  have hltc : bpS45.all
      (fun q => decide (q.2 < q.1) && decide (q.1 < raw.nodes.length)) = true := by
    rw [nodes_len]; decide +kernel
  have hlen : bpS45.length = 160 := by rfl
  exact bits_of_boolNodes_idx raw (cnstw F) inputs nodeFn nodefn_ok cnstw_0 hc2 hone bpS45
    hshape hltc (fun j hj => hbz j (by rw [hlen] at hj; exact hj))

/-- **Booleanity of every template leaf**, including index `0`, the constant-one wire. This is
    the `hb` that `Core/ConeXor.lean`'s mid lemmas and `wrap_four_words` both consume. -/
theorem lvBits45 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS45.getD j (0, 0)).1 = 0) :
    ∀ i, i < 161 → interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD i 0) = 0
      ∨ interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD i 0) = 1 := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  intro i hi
  rcases Nat.eq_zero_or_pos i with rfl | hpos
  · refine Or.inr ?_
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  · have hb := leafBits45 inputs hin0 hbz (i - 1) (by omega)
    have hall : (List.range 160).all
        (fun j => decide ((bpS45.getD j (0, 0)).2 = mpS45.getD (j + 1) 0)) = true := by
      decide +kernel
    simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at hall
    have heq := hall (i - 1) (by omega)
    rw [show i - 1 + 1 = i from by omega] at heq
    rwa [heq] at hb

/-- The cone of `z` at node 32329 matches the template. -/
theorem coneS45 : coneIs nodeFn tnS45 (fun i => mpS45.getD i 0) = true := by decide +kernel

theorem mapS45_lt : ∀ i, i < tnS45.length → mpS45.getD i 0 < raw.nodes.length := by
  intro i hi
  have hlen : tnS45.length = 266 := by rfl
  rw [hlen] at hi
  rw [nodes_len]
  have hb : (List.range 266).all (fun j => decide (mpS45.getD j 0 < 37139)) = true := by
    decide +kernel
  simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at hb
  exact hb i hi

/-- **The regrouping, of the circuit.** `tmpl_zS45` transported along the cone match: the
    assertion's `z` wire really is `σ₀(W30) + W38 + σ₁(W43) + W29` minus `W45`,
    as bit-linear forms over the circuit's own wires. -/
theorem zval_S45 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1) :
    interpDag (raw.toDag (cnstw F)) inputs 32329
      = (((gS45a (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD h 0)) ++ gS45b (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD h 0)) ++ gS45c (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD h 0)) ++ gS45d (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD h 0)))).map
          (fun q => (q.1 : F) * q.2)).sum
        - ((dsS45 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have htr := coneIs_transfer raw (cnstw F) inputs nodeFn nodefn_ok tnS45
    (fun i => mpS45.getD i 0) coneS45 mapS45_lt 265 (by decide)
  have hone : (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD h 0)) 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  show interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD 265 0) = _
  rw [htr, tmpl_zS45 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS45.getD h 0)) hone]

