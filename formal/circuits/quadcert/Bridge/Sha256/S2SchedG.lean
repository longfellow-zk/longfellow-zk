  show interpDag (raw.toDag (cnstw F)) inputs (mpS52.getD 265 0) = _
  rw [htr, tmpl_zS52 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS52.getD h 0)) hone]

