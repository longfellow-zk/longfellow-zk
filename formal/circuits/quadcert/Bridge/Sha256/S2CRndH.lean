    stateWord inputs 63 4 = SHA256.w32 (
      stateWord inputs 62 3 + (stateWord inputs 62 7 + SHA256.Sigma1 (stateWord inputs 62 4)
        + SHA256.Ch (stateWord inputs 62 4) (stateWord inputs 62 5) (stateWord inputs 62 6)
        + SHA256.K.getD 62 0 + wWord inputs 62)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_62 inputs i = 0 ∨ lvR6_62 inputs i = 1 :=
    lvBitsR6_62 inputs hin0 hbz
  have hone : lvR6_62 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
