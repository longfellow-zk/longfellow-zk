  have heB : B = SHA256.ofBits (bwR6_56oute52 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_56oute55 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_56oute55 inputs) (by rfl)
      (fun q hq => by rw [bwR6_56oute55_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_56c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
