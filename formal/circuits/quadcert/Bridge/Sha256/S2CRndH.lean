      stateWord inputs 59 3 + (stateWord inputs 59 7 + SHA256.Sigma1 (stateWord inputs 59 4)
        + SHA256.Ch (stateWord inputs 59 4) (stateWord inputs 59 5) (stateWord inputs 59 6)
