    rw [hvD, SHA256.Ch_bits (bwR6_17oute16 inputs) (bwR6_17oute15 inputs)
      (bwR6_17oute14 inputs) (by rfl)
      (fun q hq => by rw [bwR6_17oute16_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_17oute15_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_17oute14_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_17d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_17outw1 inputs) := by rw [hvE]; rfl
