/-- **Round 22, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_22 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_22.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 23 4 = SHA256.w32 (
      stateWord inputs 22 3 + (stateWord inputs 22 7 + SHA256.Sigma1 (stateWord inputs 22 4)
        + SHA256.Ch (stateWord inputs 22 4) (stateWord inputs 22 5) (stateWord inputs 22 6)
        + SHA256.K.getD 22 0 + wWord inputs 22)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_22 inputs i = 0 ∨ lvR6_22 inputs i = 1 :=
    lvBitsR6_22 inputs hin0 hbz
  have hone : lvR6_22 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_22a (lvR6_22 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_22a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_22a (lvR6_22 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_22b (lvR6_22 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_22b_eq]
