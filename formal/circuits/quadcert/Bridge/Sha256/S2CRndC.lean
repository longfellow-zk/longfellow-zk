  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_19a (lvR6_19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbR6_19a (lvR6_19 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_19b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_19b (lvR6_19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbR6_19b (lvR6_19 inputs) hone c0 c1 hlv i hi) hB
