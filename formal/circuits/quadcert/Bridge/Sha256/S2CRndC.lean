  rw [gR6_19c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_19c (lvR6_19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbR6_19c (lvR6_19 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_19d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_19d (lvR6_19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_19d (lvR6_19 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_19e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_19e (lvR6_19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_19e (lvR6_19 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_19_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_19p (lvR6_19 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_19p (lvR6_19 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have heA : A = SHA256.ofBits (bwR6_19outa15 inputs) := by rw [hvA]; rfl
  have heB : B = SHA256.ofBits (bwR6_19oute15 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_19oute18 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_19oute18 inputs) (by rfl)
      (fun q hq => by rw [bwR6_19oute18_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_19c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_19oute18 inputs))
      (SHA256.ofBits (bwR6_19oute17 inputs)) (SHA256.ofBits (bwR6_19oute16 inputs)) := by
    rw [hvD, SHA256.Ch_bits (bwR6_19oute18 inputs) (bwR6_19oute17 inputs)
      (bwR6_19oute16 inputs) (by rfl)
      (fun q hq => by rw [bwR6_19oute18_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_19oute17_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_19oute16_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_19d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_19outw3 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_19oute19 inputs) := by rw [hvP]; rfl
