/-- **Round 19, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_19 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_19.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 20 4 = SHA256.w32 (
      stateWord inputs 19 3 + (stateWord inputs 19 7 + SHA256.Sigma1 (stateWord inputs 19 4)
        + SHA256.Ch (stateWord inputs 19 4) (stateWord inputs 19 5) (stateWord inputs 19 6)
        + SHA256.K.getD 19 0 + wWord inputs 19)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_19 inputs i = 0 ∨ lvR6_19 inputs i = 1 :=
    lvBitsR6_19 inputs hin0 hbz
  have hone : lvR6_19 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_19a (lvR6_19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_19a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_19a (lvR6_19 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_19b (lvR6_19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_19b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_19b (lvR6_19 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_19c (lvR6_19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_19c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_19c (lvR6_19 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR6_19d (lvR6_19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_19d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_19d (lvR6_19 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_19e (lvR6_19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_19e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_19e (lvR6_19 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR6_19 (lvR6_19 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_19_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_19p (lvR6_19 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, E, P, hA, hB, hC, hD, hE, hP, hAlt, hBlt, hClt, hDlt, hElt, hPlt, hres⟩ :=
    SHA256F.wrap_six_words (p := p256w) (gR6_19a (lvR6_19 inputs)) (gR6_19b (lvR6_19 inputs)) (gR6_19c (lvR6_19 inputs)) (gR6_19d (lvR6_19 inputs)) (gR6_19e (lvR6_19 inputs))
      (dsR6_19 (lvR6_19 inputs)) 604807628 (interpDag (raw.toDag (cnstw F)) inputs 15944)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_19a]) (by norm_num [gR6_19b]) (by norm_num [gR6_19c]) (by norm_num [gR6_19d]) (by norm_num [gR6_19e]) (by norm_num [dsR6_19])
      (by norm_num) (by norm_num) (zval_R6_19 inputs hin0)
      (allWrap6 inputs hin0 hroot 19 (by norm_num))
