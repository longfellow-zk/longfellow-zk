/-- **Round 21, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_21 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_21.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 22 4 = SHA256.w32 (
      stateWord inputs 21 3 + (stateWord inputs 21 7 + SHA256.Sigma1 (stateWord inputs 21 4)
        + SHA256.Ch (stateWord inputs 21 4) (stateWord inputs 21 5) (stateWord inputs 21 6)
        + SHA256.K.getD 21 0 + wWord inputs 21)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_21 inputs i = 0 ∨ lvR6_21 inputs i = 1 :=
    lvBitsR6_21 inputs hin0 hbz
  have hone : lvR6_21 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
