  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_20a (lvR6_20 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbR6_20a (lvR6_20 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_20b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_20b (lvR6_20 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbR6_20b (lvR6_20 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_20c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_20c (lvR6_20 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbR6_20c (lvR6_20 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_20d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_20d (lvR6_20 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_20d (lvR6_20 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_20e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_20e (lvR6_20 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_20e (lvR6_20 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_20_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_20p (lvR6_20 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_20p (lvR6_20 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have heA : A = SHA256.ofBits (bwR6_20outa16 inputs) := by rw [hvA]; rfl
  have heB : B = SHA256.ofBits (bwR6_20oute16 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_20oute19 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_20oute19 inputs) (by rfl)
      (fun q hq => by rw [bwR6_20oute19_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_20c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_20oute19 inputs))
      (SHA256.ofBits (bwR6_20oute18 inputs)) (SHA256.ofBits (bwR6_20oute17 inputs)) := by
    rw [hvD, SHA256.Ch_bits (bwR6_20oute19 inputs) (bwR6_20oute18 inputs)
      (bwR6_20oute17 inputs) (by rfl)
      (fun q hq => by rw [bwR6_20oute19_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_20oute18_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_20oute17_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_20d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_20outw4 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_20oute20 inputs) := by rw [hvP]; rfl
  simp only [stateWord, wWord, ← bwR6_20oute20_eq, ← bwR6_20outa16_eq, ← bwR6_20oute16_eq, ← bwR6_20oute17_eq, ← bwR6_20oute18_eq, ← bwR6_20oute19_eq, ← bwR6_20outw4_eq]
  rw [← heP, ← heA, ← heB, ← heC, ← heD, ← heE]
  rw [hres]
  refine congrArg SHA256.w32 ?_
  norm_num [SHA256.K]
  try omega

