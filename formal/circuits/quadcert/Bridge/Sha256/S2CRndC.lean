    SHA256F.wrap_six_words (p := p256w) (gR6_17a (lvR6_17 inputs)) (gR6_17b (lvR6_17 inputs)) (gR6_17c (lvR6_17 inputs)) (gR6_17d (lvR6_17 inputs)) (gR6_17e (lvR6_17 inputs))
      (dsR6_17 (lvR6_17 inputs)) 4022224774 (interpDag (raw.toDag (cnstw F)) inputs 25185)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_17a]) (by norm_num [gR6_17b]) (by norm_num [gR6_17c]) (by norm_num [gR6_17d]) (by norm_num [gR6_17e]) (by norm_num [dsR6_17])
