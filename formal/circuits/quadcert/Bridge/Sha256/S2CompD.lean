/-- **The schedule recurrence for `W39`, over the deployed circuit.** -/
theorem sched39 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS39.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 39))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 24)))
          + SHA256.ofBits (bitsOf inputs (wordBits 32))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 37)))
          + SHA256.ofBits (bitsOf inputs (wordBits 23))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS39 inputs i = 0 ∨ lvS39 inputs i = 1 :=
    lvBits39 inputs hin0 hbz
  have hone : lvS39 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS39a (lvS39 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS39a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS39a (lvS39 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS39b (lvS39 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS39b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS39b (lvS39 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS39c (lvS39 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS39c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS39c (lvS39 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS39d (lvS39 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS39d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS39d (lvS39 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS39 (lvS39 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS39_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS39p (lvS39 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS39a (lvS39 inputs)) (gS39b (lvS39 inputs)) (gS39c (lvS39 inputs))
      (gS39d (lvS39 inputs)) (dsS39 (lvS39 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 31725)
      hma hmb hmc hmd hmp (by norm_num [gS39a]) (by norm_num [gS39b])
      (by norm_num [gS39c]) (by norm_num [gS39d]) (by norm_num [dsS39]) (by norm_num)
      (zval_S39 inputs hin0) (allWrap4 inputs hin0 hroot 23 (by norm_num))
  rw [gS39a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS39a (lvS39 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS39a (lvS39 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS39b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS39b (lvS39 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS39b (lvS39 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS39c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS39c (lvS39 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS39c (lvS39 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS39d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS39d (lvS39 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS39d (lvS39 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS39_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS39p (lvS39 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS39p (lvS39 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 24))) := by
    rw [hvA, ← bwS39a_eq, SHA256.sigma0_bits (bwS39a inputs) (by rfl)
      (fun b hb => by rw [bwS39a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS39a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 37))) := by
    rw [hvC, ← bwS39c_eq, SHA256.sigma1_bits (bwS39c inputs) (by rfl)
      (fun b hb => by rw [bwS39c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS39c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 32)) := by
    rw [hvB, ← bwS39b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 23)) := by
    rw [hvD, ← bwS39d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 39)) := by
    rw [hvP, ← bwS39p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

end Sha256Blk
