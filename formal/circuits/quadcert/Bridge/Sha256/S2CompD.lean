/-- **The schedule recurrence for `W38`, over the deployed circuit.** -/
theorem sched38 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS38.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 38))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 23)))
          + SHA256.ofBits (bitsOf inputs (wordBits 31))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 36)))
          + SHA256.ofBits (bitsOf inputs (wordBits 22))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS38 inputs i = 0 ∨ lvS38 inputs i = 1 :=
    lvBits38 inputs hin0 hbz
  have hone : lvS38 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS38a (lvS38 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS38a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS38a (lvS38 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS38b (lvS38 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS38b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS38b (lvS38 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS38c (lvS38 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS38c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS38c (lvS38 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS38d (lvS38 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS38d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS38d (lvS38 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS38 (lvS38 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS38_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS38p (lvS38 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS38a (lvS38 inputs)) (gS38b (lvS38 inputs)) (gS38c (lvS38 inputs))
      (gS38d (lvS38 inputs)) (dsS38 (lvS38 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 27043)
      hma hmb hmc hmd hmp (by norm_num [gS38a]) (by norm_num [gS38b])
      (by norm_num [gS38c]) (by norm_num [gS38d]) (by norm_num [dsS38]) (by norm_num)
      (zval_S38 inputs hin0) (allWrap4 inputs hin0 hroot 22 (by norm_num))
  rw [gS38a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS38a (lvS38 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS38a (lvS38 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS38b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS38b (lvS38 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS38b (lvS38 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS38c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS38c (lvS38 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS38c (lvS38 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS38d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS38d (lvS38 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS38d (lvS38 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS38_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS38p (lvS38 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS38p (lvS38 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 23))) := by
    rw [hvA, ← bwS38a_eq, SHA256.sigma0_bits (bwS38a inputs) (by rfl)
      (fun b hb => by rw [bwS38a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS38a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 36))) := by
    rw [hvC, ← bwS38c_eq, SHA256.sigma1_bits (bwS38c inputs) (by rfl)
      (fun b hb => by rw [bwS38c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS38c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 31)) := by
    rw [hvB, ← bwS38b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 22)) := by
    rw [hvD, ← bwS38d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 38)) := by
    rw [hvP, ← bwS38p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

