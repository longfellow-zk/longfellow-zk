/-- **The schedule recurrence for `W37`, over the deployed circuit.** -/
theorem sched37 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS37.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 37))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 22)))
          + SHA256.ofBits (bitsOf inputs (wordBits 30))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 35)))
          + SHA256.ofBits (bitsOf inputs (wordBits 21))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS37 inputs i = 0 ∨ lvS37 inputs i = 1 :=
    lvBits37 inputs hin0 hbz
  have hone : lvS37 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS37a (lvS37 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS37a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS37a (lvS37 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS37b (lvS37 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS37b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS37b (lvS37 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS37c (lvS37 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS37c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS37c (lvS37 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS37d (lvS37 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS37d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS37d (lvS37 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS37 (lvS37 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS37_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS37p (lvS37 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS37a (lvS37 inputs)) (gS37b (lvS37 inputs)) (gS37c (lvS37 inputs))
      (gS37d (lvS37 inputs)) (dsS37 (lvS37 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 24760)
      hma hmb hmc hmd hmp (by norm_num [gS37a]) (by norm_num [gS37b])
      (by norm_num [gS37c]) (by norm_num [gS37d]) (by norm_num [dsS37]) (by norm_num)
      (zval_S37 inputs hin0) (allWrap4 inputs hin0 hroot 21 (by norm_num))
  rw [gS37a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS37a (lvS37 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS37a (lvS37 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS37b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS37b (lvS37 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS37b (lvS37 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS37c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS37c (lvS37 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS37c (lvS37 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS37d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS37d (lvS37 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS37d (lvS37 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS37_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS37p (lvS37 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS37p (lvS37 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 22))) := by
    rw [hvA, ← bwS37a_eq, SHA256.sigma0_bits (bwS37a inputs) (by rfl)
      (fun b hb => by rw [bwS37a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS37a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 35))) := by
    rw [hvC, ← bwS37c_eq, SHA256.sigma1_bits (bwS37c inputs) (by rfl)
      (fun b hb => by rw [bwS37c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS37c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 30)) := by
    rw [hvB, ← bwS37b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 21)) := by
    rw [hvD, ← bwS37d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 37)) := by
    rw [hvP, ← bwS37p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

