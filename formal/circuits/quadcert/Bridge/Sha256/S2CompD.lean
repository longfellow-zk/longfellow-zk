/-- **The schedule recurrence for `W34`, over the deployed circuit.** -/
theorem sched34 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS34.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 34))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 19)))
          + SHA256.ofBits (bitsOf inputs (wordBits 27))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 32)))
          + SHA256.ofBits (bitsOf inputs (wordBits 18))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS34 inputs i = 0 ∨ lvS34 inputs i = 1 :=
    lvBits34 inputs hin0 hbz
  have hone : lvS34 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS34a (lvS34 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS34a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS34a (lvS34 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS34b (lvS34 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS34b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS34b (lvS34 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS34c (lvS34 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS34c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS34c (lvS34 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS34d (lvS34 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS34d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS34d (lvS34 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS34 (lvS34 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS34_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS34p (lvS34 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS34a (lvS34 inputs)) (gS34b (lvS34 inputs)) (gS34c (lvS34 inputs))
      (gS34d (lvS34 inputs)) (dsS34 (lvS34 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 23211)
      hma hmb hmc hmd hmp (by norm_num [gS34a]) (by norm_num [gS34b])
      (by norm_num [gS34c]) (by norm_num [gS34d]) (by norm_num [dsS34]) (by norm_num)
      (zval_S34 inputs hin0) (allWrap4 inputs hin0 hroot 18 (by norm_num))
  rw [gS34a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS34a (lvS34 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS34a (lvS34 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS34b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS34b (lvS34 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS34b (lvS34 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS34c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS34c (lvS34 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS34c (lvS34 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS34d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS34d (lvS34 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS34d (lvS34 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS34_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS34p (lvS34 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS34p (lvS34 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 19))) := by
    rw [hvA, ← bwS34a_eq, SHA256.sigma0_bits (bwS34a inputs) (by rfl)
      (fun b hb => by rw [bwS34a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS34a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 32))) := by
    rw [hvC, ← bwS34c_eq, SHA256.sigma1_bits (bwS34c inputs) (by rfl)
      (fun b hb => by rw [bwS34c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS34c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 27)) := by
    rw [hvB, ← bwS34b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 18)) := by
    rw [hvD, ← bwS34d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 34)) := by
    rw [hvP, ← bwS34p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

/-! #### Composition for `W35` -/

/-- The cone's leaf valuation. -/
noncomputable def lvS35 (inputs : Nat → F) : Nat → F :=
  fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS35.getD h 0)

noncomputable def vS35a (lv : Nat → F) : Nat → F
  | 0 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS35 261) (lv 35)
  | 1 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS35 235) (lv 34)
