theorem nbR7_32c (inputs : Nat → F)
    (hlv : ∀ i, i < 289 → lvR7_32 inputs i = 0 ∨ lvR7_32 inputs i = 1) :
    ∀ j, j < 32 → SHA256F.natBit (vR7_32c (lvR7_32 inputs) j)
      = SHA256.chb ((bwR7_32oute31 inputs).getD j 0) ((bwR7_32oute30 inputs).getD j 0)
          ((bwR7_32oute29 inputs).getD j 0) := by
  intro j hj
  match j, hj with
  | 0, _ =>
      show SHA256F.natBit (Quadcert.chVal (lvR7_32 inputs 229) (lvR7_32 inputs 1)
          (lvR7_32 inputs 196))
        = SHA256.chb (SHA256F.natBit (lvR7_32 inputs 229)) (SHA256F.natBit (lvR7_32 inputs 1)) (SHA256F.natBit (lvR7_32 inputs 196))
      exact natBit_chVal (hlv 229 (by norm_num)) (hlv 1 (by norm_num))
        (hlv 196 (by norm_num))
  | 1, _ =>
      show SHA256F.natBit (Quadcert.chVal (lvR7_32 inputs 6) (lvR7_32 inputs 56)
          (lvR7_32 inputs 195))
        = SHA256.chb (SHA256F.natBit (lvR7_32 inputs 6)) (SHA256F.natBit (lvR7_32 inputs 56)) (SHA256F.natBit (lvR7_32 inputs 195))
      exact natBit_chVal (hlv 6 (by norm_num)) (hlv 56 (by norm_num))
        (hlv 195 (by norm_num))
  | 2, _ =>
      show SHA256F.natBit (Quadcert.chVal (lvR7_32 inputs 259) (lvR7_32 inputs 53)
          (lvR7_32 inputs 193))
        = SHA256.chb (SHA256F.natBit (lvR7_32 inputs 259)) (SHA256F.natBit (lvR7_32 inputs 53)) (SHA256F.natBit (lvR7_32 inputs 193))
      exact natBit_chVal (hlv 259 (by norm_num)) (hlv 53 (by norm_num))
        (hlv 193 (by norm_num))
  | 3, _ =>
