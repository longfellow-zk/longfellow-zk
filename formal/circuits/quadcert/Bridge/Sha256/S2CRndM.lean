      exact natBit_chVal (hlv 258 (by norm_num)) (hlv 50 (by norm_num))
        (hlv 191 (by norm_num))
  | 4, _ =>
      show SHA256F.natBit (Quadcert.chVal (lvR7_32 inputs 257) (lvR7_32 inputs 47)
