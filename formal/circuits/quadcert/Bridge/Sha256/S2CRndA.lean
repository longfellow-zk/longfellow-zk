/-- **Round 5, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_5 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_5.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 6 4 = SHA256.w32 (
      stateWord inputs 5 3 + (stateWord inputs 5 7 + SHA256.Sigma1 (stateWord inputs 5 4)
        + SHA256.Ch (stateWord inputs 5 4) (stateWord inputs 5 5) (stateWord inputs 5 6)
        + SHA256.K.getD 5 0 + wWord inputs 5)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_5 inputs i = 0 ∨ lvR6_5 inputs i = 1 :=
    lvBitsR6_5 inputs hin0 hbz
  have hone : lvR6_5 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
