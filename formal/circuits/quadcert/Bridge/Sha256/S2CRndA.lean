/-- **Round 0, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_0 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_0.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 1 4 = SHA256.w32 (
      stateWord inputs 0 3 + (stateWord inputs 0 7 + SHA256.Sigma1 (stateWord inputs 0 4)
        + SHA256.Ch (stateWord inputs 0 4) (stateWord inputs 0 5) (stateWord inputs 0 6)
        + SHA256.K.getD 0 0 + wWord inputs 0)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_0 inputs i = 0 ∨ lvR6_0 inputs i = 1 :=
    lvBitsR6_0 inputs hin0 hbz
  have hone : lvR6_0 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_0a (lvR6_0 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_0a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_0a (lvR6_0 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_0b (lvR6_0 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_0b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_0b (lvR6_0 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_0c (lvR6_0 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_0c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_0c (lvR6_0 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR6_0d (lvR6_0 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_0d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_0d (lvR6_0 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_0e (lvR6_0 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_0e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_0e (lvR6_0 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR6_0 (lvR6_0 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_0_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_0p (lvR6_0 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, E, P, hA, hB, hC, hD, hE, hP, hAlt, hBlt, hClt, hDlt, hElt, hPlt, hres⟩ :=
    SHA256F.wrap_six_words (p := p256w) (gR6_0a (lvR6_0 inputs)) (gR6_0b (lvR6_0 inputs)) (gR6_0c (lvR6_0 inputs)) (gR6_0d (lvR6_0 inputs)) (gR6_0e (lvR6_0 inputs))
      (dsR6_0 (lvR6_0 inputs)) 1116352408 (interpDag (raw.toDag (cnstw F)) inputs 27313)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_0a]) (by norm_num [gR6_0b]) (by norm_num [gR6_0c]) (by norm_num [gR6_0d]) (by norm_num [gR6_0e]) (by norm_num [dsR6_0])
      (by norm_num) (by norm_num) (zval_R6_0 inputs hin0)
      (allWrap6 inputs hin0 hroot 0 (by norm_num))
  rw [gR6_0a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_0a (lvR6_0 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbR6_0a (lvR6_0 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_0b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_0b (lvR6_0 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbR6_0b (lvR6_0 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_0c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_0c (lvR6_0 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbR6_0c (lvR6_0 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_0d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_0d (lvR6_0 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_0d (lvR6_0 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_0e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_0e (lvR6_0 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_0e (lvR6_0 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_0_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_0p (lvR6_0 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_0p (lvR6_0 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have heA : A = SHA256.ofBits (bwR6_0h03 inputs) := by rw [hvA]; rfl
  have heB : B = SHA256.ofBits (bwR6_0h07 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_0h04 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_0h04 inputs) (by rfl)
      (fun q hq => by rw [bwR6_0h04_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_0c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_0h04 inputs))
      (SHA256.ofBits (bwR6_0h05 inputs)) (SHA256.ofBits (bwR6_0h06 inputs)) := by
    rw [hvD, SHA256.Ch_bits (bwR6_0h04 inputs) (bwR6_0h05 inputs)
      (bwR6_0h06 inputs) (by rfl)
      (fun q hq => by rw [bwR6_0h04_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_0h05_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_0h06_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_0d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_0inputblock0 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_0oute0 inputs) := by rw [hvP]; rfl
  simp only [stateWord, wWord, ← bwR6_0oute0_eq, ← bwR6_0h03_eq, ← bwR6_0h04_eq, ← bwR6_0h05_eq, ← bwR6_0h06_eq, ← bwR6_0h07_eq, ← bwR6_0inputblock0_eq]
  rw [← heP, ← heA, ← heB, ← heC, ← heD, ← heE]
  rw [hres]
  refine congrArg SHA256.w32 ?_
  norm_num [SHA256.K]
  try omega

