theorem nbR6_3d (inputs : Nat → F)
    (hlv : ∀ i, i < 225 → lvR6_3 inputs i = 0 ∨ lvR6_3 inputs i = 1) :
    ∀ j, j < 32 → SHA256F.natBit (vR6_3d (lvR6_3 inputs) j)
      = SHA256.chb ((bwR6_3oute2 inputs).getD j 0) ((bwR6_3oute1 inputs).getD j 0)
          ((bwR6_3oute0 inputs).getD j 0) := by
  intro j hj
  match j, hj with
  | 0, _ =>
      show SHA256F.natBit (Quadcert.chVal (lvR6_3 inputs 126) (lvR6_3 inputs 224)
          (lvR6_3 inputs 165))
        = SHA256.chb (SHA256F.natBit (lvR6_3 inputs 126)) (SHA256F.natBit (lvR6_3 inputs 224)) (SHA256F.natBit (lvR6_3 inputs 165))
      exact natBit_chVal (hlv 126 (by norm_num)) (hlv 224 (by norm_num))
        (hlv 165 (by norm_num))
