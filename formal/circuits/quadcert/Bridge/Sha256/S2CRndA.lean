  have hmd : ∀ q ∈ gR6_2d (lvR6_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_2d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_2d (lvR6_2 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_2e (lvR6_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_2e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
