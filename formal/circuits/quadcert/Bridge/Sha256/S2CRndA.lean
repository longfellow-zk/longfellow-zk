    rw [hvC, SHA256.Sigma1_bits (bwR6_2oute1 inputs) (by rfl)
      (fun q hq => by rw [bwR6_2oute1_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_2c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_2oute1 inputs))
