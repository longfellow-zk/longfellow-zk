  have hmp : ∀ q ∈ dsR6_2 (lvR6_2 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_2_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_2p (lvR6_2 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, E, P, hA, hB, hC, hD, hE, hP, hAlt, hBlt, hClt, hDlt, hElt, hPlt, hres⟩ :=
    SHA256F.wrap_six_words (p := p256w) (gR6_2a (lvR6_2 inputs)) (gR6_2b (lvR6_2 inputs)) (gR6_2c (lvR6_2 inputs)) (gR6_2d (lvR6_2 inputs)) (gR6_2e (lvR6_2 inputs))
      (dsR6_2 (lvR6_2 inputs)) 3049323471 (interpDag (raw.toDag (cnstw F)) inputs 32894)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_2a]) (by norm_num [gR6_2b]) (by norm_num [gR6_2c]) (by norm_num [gR6_2d]) (by norm_num [gR6_2e]) (by norm_num [dsR6_2])
