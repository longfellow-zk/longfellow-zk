/-- Booleanity of every template leaf, index `0` (the constant one) included. -/
theorem lvBitsR6_47 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_47.getD j (0, 0)).1 = 0) :
    ∀ i, i < 225 → interpDag (raw.toDag (cnstw F)) inputs (mpR6_47.getD i 0) = 0
      ∨ interpDag (raw.toDag (cnstw F)) inputs (mpR6_47.getD i 0) = 1 := by
