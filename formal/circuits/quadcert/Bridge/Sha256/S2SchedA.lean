    rw [nodes_len]; decide +kernel
  have hlen : bpS19.length = 160 := by rfl
  exact bits_of_boolNodes_idx raw (cnstw F) inputs nodeFn nodefn_ok cnstw_0 hc2 hone bpS19
    hshape hltc (fun j hj => hbz j (by rw [hlen] at hj; exact hj))

