  have hone : (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS16.getD h 0)) 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  show interpDag (raw.toDag (cnstw F)) inputs (mpS16.getD 265 0) = _
  rw [htr, tmpl_zS16 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS16.getD h 0)) hone]

