theorem zval_S16 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1) :
    interpDag (raw.toDag (cnstw F)) inputs 35132
      = (((gS16a (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS16.getD h 0)) ++ gS16b (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS16.getD h 0)) ++ gS16c (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS16.getD h 0)) ++ gS16d (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS16.getD h 0)))).map
