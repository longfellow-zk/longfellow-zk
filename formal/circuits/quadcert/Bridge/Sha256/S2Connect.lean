import quadcert.Bridge.Sha256.S2TmplWrap
import quadcert.Core.BackedIdx

set_option maxRecDepth 8000000
set_option maxHeartbeats 2000000

namespace Sha256Blk

open Quadcert Quadcert.Gen.Sha256Blk

