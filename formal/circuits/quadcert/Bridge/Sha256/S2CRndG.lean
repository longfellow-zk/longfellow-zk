/-- **Round 49, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_49 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_49.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 50 4 = SHA256.w32 (
      stateWord inputs 49 3 + (stateWord inputs 49 7 + SHA256.Sigma1 (stateWord inputs 49 4)
        + SHA256.Ch (stateWord inputs 49 4) (stateWord inputs 49 5) (stateWord inputs 49 6)
        + SHA256.K.getD 49 0 + wWord inputs 49)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_49 inputs i = 0 ∨ lvR6_49 inputs i = 1 :=
    lvBitsR6_49 inputs hin0 hbz
  have hone : lvR6_49 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_49a (lvR6_49 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_49a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_49a (lvR6_49 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_49b (lvR6_49 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_49b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_49b (lvR6_49 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_49c (lvR6_49 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_49c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_49c (lvR6_49 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR6_49d (lvR6_49 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_49d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_49d (lvR6_49 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_49e (lvR6_49 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_49e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_49e (lvR6_49 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR6_49 (lvR6_49 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_49_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_49p (lvR6_49 inputs) hone c0 c1 hlv i hi
