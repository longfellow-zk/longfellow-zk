/-- **Round 55, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_55 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_55.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 56 4 = SHA256.w32 (
      stateWord inputs 55 3 + (stateWord inputs 55 7 + SHA256.Sigma1 (stateWord inputs 55 4)
        + SHA256.Ch (stateWord inputs 55 4) (stateWord inputs 55 5) (stateWord inputs 55 6)
        + SHA256.K.getD 55 0 + wWord inputs 55)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_55 inputs i = 0 ∨ lvR6_55 inputs i = 1 :=
    lvBitsR6_55 inputs hin0 hbz
  have hone : lvR6_55 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_55a (lvR6_55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_55a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_55a (lvR6_55 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_55b (lvR6_55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_55b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_55b (lvR6_55 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_55c (lvR6_55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_55c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_55c (lvR6_55 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR6_55d (lvR6_55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_55d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_55d (lvR6_55 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_55e (lvR6_55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_55e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_55e (lvR6_55 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR6_55 (lvR6_55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_55_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_55p (lvR6_55 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, E, P, hA, hB, hC, hD, hE, hP, hAlt, hBlt, hClt, hDlt, hElt, hPlt, hres⟩ :=
    SHA256F.wrap_six_words (p := p256w) (gR6_55a (lvR6_55 inputs)) (gR6_55b (lvR6_55 inputs)) (gR6_55c (lvR6_55 inputs)) (gR6_55d (lvR6_55 inputs)) (gR6_55e (lvR6_55 inputs))
      (dsR6_55 (lvR6_55 inputs)) 1747873779 (interpDag (raw.toDag (cnstw F)) inputs 12962)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_55a]) (by norm_num [gR6_55b]) (by norm_num [gR6_55c]) (by norm_num [gR6_55d]) (by norm_num [gR6_55e]) (by norm_num [dsR6_55])
      (by norm_num) (by norm_num) (zval_R6_55 inputs hin0)
      (allWrap6 inputs hin0 hroot 55 (by norm_num))
  rw [gR6_55a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_55a (lvR6_55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbR6_55a (lvR6_55 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_55b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_55b (lvR6_55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbR6_55b (lvR6_55 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_55c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_55c (lvR6_55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbR6_55c (lvR6_55 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_55d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_55d (lvR6_55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_55d (lvR6_55 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_55e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_55e (lvR6_55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_55e (lvR6_55 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_55_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_55p (lvR6_55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_55p (lvR6_55 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have heA : A = SHA256.ofBits (bwR6_55outa51 inputs) := by rw [hvA]; rfl
  have heB : B = SHA256.ofBits (bwR6_55oute51 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_55oute54 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_55oute54 inputs) (by rfl)
      (fun q hq => by rw [bwR6_55oute54_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_55c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_55oute54 inputs))
      (SHA256.ofBits (bwR6_55oute53 inputs)) (SHA256.ofBits (bwR6_55oute52 inputs)) := by
    rw [hvD, SHA256.Ch_bits (bwR6_55oute54 inputs) (bwR6_55oute53 inputs)
      (bwR6_55oute52 inputs) (by rfl)
      (fun q hq => by rw [bwR6_55oute54_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_55oute53_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_55oute52_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_55d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_55outw39 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_55oute55 inputs) := by rw [hvP]; rfl
  simp only [stateWord, wWord, ← bwR6_55oute55_eq, ← bwR6_55outa51_eq, ← bwR6_55oute51_eq, ← bwR6_55oute52_eq, ← bwR6_55oute53_eq, ← bwR6_55oute54_eq, ← bwR6_55outw39_eq]
  rw [← heP, ← heA, ← heB, ← heC, ← heD, ← heE]
  rw [hres]
