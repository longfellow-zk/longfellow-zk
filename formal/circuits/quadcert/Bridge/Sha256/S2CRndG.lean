  have hmp : ∀ q ∈ dsR6_51 (lvR6_51 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_51_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
