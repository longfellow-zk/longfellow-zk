/-- **Round 52, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_52 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_52.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 53 4 = SHA256.w32 (
      stateWord inputs 52 3 + (stateWord inputs 52 7 + SHA256.Sigma1 (stateWord inputs 52 4)
        + SHA256.Ch (stateWord inputs 52 4) (stateWord inputs 52 5) (stateWord inputs 52 6)
        + SHA256.K.getD 52 0 + wWord inputs 52)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_52 inputs i = 0 ∨ lvR6_52 inputs i = 1 :=
    lvBitsR6_52 inputs hin0 hbz
  have hone : lvR6_52 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_52a (lvR6_52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_52a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_52a (lvR6_52 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_52b (lvR6_52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_52b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_52b (lvR6_52 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_52c (lvR6_52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_52c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_52c (lvR6_52 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR6_52d (lvR6_52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_52d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_52d (lvR6_52 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_52e (lvR6_52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_52e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_52e (lvR6_52 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR6_52 (lvR6_52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_52_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_52p (lvR6_52 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, E, P, hA, hB, hC, hD, hE, hP, hAlt, hBlt, hClt, hDlt, hElt, hPlt, hres⟩ :=
    SHA256F.wrap_six_words (p := p256w) (gR6_52a (lvR6_52 inputs)) (gR6_52b (lvR6_52 inputs)) (gR6_52c (lvR6_52 inputs)) (gR6_52d (lvR6_52 inputs)) (gR6_52e (lvR6_52 inputs))
      (dsR6_52 (lvR6_52 inputs)) 958139571 (interpDag (raw.toDag (cnstw F)) inputs 30179)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_52a]) (by norm_num [gR6_52b]) (by norm_num [gR6_52c]) (by norm_num [gR6_52d]) (by norm_num [gR6_52e]) (by norm_num [dsR6_52])
      (by norm_num) (by norm_num) (zval_R6_52 inputs hin0)
      (allWrap6 inputs hin0 hroot 52 (by norm_num))
