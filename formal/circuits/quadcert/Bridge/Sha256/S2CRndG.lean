    SHA256F.wrap_six_words (p := p256w) (gR6_49a (lvR6_49 inputs)) (gR6_49b (lvR6_49 inputs)) (gR6_49c (lvR6_49 inputs)) (gR6_49d (lvR6_49 inputs)) (gR6_49e (lvR6_49 inputs))
      (dsR6_49 (lvR6_49 inputs)) 506948616 (interpDag (raw.toDag (cnstw F)) inputs 11530)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_49a]) (by norm_num [gR6_49b]) (by norm_num [gR6_49c]) (by norm_num [gR6_49d]) (by norm_num [gR6_49e]) (by norm_num [dsR6_49])
