  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_48a (lvR6_48 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbR6_48a (lvR6_48 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_48b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_48b (lvR6_48 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbR6_48b (lvR6_48 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_48c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_48c (lvR6_48 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbR6_48c (lvR6_48 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_48d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_48d (lvR6_48 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_48d (lvR6_48 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_48e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_48e (lvR6_48 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_48e (lvR6_48 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_48_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_48p (lvR6_48 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_48p (lvR6_48 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have heA : A = SHA256.ofBits (bwR6_48outa44 inputs) := by rw [hvA]; rfl
  have heB : B = SHA256.ofBits (bwR6_48oute44 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_48oute47 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_48oute47 inputs) (by rfl)
      (fun q hq => by rw [bwR6_48oute47_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_48c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_48oute47 inputs))
      (SHA256.ofBits (bwR6_48oute46 inputs)) (SHA256.ofBits (bwR6_48oute45 inputs)) := by
    rw [hvD, SHA256.Ch_bits (bwR6_48oute47 inputs) (bwR6_48oute46 inputs)
      (bwR6_48oute45 inputs) (by rfl)
      (fun q hq => by rw [bwR6_48oute47_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_48oute46_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_48oute45_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_48d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_48outw32 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_48oute48 inputs) := by rw [hvP]; rfl
  simp only [stateWord, wWord, ← bwR6_48oute48_eq, ← bwR6_48outa44_eq, ← bwR6_48oute44_eq, ← bwR6_48oute45_eq, ← bwR6_48oute46_eq, ← bwR6_48oute47_eq, ← bwR6_48outw32_eq]
  rw [← heP, ← heA, ← heB, ← heC, ← heD, ← heE]
  rw [hres]
