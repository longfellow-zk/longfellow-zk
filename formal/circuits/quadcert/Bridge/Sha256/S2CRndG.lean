  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_52a (lvR6_52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbR6_52a (lvR6_52 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_52b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_52b (lvR6_52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbR6_52b (lvR6_52 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_52c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_52c (lvR6_52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbR6_52c (lvR6_52 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_52d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_52d (lvR6_52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_52d (lvR6_52 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_52e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_52e (lvR6_52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_52e (lvR6_52 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_52_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_52p (lvR6_52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_52p (lvR6_52 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have heA : A = SHA256.ofBits (bwR6_52outa48 inputs) := by rw [hvA]; rfl
  have heB : B = SHA256.ofBits (bwR6_52oute48 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_52oute51 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_52oute51 inputs) (by rfl)
      (fun q hq => by rw [bwR6_52oute51_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_52c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heD : D = SHA256.Ch (SHA256.ofBits (bwR6_52oute51 inputs))
      (SHA256.ofBits (bwR6_52oute50 inputs)) (SHA256.ofBits (bwR6_52oute49 inputs)) := by
    rw [hvD, SHA256.Ch_bits (bwR6_52oute51 inputs) (bwR6_52oute50 inputs)
      (bwR6_52oute49 inputs) (by rfl)
      (fun q hq => by rw [bwR6_52oute51_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_52oute50_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_52oute49_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_52d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_52outw36 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_52oute52 inputs) := by rw [hvP]; rfl
  simp only [stateWord, wWord, ← bwR6_52oute52_eq, ← bwR6_52outa48_eq, ← bwR6_52oute48_eq, ← bwR6_52oute49_eq, ← bwR6_52oute50_eq, ← bwR6_52oute51_eq, ← bwR6_52outw36_eq]
  rw [← heP, ← heA, ← heB, ← heC, ← heD, ← heE]
  rw [hres]
  refine congrArg SHA256.w32 ?_
  norm_num [SHA256.K]
  try omega

