    SHA256F.wrap_six_words (p := p256w) (gR6_25a (lvR6_25 inputs)) (gR6_25b (lvR6_25 inputs)) (gR6_25c (lvR6_25 inputs)) (gR6_25d (lvR6_25 inputs)) (gR6_25e (lvR6_25 inputs))
      (dsR6_25 (lvR6_25 inputs)) 2821834349 (interpDag (raw.toDag (cnstw F)) inputs 35852)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_25a]) (by norm_num [gR6_25b]) (by norm_num [gR6_25c]) (by norm_num [gR6_25d]) (by norm_num [gR6_25e]) (by norm_num [dsR6_25])
