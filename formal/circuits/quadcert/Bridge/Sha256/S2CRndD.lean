/-- **Round 26, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_26 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_26.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 27 4 = SHA256.w32 (
      stateWord inputs 26 3 + (stateWord inputs 26 7 + SHA256.Sigma1 (stateWord inputs 26 4)
        + SHA256.Ch (stateWord inputs 26 4) (stateWord inputs 26 5) (stateWord inputs 26 6)
        + SHA256.K.getD 26 0 + wWord inputs 26)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_26 inputs i = 0 ∨ lvR6_26 inputs i = 1 :=
    lvBitsR6_26 inputs hin0 hbz
  have hone : lvR6_26 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
