      stateWord inputs 28 3 + (stateWord inputs 28 7 + SHA256.Sigma1 (stateWord inputs 28 4)
        + SHA256.Ch (stateWord inputs 28 4) (stateWord inputs 28 5) (stateWord inputs 28 6)
        + SHA256.K.getD 28 0 + wWord inputs 28)) := by
