/-- **Round 24, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_24 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_24.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 25 4 = SHA256.w32 (
      stateWord inputs 24 3 + (stateWord inputs 24 7 + SHA256.Sigma1 (stateWord inputs 24 4)
        + SHA256.Ch (stateWord inputs 24 4) (stateWord inputs 24 5) (stateWord inputs 24 6)
        + SHA256.K.getD 24 0 + wWord inputs 24)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_24 inputs i = 0 ∨ lvR6_24 inputs i = 1 :=
    lvBitsR6_24 inputs hin0 hbz
  have hone : lvR6_24 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using hh
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_24a (lvR6_24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_24a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_24a (lvR6_24 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gR6_24b (lvR6_24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_24b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_24b (lvR6_24 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gR6_24c (lvR6_24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_24c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_24c (lvR6_24 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gR6_24d (lvR6_24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_24d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_24d (lvR6_24 inputs) hone c0 c1 hlv i hi
  have hme : ∀ q ∈ gR6_24e (lvR6_24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_24e_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_24e (lvR6_24 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsR6_24 (lvR6_24 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsR6_24_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbR6_24p (lvR6_24 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, E, P, hA, hB, hC, hD, hE, hP, hAlt, hBlt, hClt, hDlt, hElt, hPlt, hres⟩ :=
    SHA256F.wrap_six_words (p := p256w) (gR6_24a (lvR6_24 inputs)) (gR6_24b (lvR6_24 inputs)) (gR6_24c (lvR6_24 inputs)) (gR6_24d (lvR6_24 inputs)) (gR6_24e (lvR6_24 inputs))
      (dsR6_24 (lvR6_24 inputs)) 2554220882 (interpDag (raw.toDag (cnstw F)) inputs 19660)
      hma hmb hmc hmd hme hmp
      (by norm_num [gR6_24a]) (by norm_num [gR6_24b]) (by norm_num [gR6_24c]) (by norm_num [gR6_24d]) (by norm_num [gR6_24e]) (by norm_num [dsR6_24])
      (by norm_num) (by norm_num) (zval_R6_24 inputs hin0)
