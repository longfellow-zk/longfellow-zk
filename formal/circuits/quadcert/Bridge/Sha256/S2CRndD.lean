  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gR6_26a (lvR6_26 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gR6_26a_eq]
    intro q hq
