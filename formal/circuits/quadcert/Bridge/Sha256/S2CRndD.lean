    rw [hvD, SHA256.Ch_bits (bwR6_24oute23 inputs) (bwR6_24oute22 inputs)
      (bwR6_24oute21 inputs) (by rfl)
      (fun q hq => by rw [bwR6_24oute23_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_24oute22_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_24oute21_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_24d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_24outw8 inputs) := by rw [hvE]; rfl
  have heP : P = SHA256.ofBits (bwR6_24oute24 inputs) := by rw [hvP]; rfl
