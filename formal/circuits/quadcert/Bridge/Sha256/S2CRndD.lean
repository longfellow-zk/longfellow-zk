    stateWord inputs 31 4 = SHA256.w32 (
      stateWord inputs 30 3 + (stateWord inputs 30 7 + SHA256.Sigma1 (stateWord inputs 30 4)
        + SHA256.Ch (stateWord inputs 30 4) (stateWord inputs 30 5) (stateWord inputs 30 6)
        + SHA256.K.getD 30 0 + wWord inputs 30)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_30 inputs i = 0 ∨ lvR6_30 inputs i = 1 :=
    lvBitsR6_30 inputs hin0 hbz
  have hone : lvR6_30 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
