/-- **The schedule recurrence for `W44`, over the deployed circuit.** -/
theorem sched44 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS44.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 44))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 29)))
          + SHA256.ofBits (bitsOf inputs (wordBits 37))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 42)))
          + SHA256.ofBits (bitsOf inputs (wordBits 28))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS44 inputs i = 0 ∨ lvS44 inputs i = 1 :=
    lvBits44 inputs hin0 hbz
  have hone : lvS44 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS44a (lvS44 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS44a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS44a (lvS44 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS44b (lvS44 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS44b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS44b (lvS44 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS44c (lvS44 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS44c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS44c (lvS44 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS44d (lvS44 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS44d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS44d (lvS44 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS44 (lvS44 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS44_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS44p (lvS44 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS44a (lvS44 inputs)) (gS44b (lvS44 inputs)) (gS44c (lvS44 inputs))
      (gS44d (lvS44 inputs)) (dsS44 (lvS44 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 12295)
      hma hmb hmc hmd hmp (by norm_num [gS44a]) (by norm_num [gS44b])
      (by norm_num [gS44c]) (by norm_num [gS44d]) (by norm_num [dsS44]) (by norm_num)
      (zval_S44 inputs hin0) (allWrap4 inputs hin0 hroot 28 (by norm_num))
  rw [gS44a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS44a (lvS44 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS44a (lvS44 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS44b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS44b (lvS44 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS44b (lvS44 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS44c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS44c (lvS44 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS44c (lvS44 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS44d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS44d (lvS44 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS44d (lvS44 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS44_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS44p (lvS44 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS44p (lvS44 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 29))) := by
    rw [hvA, ← bwS44a_eq, SHA256.sigma0_bits (bwS44a inputs) (by rfl)
      (fun b hb => by rw [bwS44a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS44a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 42))) := by
    rw [hvC, ← bwS44c_eq, SHA256.sigma1_bits (bwS44c inputs) (by rfl)
      (fun b hb => by rw [bwS44c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS44c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 37)) := by
    rw [hvB, ← bwS44b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 28)) := by
    rw [hvD, ← bwS44d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 44)) := by
    rw [hvP, ← bwS44p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

