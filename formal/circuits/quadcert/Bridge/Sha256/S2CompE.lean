/-- **The schedule recurrence for `W45`, over the deployed circuit.** -/
theorem sched45 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS45.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 45))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 30)))
          + SHA256.ofBits (bitsOf inputs (wordBits 38))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 43)))
          + SHA256.ofBits (bitsOf inputs (wordBits 29))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS45 inputs i = 0 ∨ lvS45 inputs i = 1 :=
    lvBits45 inputs hin0 hbz
  have hone : lvS45 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS45a (lvS45 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS45a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS45a (lvS45 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS45b (lvS45 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS45b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS45b (lvS45 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS45c (lvS45 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS45c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS45c (lvS45 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS45d (lvS45 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS45d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS45d (lvS45 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS45 (lvS45 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS45_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS45p (lvS45 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS45a (lvS45 inputs)) (gS45b (lvS45 inputs)) (gS45c (lvS45 inputs))
      (gS45d (lvS45 inputs)) (dsS45 (lvS45 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 32329)
      hma hmb hmc hmd hmp (by norm_num [gS45a]) (by norm_num [gS45b])
      (by norm_num [gS45c]) (by norm_num [gS45d]) (by norm_num [dsS45]) (by norm_num)
      (zval_S45 inputs hin0) (allWrap4 inputs hin0 hroot 29 (by norm_num))
  rw [gS45a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS45a (lvS45 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS45a (lvS45 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS45b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS45b (lvS45 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS45b (lvS45 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS45c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS45c (lvS45 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS45c (lvS45 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS45d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS45d (lvS45 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS45d (lvS45 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS45_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS45p (lvS45 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS45p (lvS45 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 30))) := by
    rw [hvA, ← bwS45a_eq, SHA256.sigma0_bits (bwS45a inputs) (by rfl)
      (fun b hb => by rw [bwS45a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS45a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 43))) := by
    rw [hvC, ← bwS45c_eq, SHA256.sigma1_bits (bwS45c inputs) (by rfl)
      (fun b hb => by rw [bwS45c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS45c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 38)) := by
    rw [hvB, ← bwS45b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 29)) := by
    rw [hvD, ← bwS45d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 45)) := by
    rw [hvP, ← bwS45p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

end Sha256Blk
