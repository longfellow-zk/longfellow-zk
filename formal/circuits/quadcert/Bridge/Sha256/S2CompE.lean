/-- **The schedule recurrence for `W40`, over the deployed circuit.** -/
theorem sched40 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS40.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 40))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 25)))
          + SHA256.ofBits (bitsOf inputs (wordBits 33))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 38)))
          + SHA256.ofBits (bitsOf inputs (wordBits 24))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS40 inputs i = 0 ∨ lvS40 inputs i = 1 :=
    lvBits40 inputs hin0 hbz
  have hone : lvS40 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS40a (lvS40 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS40a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS40a (lvS40 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS40b (lvS40 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS40b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS40b (lvS40 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS40c (lvS40 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS40c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS40c (lvS40 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS40d (lvS40 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS40d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS40d (lvS40 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS40 (lvS40 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS40_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS40p (lvS40 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS40a (lvS40 inputs)) (gS40b (lvS40 inputs)) (gS40c (lvS40 inputs))
      (gS40d (lvS40 inputs)) (dsS40 (lvS40 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 32125)
      hma hmb hmc hmd hmp (by norm_num [gS40a]) (by norm_num [gS40b])
      (by norm_num [gS40c]) (by norm_num [gS40d]) (by norm_num [dsS40]) (by norm_num)
      (zval_S40 inputs hin0) (allWrap4 inputs hin0 hroot 24 (by norm_num))
  rw [gS40a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS40a (lvS40 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS40a (lvS40 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS40b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS40b (lvS40 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS40b (lvS40 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS40c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS40c (lvS40 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS40c (lvS40 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS40d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS40d (lvS40 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS40d (lvS40 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS40_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS40p (lvS40 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS40p (lvS40 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 25))) := by
    rw [hvA, ← bwS40a_eq, SHA256.sigma0_bits (bwS40a inputs) (by rfl)
      (fun b hb => by rw [bwS40a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS40a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 38))) := by
    rw [hvC, ← bwS40c_eq, SHA256.sigma1_bits (bwS40c inputs) (by rfl)
      (fun b hb => by rw [bwS40c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS40c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 33)) := by
    rw [hvB, ← bwS40b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 24)) := by
    rw [hvD, ← bwS40d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 40)) := by
    rw [hvP, ← bwS40p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

/-! #### Composition for `W41` -/

/-- The cone's leaf valuation. -/
noncomputable def lvS41 (inputs : Nat → F) : Nat → F :=
  fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS41.getD h 0)

noncomputable def vS41a (lv : Nat → F) : Nat → F
  | 0 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS41 260) (lv 61)
  | 1 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS41 216) (lv 60)
