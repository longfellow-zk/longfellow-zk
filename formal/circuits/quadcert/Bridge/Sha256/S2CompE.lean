/-- **The schedule recurrence for `W43`, over the deployed circuit.** -/
theorem sched43 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS43.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 43))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 28)))
          + SHA256.ofBits (bitsOf inputs (wordBits 36))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 41)))
          + SHA256.ofBits (bitsOf inputs (wordBits 27))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS43 inputs i = 0 ∨ lvS43 inputs i = 1 :=
    lvBits43 inputs hin0 hbz
  have hone : lvS43 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS43a (lvS43 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS43a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS43a (lvS43 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS43b (lvS43 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS43b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS43b (lvS43 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS43c (lvS43 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS43c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS43c (lvS43 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS43d (lvS43 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS43d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS43d (lvS43 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS43 (lvS43 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS43_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS43p (lvS43 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS43a (lvS43 inputs)) (gS43b (lvS43 inputs)) (gS43c (lvS43 inputs))
      (gS43d (lvS43 inputs)) (dsS43 (lvS43 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 23981)
      hma hmb hmc hmd hmp (by norm_num [gS43a]) (by norm_num [gS43b])
      (by norm_num [gS43c]) (by norm_num [gS43d]) (by norm_num [dsS43]) (by norm_num)
      (zval_S43 inputs hin0) (allWrap4 inputs hin0 hroot 27 (by norm_num))
  rw [gS43a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS43a (lvS43 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS43a (lvS43 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS43b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS43b (lvS43 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS43b (lvS43 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS43c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS43c (lvS43 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS43c (lvS43 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS43d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS43d (lvS43 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS43d (lvS43 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS43_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS43p (lvS43 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS43p (lvS43 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 28))) := by
    rw [hvA, ← bwS43a_eq, SHA256.sigma0_bits (bwS43a inputs) (by rfl)
      (fun b hb => by rw [bwS43a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS43a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 41))) := by
    rw [hvC, ← bwS43c_eq, SHA256.sigma1_bits (bwS43c inputs) (by rfl)
      (fun b hb => by rw [bwS43c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS43c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 36)) := by
    rw [hvB, ← bwS43b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 27)) := by
    rw [hvD, ← bwS43d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 43)) := by
    rw [hvP, ← bwS43p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

