        - ((dsS22 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS22.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have htr := coneIs_transfer raw (cnstw F) inputs nodeFn nodefn_ok tnS22
    (fun i => mpS22.getD i 0) coneS22 mapS22_lt 265 (by decide)
  have hone : (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS22.getD h 0)) 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  show interpDag (raw.toDag (cnstw F)) inputs (mpS22.getD 265 0) = _
  rw [htr, tmpl_zS22 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS22.getD h 0)) hone]

