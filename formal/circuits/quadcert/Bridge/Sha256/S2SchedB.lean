theorem zval_S25 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1) :
    interpDag (raw.toDag (cnstw F)) inputs 31512
      = (((gS25a (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS25.getD h 0)) ++ gS25b (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS25.getD h 0)) ++ gS25c (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS25.getD h 0)) ++ gS25d (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS25.getD h 0)))).map
          (fun q => (q.1 : F) * q.2)).sum
        - ((dsS25 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS25.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have htr := coneIs_transfer raw (cnstw F) inputs nodeFn nodefn_ok tnS25
    (fun i => mpS25.getD i 0) coneS25 mapS25_lt 265 (by decide)
  have hone : (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS25.getD h 0)) 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  show interpDag (raw.toDag (cnstw F)) inputs (mpS25.getD 265 0) = _
  rw [htr, tmpl_zS25 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS25.getD h 0)) hone]

