theorem coneS22 : coneIs nodeFn tnS22 (fun i => mpS22.getD i 0) = true := by decide +kernel

theorem mapS22_lt : ∀ i, i < tnS22.length → mpS22.getD i 0 < raw.nodes.length := by
  intro i hi
  have hlen : tnS22.length = 266 := by rfl
  rw [hlen] at hi
