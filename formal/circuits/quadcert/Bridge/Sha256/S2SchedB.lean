theorem zval_S22 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1) :
    interpDag (raw.toDag (cnstw F)) inputs 33009
      = (((gS22a (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS22.getD h 0)) ++ gS22b (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS22.getD h 0)) ++ gS22c (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS22.getD h 0)) ++ gS22d (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS22.getD h 0)))).map
