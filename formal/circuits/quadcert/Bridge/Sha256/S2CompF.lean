/-- **The schedule recurrence for `W46`, over the deployed circuit.** -/
theorem sched46 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS46.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 46))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 31)))
          + SHA256.ofBits (bitsOf inputs (wordBits 39))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 44)))
          + SHA256.ofBits (bitsOf inputs (wordBits 30))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS46 inputs i = 0 ∨ lvS46 inputs i = 1 :=
    lvBits46 inputs hin0 hbz
  have hone : lvS46 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS46a (lvS46 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS46a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS46a (lvS46 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS46b (lvS46 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS46b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS46b (lvS46 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS46c (lvS46 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS46c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS46c (lvS46 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS46d (lvS46 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS46d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS46d (lvS46 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS46 (lvS46 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS46_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS46p (lvS46 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS46a (lvS46 inputs)) (gS46b (lvS46 inputs)) (gS46c (lvS46 inputs))
      (gS46d (lvS46 inputs)) (dsS46 (lvS46 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 21869)
      hma hmb hmc hmd hmp (by norm_num [gS46a]) (by norm_num [gS46b])
      (by norm_num [gS46c]) (by norm_num [gS46d]) (by norm_num [dsS46]) (by norm_num)
      (zval_S46 inputs hin0) (allWrap4 inputs hin0 hroot 30 (by norm_num))
  rw [gS46a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS46a (lvS46 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS46a (lvS46 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS46b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS46b (lvS46 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS46b (lvS46 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS46c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS46c (lvS46 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS46c (lvS46 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS46d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS46d (lvS46 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS46d (lvS46 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS46_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS46p (lvS46 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS46p (lvS46 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 31))) := by
    rw [hvA, ← bwS46a_eq, SHA256.sigma0_bits (bwS46a inputs) (by rfl)
      (fun b hb => by rw [bwS46a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS46a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 44))) := by
    rw [hvC, ← bwS46c_eq, SHA256.sigma1_bits (bwS46c inputs) (by rfl)
      (fun b hb => by rw [bwS46c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS46c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 39)) := by
    rw [hvB, ← bwS46b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 30)) := by
    rw [hvD, ← bwS46d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 46)) := by
    rw [hvP, ← bwS46p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

/-! #### Composition for `W47` -/

/-- The cone's leaf valuation. -/
noncomputable def lvS47 (inputs : Nat → F) : Nat → F :=
  fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS47.getD h 0)

noncomputable def vS47a (lv : Nat → F) : Nat → F
  | 0 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS47 261) (lv 60)
  | 1 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS47 235) (lv 59)
