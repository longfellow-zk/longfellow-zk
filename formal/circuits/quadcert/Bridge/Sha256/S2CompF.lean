/-- **The schedule recurrence for `W50`, over the deployed circuit.** -/
theorem sched50 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS50.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 50))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 35)))
          + SHA256.ofBits (bitsOf inputs (wordBits 43))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 48)))
          + SHA256.ofBits (bitsOf inputs (wordBits 34))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS50 inputs i = 0 ∨ lvS50 inputs i = 1 :=
    lvBits50 inputs hin0 hbz
  have hone : lvS50 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS50a (lvS50 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS50a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS50a (lvS50 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS50b (lvS50 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS50b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS50b (lvS50 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS50c (lvS50 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS50c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS50c (lvS50 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS50d (lvS50 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS50d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS50d (lvS50 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS50 (lvS50 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS50_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS50p (lvS50 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS50a (lvS50 inputs)) (gS50b (lvS50 inputs)) (gS50c (lvS50 inputs))
      (gS50d (lvS50 inputs)) (dsS50 (lvS50 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 17902)
      hma hmb hmc hmd hmp (by norm_num [gS50a]) (by norm_num [gS50b])
      (by norm_num [gS50c]) (by norm_num [gS50d]) (by norm_num [dsS50]) (by norm_num)
      (zval_S50 inputs hin0) (allWrap4 inputs hin0 hroot 34 (by norm_num))
  rw [gS50a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS50a (lvS50 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS50a (lvS50 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS50b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS50b (lvS50 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS50b (lvS50 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS50c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS50c (lvS50 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS50c (lvS50 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS50d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS50d (lvS50 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS50d (lvS50 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS50_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS50p (lvS50 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS50p (lvS50 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 35))) := by
    rw [hvA, ← bwS50a_eq, SHA256.sigma0_bits (bwS50a inputs) (by rfl)
      (fun b hb => by rw [bwS50a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS50a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 48))) := by
    rw [hvC, ← bwS50c_eq, SHA256.sigma1_bits (bwS50c inputs) (by rfl)
      (fun b hb => by rw [bwS50c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS50c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 43)) := by
    rw [hvB, ← bwS50b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 34)) := by
    rw [hvD, ← bwS50d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 50)) := by
    rw [hvP, ← bwS50p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

