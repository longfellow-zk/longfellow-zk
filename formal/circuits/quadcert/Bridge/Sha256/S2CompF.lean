/-- **The schedule recurrence for `W51`, over the deployed circuit.** -/
theorem sched51 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS51.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 51))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 36)))
          + SHA256.ofBits (bitsOf inputs (wordBits 44))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 49)))
          + SHA256.ofBits (bitsOf inputs (wordBits 35))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS51 inputs i = 0 ∨ lvS51 inputs i = 1 :=
    lvBits51 inputs hin0 hbz
  have hone : lvS51 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS51a (lvS51 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS51a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS51a (lvS51 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS51b (lvS51 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS51b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS51b (lvS51 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS51c (lvS51 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS51c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS51c (lvS51 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS51d (lvS51 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS51d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS51d (lvS51 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS51 (lvS51 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS51_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS51p (lvS51 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS51a (lvS51 inputs)) (gS51b (lvS51 inputs)) (gS51c (lvS51 inputs))
      (gS51d (lvS51 inputs)) (dsS51 (lvS51 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 3004)
      hma hmb hmc hmd hmp (by norm_num [gS51a]) (by norm_num [gS51b])
      (by norm_num [gS51c]) (by norm_num [gS51d]) (by norm_num [dsS51]) (by norm_num)
      (zval_S51 inputs hin0) (allWrap4 inputs hin0 hroot 35 (by norm_num))
  rw [gS51a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS51a (lvS51 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS51a (lvS51 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS51b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS51b (lvS51 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS51b (lvS51 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS51c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS51c (lvS51 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS51c (lvS51 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS51d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS51d (lvS51 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS51d (lvS51 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS51_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS51p (lvS51 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS51p (lvS51 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 36))) := by
    rw [hvA, ← bwS51a_eq, SHA256.sigma0_bits (bwS51a inputs) (by rfl)
      (fun b hb => by rw [bwS51a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS51a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 49))) := by
    rw [hvC, ← bwS51c_eq, SHA256.sigma1_bits (bwS51c inputs) (by rfl)
      (fun b hb => by rw [bwS51c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS51c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 44)) := by
    rw [hvB, ← bwS51b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 35)) := by
    rw [hvD, ← bwS51d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 51)) := by
    rw [hvP, ← bwS51p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

end Sha256Blk
