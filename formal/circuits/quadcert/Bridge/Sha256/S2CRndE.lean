      stateWord inputs 34 3 + (stateWord inputs 34 7 + SHA256.Sigma1 (stateWord inputs 34 4)
        + SHA256.Ch (stateWord inputs 34 4) (stateWord inputs 34 5) (stateWord inputs 34 6)
        + SHA256.K.getD 34 0 + wWord inputs 34)) := by
