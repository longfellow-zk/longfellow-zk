    rw [hvC, SHA256.Sigma1_bits (bwR6_33oute32 inputs) (by rfl)
      (fun q hq => by rw [bwR6_33oute32_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_33c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
