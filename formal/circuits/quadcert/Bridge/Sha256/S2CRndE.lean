    SHA256F.wrap_six_words (p := p256w) (gR6_33a (lvR6_33 inputs)) (gR6_33b (lvR6_33 inputs)) (gR6_33c (lvR6_33 inputs)) (gR6_33d (lvR6_33 inputs)) (gR6_33e (lvR6_33 inputs))
      (dsR6_33 (lvR6_33 inputs)) 773529912 (interpDag (raw.toDag (cnstw F)) inputs 6395)
      hma hmb hmc hmd hme hmp
