    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbR6_33d (lvR6_33 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [gR6_33e_eq] at hE
  have hvE : E = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_33e (lvR6_33 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 E
      (fun i hi => vbR6_33e (lvR6_33 inputs) hone c0 c1 hlv i hi) hE
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsR6_33_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vR6_33p (lvR6_33 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbR6_33p (lvR6_33 inputs) hone c0 c1 hlv i hi) hP
