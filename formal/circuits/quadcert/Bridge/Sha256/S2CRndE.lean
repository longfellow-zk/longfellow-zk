      (fun q hq => by rw [bwR6_36oute34_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      (fun q hq => by rw [bwR6_36oute33_eq] at hq; exact bitsOf_isBit inputs _ q hq)
      ]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_36d inputs hlv i (List.mem_range.mp hi)
  have heE : E = SHA256.ofBits (bwR6_36outw20 inputs) := by rw [hvE]; rfl
