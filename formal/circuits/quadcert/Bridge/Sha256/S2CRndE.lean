/-- **Round 37, `n = 6`: the compression step over the deployed circuit.** -/
theorem rndR6_37 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_37.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf6 k) = 0) :
    stateWord inputs 38 4 = SHA256.w32 (
      stateWord inputs 37 3 + (stateWord inputs 37 7 + SHA256.Sigma1 (stateWord inputs 37 4)
        + SHA256.Ch (stateWord inputs 37 4) (stateWord inputs 37 5) (stateWord inputs 37 6)
        + SHA256.K.getD 37 0 + wWord inputs 37)) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 225 → lvR6_37 inputs i = 0 ∨ lvR6_37 inputs i = 1 :=
    lvBitsR6_37 inputs hin0 hbz
  have hone : lvR6_37 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
