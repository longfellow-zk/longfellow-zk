  have heB : B = SHA256.ofBits (bwR6_36oute32 inputs) := by rw [hvB]; rfl
  have heC : C = SHA256.Sigma1 (SHA256.ofBits (bwR6_36oute35 inputs)) := by
    rw [hvC, SHA256.Sigma1_bits (bwR6_36oute35 inputs) (by rfl)
      (fun q hq => by rw [bwR6_36oute35_eq] at hq; exact bitsOf_isBit inputs _ q hq)]
    refine congrArg SHA256.ofBits (List.map_congr_left ?_)
    intro i hi
    exact nbR6_36c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
