/-- Booleanity of every template leaf, index `0` (the constant one) included. -/
theorem lvBitsR6_31 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 224 → interpDag (raw.toDag (cnstw F)) inputs (bpR6_31.getD j (0, 0)).1 = 0) :
