/-- **The schedule recurrence for `W53`, over the deployed circuit.** -/
theorem sched53 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS53.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 53))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 38)))
          + SHA256.ofBits (bitsOf inputs (wordBits 46))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 51)))
          + SHA256.ofBits (bitsOf inputs (wordBits 37))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS53 inputs i = 0 ∨ lvS53 inputs i = 1 :=
    lvBits53 inputs hin0 hbz
  have hone : lvS53 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS53a (lvS53 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS53a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS53a (lvS53 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS53b (lvS53 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS53b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS53b (lvS53 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS53c (lvS53 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS53c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS53c (lvS53 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS53d (lvS53 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS53d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS53d (lvS53 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS53 (lvS53 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS53_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS53p (lvS53 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS53a (lvS53 inputs)) (gS53b (lvS53 inputs)) (gS53c (lvS53 inputs))
      (gS53d (lvS53 inputs)) (dsS53 (lvS53 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 20083)
      hma hmb hmc hmd hmp (by norm_num [gS53a]) (by norm_num [gS53b])
      (by norm_num [gS53c]) (by norm_num [gS53d]) (by norm_num [dsS53]) (by norm_num)
      (zval_S53 inputs hin0) (allWrap4 inputs hin0 hroot 37 (by norm_num))
  rw [gS53a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS53a (lvS53 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS53a (lvS53 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS53b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS53b (lvS53 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS53b (lvS53 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS53c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS53c (lvS53 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS53c (lvS53 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS53d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS53d (lvS53 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS53d (lvS53 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS53_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS53p (lvS53 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS53p (lvS53 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 38))) := by
    rw [hvA, ← bwS53a_eq, SHA256.sigma0_bits (bwS53a inputs) (by rfl)
      (fun b hb => by rw [bwS53a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS53a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 51))) := by
    rw [hvC, ← bwS53c_eq, SHA256.sigma1_bits (bwS53c inputs) (by rfl)
      (fun b hb => by rw [bwS53c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS53c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 46)) := by
    rw [hvB, ← bwS53b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 37)) := by
    rw [hvD, ← bwS53d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 53)) := by
    rw [hvP, ← bwS53p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

