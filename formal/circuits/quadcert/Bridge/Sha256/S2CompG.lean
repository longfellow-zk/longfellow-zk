/-- **The schedule recurrence for `W52`, over the deployed circuit.** -/
theorem sched52 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS52.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 52))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 37)))
          + SHA256.ofBits (bitsOf inputs (wordBits 45))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 50)))
          + SHA256.ofBits (bitsOf inputs (wordBits 36))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS52 inputs i = 0 ∨ lvS52 inputs i = 1 :=
    lvBits52 inputs hin0 hbz
  have hone : lvS52 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS52a (lvS52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS52a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS52a (lvS52 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS52b (lvS52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS52b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS52b (lvS52 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS52c (lvS52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS52c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS52c (lvS52 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS52d (lvS52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS52d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS52d (lvS52 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS52 (lvS52 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS52_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS52p (lvS52 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS52a (lvS52 inputs)) (gS52b (lvS52 inputs)) (gS52c (lvS52 inputs))
      (gS52d (lvS52 inputs)) (dsS52 (lvS52 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 16982)
      hma hmb hmc hmd hmp (by norm_num [gS52a]) (by norm_num [gS52b])
      (by norm_num [gS52c]) (by norm_num [gS52d]) (by norm_num [dsS52]) (by norm_num)
      (zval_S52 inputs hin0) (allWrap4 inputs hin0 hroot 36 (by norm_num))
  rw [gS52a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS52a (lvS52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS52a (lvS52 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS52b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS52b (lvS52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS52b (lvS52 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS52c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS52c (lvS52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS52c (lvS52 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS52d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS52d (lvS52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS52d (lvS52 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS52_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS52p (lvS52 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS52p (lvS52 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 37))) := by
    rw [hvA, ← bwS52a_eq, SHA256.sigma0_bits (bwS52a inputs) (by rfl)
      (fun b hb => by rw [bwS52a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS52a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 50))) := by
    rw [hvC, ← bwS52c_eq, SHA256.sigma1_bits (bwS52c inputs) (by rfl)
      (fun b hb => by rw [bwS52c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS52c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 45)) := by
    rw [hvB, ← bwS52b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 36)) := by
    rw [hvD, ← bwS52d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 52)) := by
    rw [hvP, ← bwS52p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

/-! #### Composition for `W53` -/

/-- The cone's leaf valuation. -/
noncomputable def lvS53 (inputs : Nat → F) : Nat → F :=
  fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS53.getD h 0)

noncomputable def vS53a (lv : Nat → F) : Nat → F
  | 0 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS53 260) (lv 29)
  | 1 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS53 216) (lv 28)
