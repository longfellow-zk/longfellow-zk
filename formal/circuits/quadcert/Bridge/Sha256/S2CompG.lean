/-- **The schedule recurrence for `W57`, over the deployed circuit.** -/
theorem sched57 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS57.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 57))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 42)))
          + SHA256.ofBits (bitsOf inputs (wordBits 50))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 55)))
          + SHA256.ofBits (bitsOf inputs (wordBits 41))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS57 inputs i = 0 ∨ lvS57 inputs i = 1 :=
    lvBits57 inputs hin0 hbz
  have hone : lvS57 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS57a (lvS57 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS57a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS57a (lvS57 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS57b (lvS57 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS57b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS57b (lvS57 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS57c (lvS57 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS57c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS57c (lvS57 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS57d (lvS57 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS57d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS57d (lvS57 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS57 (lvS57 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS57_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS57p (lvS57 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS57a (lvS57 inputs)) (gS57b (lvS57 inputs)) (gS57c (lvS57 inputs))
      (gS57d (lvS57 inputs)) (dsS57 (lvS57 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 6257)
      hma hmb hmc hmd hmp (by norm_num [gS57a]) (by norm_num [gS57b])
      (by norm_num [gS57c]) (by norm_num [gS57d]) (by norm_num [dsS57]) (by norm_num)
      (zval_S57 inputs hin0) (allWrap4 inputs hin0 hroot 41 (by norm_num))
  rw [gS57a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS57a (lvS57 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS57a (lvS57 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS57b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS57b (lvS57 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS57b (lvS57 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS57c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS57c (lvS57 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS57c (lvS57 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS57d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS57d (lvS57 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS57d (lvS57 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS57_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS57p (lvS57 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS57p (lvS57 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 42))) := by
    rw [hvA, ← bwS57a_eq, SHA256.sigma0_bits (bwS57a inputs) (by rfl)
      (fun b hb => by rw [bwS57a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS57a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 55))) := by
    rw [hvC, ← bwS57c_eq, SHA256.sigma1_bits (bwS57c inputs) (by rfl)
      (fun b hb => by rw [bwS57c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS57c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 50)) := by
    rw [hvB, ← bwS57b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 41)) := by
    rw [hvD, ← bwS57d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 57)) := by
    rw [hvP, ← bwS57p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

end Sha256Blk
