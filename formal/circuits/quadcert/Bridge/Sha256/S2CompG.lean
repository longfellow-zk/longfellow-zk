/-- **The schedule recurrence for `W55`, over the deployed circuit.** -/
theorem sched55 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS55.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 55))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 40)))
          + SHA256.ofBits (bitsOf inputs (wordBits 48))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 53)))
          + SHA256.ofBits (bitsOf inputs (wordBits 39))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS55 inputs i = 0 ∨ lvS55 inputs i = 1 :=
    lvBits55 inputs hin0 hbz
  have hone : lvS55 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS55a (lvS55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS55a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS55a (lvS55 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS55b (lvS55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS55b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS55b (lvS55 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS55c (lvS55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS55c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS55c (lvS55 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS55d (lvS55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS55d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS55d (lvS55 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS55 (lvS55 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS55_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS55p (lvS55 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS55a (lvS55 inputs)) (gS55b (lvS55 inputs)) (gS55c (lvS55 inputs))
      (gS55d (lvS55 inputs)) (dsS55 (lvS55 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 25522)
      hma hmb hmc hmd hmp (by norm_num [gS55a]) (by norm_num [gS55b])
      (by norm_num [gS55c]) (by norm_num [gS55d]) (by norm_num [dsS55]) (by norm_num)
      (zval_S55 inputs hin0) (allWrap4 inputs hin0 hroot 39 (by norm_num))
  rw [gS55a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS55a (lvS55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS55a (lvS55 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS55b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS55b (lvS55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS55b (lvS55 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS55c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS55c (lvS55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS55c (lvS55 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS55d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS55d (lvS55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS55d (lvS55 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS55_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS55p (lvS55 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS55p (lvS55 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 40))) := by
    rw [hvA, ← bwS55a_eq, SHA256.sigma0_bits (bwS55a inputs) (by rfl)
      (fun b hb => by rw [bwS55a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS55a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 53))) := by
    rw [hvC, ← bwS55c_eq, SHA256.sigma1_bits (bwS55c inputs) (by rfl)
      (fun b hb => by rw [bwS55c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS55c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 48)) := by
    rw [hvB, ← bwS55b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 39)) := by
    rw [hvD, ← bwS55d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 55)) := by
    rw [hvP, ← bwS55p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

