/-- **The schedule recurrence for `W56`, over the deployed circuit.** -/
theorem sched56 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS56.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 56))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 41)))
          + SHA256.ofBits (bitsOf inputs (wordBits 49))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 54)))
          + SHA256.ofBits (bitsOf inputs (wordBits 40))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS56 inputs i = 0 ∨ lvS56 inputs i = 1 :=
    lvBits56 inputs hin0 hbz
  have hone : lvS56 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS56a (lvS56 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS56a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS56a (lvS56 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS56b (lvS56 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS56b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS56b (lvS56 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS56c (lvS56 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS56c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS56c (lvS56 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS56d (lvS56 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS56d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS56d (lvS56 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS56 (lvS56 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS56_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS56p (lvS56 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS56a (lvS56 inputs)) (gS56b (lvS56 inputs)) (gS56c (lvS56 inputs))
      (gS56d (lvS56 inputs)) (dsS56 (lvS56 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 11969)
      hma hmb hmc hmd hmp (by norm_num [gS56a]) (by norm_num [gS56b])
      (by norm_num [gS56c]) (by norm_num [gS56d]) (by norm_num [dsS56]) (by norm_num)
      (zval_S56 inputs hin0) (allWrap4 inputs hin0 hroot 40 (by norm_num))
  rw [gS56a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS56a (lvS56 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS56a (lvS56 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS56b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS56b (lvS56 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS56b (lvS56 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS56c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS56c (lvS56 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS56c (lvS56 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS56d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS56d (lvS56 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS56d (lvS56 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS56_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS56p (lvS56 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS56p (lvS56 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 41))) := by
    rw [hvA, ← bwS56a_eq, SHA256.sigma0_bits (bwS56a inputs) (by rfl)
      (fun b hb => by rw [bwS56a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS56a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 54))) := by
    rw [hvC, ← bwS56c_eq, SHA256.sigma1_bits (bwS56c inputs) (by rfl)
      (fun b hb => by rw [bwS56c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS56c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 49)) := by
    rw [hvB, ← bwS56b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 40)) := by
    rw [hvD, ← bwS56d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 56)) := by
    rw [hvP, ← bwS56p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

