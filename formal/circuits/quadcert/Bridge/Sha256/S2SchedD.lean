/-- Booleanity of the 160 input leaves, by index. -/
theorem leafBits37 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS37.getD j (0, 0)).1 = 0) :
