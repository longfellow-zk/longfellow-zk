theorem coneS38 : coneIs nodeFn tnS38 (fun i => mpS38.getD i 0) = true := by decide +kernel

theorem mapS38_lt : ∀ i, i < tnS38.length → mpS38.getD i 0 < raw.nodes.length := by
  intro i hi
  have hlen : tnS38.length = 266 := by rfl
  rw [hlen] at hi
  rw [nodes_len]
  have hb : (List.range 266).all (fun j => decide (mpS38.getD j 0 < 37139)) = true := by
    decide +kernel
  simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at hb
  exact hb i hi

/-- **The regrouping, of the circuit.** `tmpl_zS38` transported along the cone match: the
    assertion's `z` wire really is `σ₀(W23) + W31 + σ₁(W36) + W22` minus `W38`,
    as bit-linear forms over the circuit's own wires. -/
theorem zval_S38 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1) :
    interpDag (raw.toDag (cnstw F)) inputs 27043
      = (((gS38a (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS38.getD h 0)) ++ gS38b (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS38.getD h 0)) ++ gS38c (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS38.getD h 0)) ++ gS38d (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS38.getD h 0)))).map
          (fun q => (q.1 : F) * q.2)).sum
        - ((dsS38 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS38.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have htr := coneIs_transfer raw (cnstw F) inputs nodeFn nodefn_ok tnS38
    (fun i => mpS38.getD i 0) coneS38 mapS38_lt 265 (by decide)
  have hone : (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS38.getD h 0)) 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  show interpDag (raw.toDag (cnstw F)) inputs (mpS38.getD 265 0) = _
  rw [htr, tmpl_zS38 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS38.getD h 0)) hone]

