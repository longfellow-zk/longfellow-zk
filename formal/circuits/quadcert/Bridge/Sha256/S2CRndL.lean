  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 289 → lvR7_25 inputs i = 0 ∨ lvR7_25 inputs i = 1 :=
    lvBitsR7_25 inputs hin0 hbz
