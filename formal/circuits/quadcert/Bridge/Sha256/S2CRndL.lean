/-- **Round 25, `n = 7`: the compression step over the deployed circuit.** -/
theorem rndR7_25 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 288 → interpDag (raw.toDag (cnstw F)) inputs (bpR7_25.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf7 k) = 0) :
    stateWord inputs 26 0 = SHA256.w32 (
      stateWord inputs 25 7 + SHA256.Sigma1 (stateWord inputs 25 4)
        + SHA256.Ch (stateWord inputs 25 4) (stateWord inputs 25 5) (stateWord inputs 25 6)
        + SHA256.K.getD 25 0 + wWord inputs 25
