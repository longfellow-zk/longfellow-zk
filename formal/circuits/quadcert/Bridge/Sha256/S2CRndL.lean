/-- **Round 26, `n = 7`: the compression step over the deployed circuit.** -/
theorem rndR7_26 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 288 → interpDag (raw.toDag (cnstw F)) inputs (bpR7_26.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf7 k) = 0) :
    stateWord inputs 27 0 = SHA256.w32 (
      stateWord inputs 26 7 + SHA256.Sigma1 (stateWord inputs 26 4)
        + SHA256.Ch (stateWord inputs 26 4) (stateWord inputs 26 5) (stateWord inputs 26 6)
        + SHA256.K.getD 26 0 + wWord inputs 26
        + (SHA256.Sigma0 (stateWord inputs 26 0) + SHA256.Maj (stateWord inputs 26 0) (stateWord inputs 26 1) (stateWord inputs 26 2))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 289 → lvR7_26 inputs i = 0 ∨ lvR7_26 inputs i = 1 :=
    lvBitsR7_26 inputs hin0 hbz
  have hone : lvR7_26 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have hh := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
