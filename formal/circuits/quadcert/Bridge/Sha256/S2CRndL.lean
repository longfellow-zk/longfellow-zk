    ∀ j, j < 32 → SHA256F.natBit (vR7_24c (lvR7_24 inputs) j)
      = SHA256.chb ((bwR7_24oute23 inputs).getD j 0) ((bwR7_24oute22 inputs).getD j 0)
          ((bwR7_24oute21 inputs).getD j 0) := by
  intro j hj
  match j, hj with
