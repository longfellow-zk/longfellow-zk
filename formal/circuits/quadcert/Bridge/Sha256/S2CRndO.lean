/-- **Round 49, `n = 7`: the compression step over the deployed circuit.** -/
theorem rndR7_49 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 288 → interpDag (raw.toDag (cnstw F)) inputs (bpR7_49.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 64 → interpDag (raw.toDag (cnstw F)) inputs (rootOf7 k) = 0) :
    stateWord inputs 50 0 = SHA256.w32 (
      stateWord inputs 49 7 + SHA256.Sigma1 (stateWord inputs 49 4)
        + SHA256.Ch (stateWord inputs 49 4) (stateWord inputs 49 5) (stateWord inputs 49 6)
