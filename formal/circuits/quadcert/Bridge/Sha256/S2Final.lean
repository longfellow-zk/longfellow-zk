    show interpDag (raw.toDag (cnstw F)) inputs (mpF3.getD 97 0) = _
    rw [htr, tmplZF3 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF3.getD h 0)) hone]
  exact SHA256F.wrap_two_words' _ _ _ _ (bitsA3 inputs hin0 hbz) (bitsB3 inputs hin0 hbz)
