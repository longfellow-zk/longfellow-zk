      ((csA5 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF5.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum = (A : F) ∧
      ((csB5 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF5.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum = (B : F) ∧
      ((dsF5 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF5.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum = (P : F) ∧
