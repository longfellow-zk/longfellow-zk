/-- **Instance 4, end to end.** -/
theorem final4 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 96 → interpDag (raw.toDag (cnstw F)) inputs (bpF4.getD j (0, 0)).1 = 0)
    (hwrap : SHA256F.wrapPoly 2 ((2 ^ 32 : Nat) : F)
      (interpDag (raw.toDag (cnstw F)) inputs 30865) = 0) :
    ∃ A B P : Nat,
      ((csA4 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF4.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum = (A : F) ∧
      ((csB4 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF4.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum = (B : F) ∧
      ((dsF4 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF4.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum = (P : F) ∧
      A < 2 ^ 32 ∧ B < 2 ^ 32 ∧ P < 2 ^ 32 ∧
      P = SHA256.w32 (A + B) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hcone : coneIs nodeFn tnF4 (fun j => mpF4.getD j 0) = true := by decide +kernel
  have hmap : ∀ j, j < tnF4.length → mpF4.getD j 0 < raw.nodes.length := by
    intro j hj
    have h98 : tnF4.length = 98 := by rfl
    rw [h98] at hj
    rw [nodes_len]
    have hb : (List.range 98).all (fun t => decide (mpF4.getD t 0 < 37139)) = true := by
      decide +kernel
    simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at hb
    exact hb j hj
  have htr := coneIs_transfer raw (cnstw F) inputs nodeFn nodefn_ok tnF4
    (fun j => mpF4.getD j 0) hcone hmap 97 (by decide)
  have hone : (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF4.getD h 0)) 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have hzval : interpDag (raw.toDag (cnstw F)) inputs 30865
      = (((csA4 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF4.getD h 0)) ++ csB4 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF4.getD h 0)))).map (fun q => (q.1 : F) * q.2)).sum
        - ((dsF4 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF4.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum := by
    show interpDag (raw.toDag (cnstw F)) inputs (mpF4.getD 97 0) = _
    rw [htr, tmplZF4 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF4.getD h 0)) hone]
  exact SHA256F.wrap_two_words' _ _ _ _ (bitsA4 inputs hin0 hbz) (bitsB4 inputs hin0 hbz)
    (bitsD4 inputs hin0 hbz) (by simp [csA4]) (by simp [csB4]) (by simp [dsF4])
    (by norm_num) hzval hwrap

