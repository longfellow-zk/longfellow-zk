/-- **All eight final assertions.** For each output word `i`, the outgoing chaining word is
    the incoming one plus the round-64 word, modulo `2 ^ 32` -- which is `SHA/Sound.lean`'s
    `hout` with `h i := A`, `s 64 i := B` and `out i := P`.

    The three linear forms are the circuit's own: `csA` over the `h0_{i}` input bits, `csB` over
    the round-64 output bits, `dsF` over the `h1_{i}` bits. Cast injectivity below the
    characteristic is what lets the assembly identify `B` here with the `a`/`e` words the round
    bridges produce. -/
theorem final_words [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbool : ∀ i, i < 8 → ∀ j, j < 96 →
      interpDag (raw.toDag (cnstw F)) inputs ((bpAt i).getD j (0, 0)).1 = 0)
    (hroot : ∀ e, e < 8 → interpDag (raw.toDag (cnstw F)) inputs (rootOfW e) = 0) :
    ∀ i, i < 8 → ∃ A B P : Nat,
      ((csAAt i (fun h => interpDag (raw.toDag (cnstw F)) inputs ((mpAt i).getD h 0))).map
        (fun q => (q.1 : F) * q.2)).sum = (A : F) ∧
      ((csBAt i (fun h => interpDag (raw.toDag (cnstw F)) inputs ((mpAt i).getD h 0))).map
        (fun q => (q.1 : F) * q.2)).sum = (B : F) ∧
      ((dsFAt i (fun h => interpDag (raw.toDag (cnstw F)) inputs ((mpAt i).getD h 0))).map
        (fun q => (q.1 : F) * q.2)).sum = (P : F) ∧
      A < 2 ^ 32 ∧ B < 2 ^ 32 ∧ P < 2 ^ 32 ∧
      P = SHA256.w32 (A + B) := by
  have hw := allWrap2 inputs hin0 hroot
  intro i hi
  match i, hi with

  | 0, _ => exact final0 inputs hin0 (hbool 0 (by norm_num)) (hw 0 (by norm_num))
  | 1, _ => exact final1 inputs hin0 (hbool 1 (by norm_num)) (hw 1 (by norm_num))
  | 2, _ => exact final2 inputs hin0 (hbool 2 (by norm_num)) (hw 2 (by norm_num))
  | 3, _ => exact final3 inputs hin0 (hbool 3 (by norm_num)) (hw 3 (by norm_num))
  | 4, _ => exact final4 inputs hin0 (hbool 4 (by norm_num)) (hw 4 (by norm_num))
  | 5, _ => exact final5 inputs hin0 (hbool 5 (by norm_num)) (hw 5 (by norm_num))
  | 6, _ => exact final6 inputs hin0 (hbool 6 (by norm_num)) (hw 6 (by norm_num))
  | 7, _ => exact final7 inputs hin0 (hbool 7 (by norm_num)) (hw 7 (by norm_num))

end Sha256Blk
