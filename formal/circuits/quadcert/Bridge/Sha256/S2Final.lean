    ∃ A B P : Nat,
      ((csA6 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF6.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum = (A : F) ∧
      ((csB6 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF6.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum = (B : F) ∧
      ((dsF6 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF6.getD h 0))).map (fun q => (q.1 : F) * q.2)).sum = (P : F) ∧
      A < 2 ^ 32 ∧ B < 2 ^ 32 ∧ P < 2 ^ 32 ∧
      P = SHA256.w32 (A + B) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hcone : coneIs nodeFn tnF6 (fun j => mpF6.getD j 0) = true := by decide +kernel
