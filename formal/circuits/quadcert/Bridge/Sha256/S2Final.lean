/-- Booleanity for all 96 bits of instance 0, by index. -/
theorem bitsIdx0 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 96 → interpDag (raw.toDag (cnstw F)) inputs (bpF0.getD j (0, 0)).1 = 0) :
    ∀ j, j < 96 → interpDag (raw.toDag (cnstw F)) inputs (bpF0.getD j (0, 0)).2 = 0
      ∨ interpDag (raw.toDag (cnstw F)) inputs (bpF0.getD j (0, 0)).2 = 1 := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hone : interpDag (raw.toDag (cnstw F)) inputs 0 = 1 := by
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have hc2 : cnstw F 2 = -1 := by
    show ((constNat 2 : Nat) : F) = -1
    have h : constNat 2 = p256w - 1 := by rfl
    rw [h, Quadcert.cast_sub_eq_neg p256w 1 (by norm_num), Nat.cast_one]
  have hshape : bpF0.all
      (fun p => nodeEq (nodeFn p.1) (.sum [(0, 0, p.2), (2, p.2, p.2)])) = true := by
    decide +kernel
  have hltc : bpF0.all
      (fun p => decide (p.2 < p.1) && decide (p.1 < raw.nodes.length)) = true := by
    rw [nodes_len]; decide +kernel
  have hlen : bpF0.length = 96 := by rfl
  exact bits_of_boolNodes_idx raw (cnstw F) inputs nodeFn nodefn_ok cnstw_0 hc2 hone bpF0
    hshape hltc (fun j hj => hbz j (by rw [hlen] at hj; exact hj))

theorem bitsA0 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 96 → interpDag (raw.toDag (cnstw F)) inputs (bpF0.getD j (0, 0)).1 = 0) :
    ∀ q ∈ csA0 (fun h => interpDag (raw.toDag (cnstw F)) inputs (mpF0.getD h 0)), q.2 = 0 ∨ q.2 = 1 := by
  have hb := bitsIdx0 inputs hin0 hbz
