/-- Edge `e`, template index `i`: 0 is the constant-1 input, 1 the bit, 2 the assertion. -/
def mapOfB : Nat → Nat → Nat := fun e i =>
  if i < 1 then 0 else if i < 2 then bitOfB e else assertOfB e

theorem ec0 : edgesMatchAt nodeFn tnBool mapOfB 0 512 = true := by decide +kernel

theorem ec1 : edgesMatchAt nodeFn tnBool mapOfB 512 512 = true := by decide +kernel

theorem ec2 : edgesMatchAt nodeFn tnBool mapOfB 1024 512 = true := by decide +kernel

