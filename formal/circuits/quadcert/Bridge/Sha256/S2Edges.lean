/-- The 13 slices tile `[0, 6656)`, so they compose into the full edge list. -/
theorem allBoolEdges : edgesMatch nodeFn tnBool mapOfB 6656 = true := by
  -- hoisted: inside `refine` this elaborates against metavariables and blows the interpreter
  have ht : tiles [(0, 512), (512, 512), (1024, 512), (1536, 512), (2048, 512), (2560, 512), (3072, 512), (3584, 512), (4096, 512), (4608, 512), (5120, 512), (5632, 512), (6144, 512)] 0 6656 = true := by decide +kernel
  refine edgesMatch_of_chunks nodeFn tnBool mapOfB [(0, 512), (512, 512), (1024, 512), (1536, 512), (2048, 512), (2560, 512), (3072, 512), (3584, 512), (4096, 512), (4608, 512), (5120, 512), (5632, 512), (6144, 512)] 6656 ht ?_
  intro c hc
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
  · show edgesMatchAt nodeFn tnBool mapOfB 0 512 = true
    exact ec0
  · show edgesMatchAt nodeFn tnBool mapOfB 512 512 = true
    exact ec1
  · show edgesMatchAt nodeFn tnBool mapOfB 1024 512 = true
    exact ec2
  · show edgesMatchAt nodeFn tnBool mapOfB 1536 512 = true
    exact ec3
  · show edgesMatchAt nodeFn tnBool mapOfB 2048 512 = true
    exact ec4
  · show edgesMatchAt nodeFn tnBool mapOfB 2560 512 = true
    exact ec5
  · show edgesMatchAt nodeFn tnBool mapOfB 3072 512 = true
    exact ec6
  · show edgesMatchAt nodeFn tnBool mapOfB 3584 512 = true
    exact ec7
  · show edgesMatchAt nodeFn tnBool mapOfB 4096 512 = true
    exact ec8
  · show edgesMatchAt nodeFn tnBool mapOfB 4608 512 = true
    exact ec9
  · show edgesMatchAt nodeFn tnBool mapOfB 5120 512 = true
    exact ec10
  · show edgesMatchAt nodeFn tnBool mapOfB 5632 512 = true
    exact ec11
  · show edgesMatchAt nodeFn tnBool mapOfB 6144 512 = true
    exact ec12

variable {F : Type} [Field F]

/-! Two flat `decide`s, not one nested over `range 6656 x range 3`. The nested form aborts at the
16 GB cap even though `allBoolEdges` -- which evaluates `mapOfB` five times as often -- does not. -/

theorem bitOfB_lt : (List.range 6656).all (fun e => decide (bitOfB e < 37139)) = true := by
  decide +kernel

theorem assertOfB_lt : (List.range 6656).all (fun e => decide (assertOfB e < 37139)) = true := by
  decide +kernel

/-- Every mapped node is real. -/
theorem mapOfB_lt : ∀ e, e < 6656 → ∀ i, i < tnBool.length → mapOfB e i < raw.nodes.length := by
  have hb : ∀ e, e < 6656 → bitOfB e < 37139 := by
    have h := bitOfB_lt
    simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
    exact h
  have ha : ∀ e, e < 6656 → assertOfB e < 37139 := by
    have h := assertOfB_lt
    simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
    exact h
  intro e he i hi
  rw [nodes_len]
  unfold mapOfB
  by_cases h1 : i < 1
  · simp only [h1, if_pos]; norm_num
  · by_cases h2 : i < 2
    · simp only [h1, h2, if_neg, if_pos, if_true, if_false]
      exact hb e he
    · simp only [h1, h2, if_neg, if_false]
      exact ha e he

/-- **Booleanity of every bit in the circuit, from one edge list.** 6,656 instances, one
    structural `decide` (`allBoolEdges`) and one template lemma (`tmpl_isBool`). -/
theorem allBoolBits [CharP F p256] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hz : ∀ e, e < 6656 → interpDag (raw.toDag (cnst F)) inputs (assertOfB e) = 0) :
    ∀ e, e < 6656 →
      interpDag (raw.toDag (cnst F)) inputs (bitOfB e) = 0
        ∨ interpDag (raw.toDag (cnst F)) inputs (bitOfB e) = 1 := by
  intro e he
  have htr := edges_transfer raw (cnst F) inputs nodeFn nodefn_ok tnBool mapOfB 6656
    allBoolEdges mapOfB_lt e he
  have hone : (fun h => interpDag (raw.toDag (cnst F)) inputs (mapOfB e h)) 0 = 1 := by
    show interpDag (raw.toDag (cnst F)) inputs 0 = 1
    have hdl : (raw.toDag (cnst F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
    rw [interpDag_input (raw.toDag (cnst F)) inputs 0 0
      (by rw [hdl, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnst F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have hroot : interpDag (tmplDag (cnst F) tnBool)
      (fun h => interpDag (raw.toDag (cnst F)) inputs (mapOfB e h)) 2 = 0 := by
    rw [← htr 2 (by decide)]
    show interpDag (raw.toDag (cnst F)) inputs (assertOfB e) = 0
    exact hz e he
  have hb := tmpl_isBool (cnst F)
    (fun h => interpDag (raw.toDag (cnst F)) inputs (mapOfB e h)) cnst_0 cnst_2 hone hroot
  show interpDag (raw.toDag (cnst F)) inputs (bitOfB e) = 0
    ∨ interpDag (raw.toDag (cnst F)) inputs (bitOfB e) = 1
  exact hb

end Sha256Blk
