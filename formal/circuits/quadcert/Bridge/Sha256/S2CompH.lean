/-- **The schedule recurrence for `W59`, over the deployed circuit.** -/
theorem sched59 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS59.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 59))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 44)))
          + SHA256.ofBits (bitsOf inputs (wordBits 52))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 57)))
          + SHA256.ofBits (bitsOf inputs (wordBits 43))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS59 inputs i = 0 ∨ lvS59 inputs i = 1 :=
    lvBits59 inputs hin0 hbz
  have hone : lvS59 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS59a (lvS59 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS59a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS59a (lvS59 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS59b (lvS59 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS59b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS59b (lvS59 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS59c (lvS59 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS59c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS59c (lvS59 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS59d (lvS59 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS59d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS59d (lvS59 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS59 (lvS59 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS59_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS59p (lvS59 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS59a (lvS59 inputs)) (gS59b (lvS59 inputs)) (gS59c (lvS59 inputs))
      (gS59d (lvS59 inputs)) (dsS59 (lvS59 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 35381)
      hma hmb hmc hmd hmp (by norm_num [gS59a]) (by norm_num [gS59b])
      (by norm_num [gS59c]) (by norm_num [gS59d]) (by norm_num [dsS59]) (by norm_num)
      (zval_S59 inputs hin0) (allWrap4 inputs hin0 hroot 43 (by norm_num))
  rw [gS59a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS59a (lvS59 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS59a (lvS59 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS59b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS59b (lvS59 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS59b (lvS59 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS59c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS59c (lvS59 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS59c (lvS59 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS59d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS59d (lvS59 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS59d (lvS59 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS59_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS59p (lvS59 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS59p (lvS59 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 44))) := by
    rw [hvA, ← bwS59a_eq, SHA256.sigma0_bits (bwS59a inputs) (by rfl)
      (fun b hb => by rw [bwS59a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS59a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 57))) := by
    rw [hvC, ← bwS59c_eq, SHA256.sigma1_bits (bwS59c inputs) (by rfl)
      (fun b hb => by rw [bwS59c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS59c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 52)) := by
    rw [hvB, ← bwS59b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 43)) := by
    rw [hvD, ← bwS59d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 59)) := by
    rw [hvP, ← bwS59p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

