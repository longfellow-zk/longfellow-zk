/-- **The schedule recurrence for `W58`, over the deployed circuit.** -/
theorem sched58 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS58.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 58))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 43)))
          + SHA256.ofBits (bitsOf inputs (wordBits 51))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 56)))
          + SHA256.ofBits (bitsOf inputs (wordBits 42))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS58 inputs i = 0 ∨ lvS58 inputs i = 1 :=
    lvBits58 inputs hin0 hbz
  have hone : lvS58 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS58a (lvS58 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS58a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS58a (lvS58 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS58b (lvS58 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS58b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS58b (lvS58 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS58c (lvS58 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS58c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS58c (lvS58 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS58d (lvS58 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS58d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS58d (lvS58 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS58 (lvS58 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS58_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS58p (lvS58 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS58a (lvS58 inputs)) (gS58b (lvS58 inputs)) (gS58c (lvS58 inputs))
      (gS58d (lvS58 inputs)) (dsS58 (lvS58 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 25408)
      hma hmb hmc hmd hmp (by norm_num [gS58a]) (by norm_num [gS58b])
      (by norm_num [gS58c]) (by norm_num [gS58d]) (by norm_num [dsS58]) (by norm_num)
      (zval_S58 inputs hin0) (allWrap4 inputs hin0 hroot 42 (by norm_num))
  rw [gS58a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS58a (lvS58 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS58a (lvS58 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS58b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS58b (lvS58 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS58b (lvS58 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS58c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS58c (lvS58 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS58c (lvS58 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS58d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS58d (lvS58 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS58d (lvS58 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS58_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS58p (lvS58 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS58p (lvS58 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 43))) := by
    rw [hvA, ← bwS58a_eq, SHA256.sigma0_bits (bwS58a inputs) (by rfl)
      (fun b hb => by rw [bwS58a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS58a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 56))) := by
    rw [hvC, ← bwS58c_eq, SHA256.sigma1_bits (bwS58c inputs) (by rfl)
      (fun b hb => by rw [bwS58c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS58c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 51)) := by
    rw [hvB, ← bwS58b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 42)) := by
    rw [hvD, ← bwS58d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 58)) := by
    rw [hvP, ← bwS58p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

/-! #### Composition for `W59` -/

/-- The cone's leaf valuation. -/
noncomputable def lvS59 (inputs : Nat → F) : Nat → F :=
  fun h => interpDag (raw.toDag (cnstw F)) inputs (mpS59.getD h 0)

noncomputable def vS59a (lv : Nat → F) : Nat → F
  | 0 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS59 260) (lv 27)
  | 1 => Quadcert.xorVal (midLeafVal (cnstw F) lv 161 mvS59 216) (lv 26)
