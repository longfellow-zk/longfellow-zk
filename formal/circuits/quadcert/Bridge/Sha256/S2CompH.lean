/-- **The schedule recurrence for `W60`, over the deployed circuit.** -/
theorem sched60 [CharP F p256w] (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbz : ∀ j, j < 160 → interpDag (raw.toDag (cnstw F)) inputs (bpS60.getD j (0, 0)).1 = 0)
    (hroot : ∀ k, k < 48 → interpDag (raw.toDag (cnstw F)) inputs (rootOfS k) = 0) :
    SHA256.ofBits (bitsOf inputs (wordBits 60))
      = SHA256.w32 (SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 45)))
          + SHA256.ofBits (bitsOf inputs (wordBits 53))
          + SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 58)))
          + SHA256.ofBits (bitsOf inputs (wordBits 44))) := by
  have hdaglen : (raw.toDag (cnstw F)).length = raw.nodes.length := by simp [RawCircuit.toDag]
  have hlv : ∀ i, i < 161 → lvS60 inputs i = 0 ∨ lvS60 inputs i = 1 :=
    lvBits60 inputs hin0 hbz
  have hone : lvS60 inputs 0 = 1 := by
    show interpDag (raw.toDag (cnstw F)) inputs 0 = 1
    rw [interpDag_input (raw.toDag (cnstw F)) inputs 0 0
      (by rw [hdaglen, nodes_len]; norm_num)
      (by rw [toDag_getD_fn raw (cnstw F) nodeFn nodefn_ok (by rw [nodes_len]; norm_num)]; rfl)]
    exact hin0
  have c0 : cnstw F 0 = 1 := cnstw_0
  have c1 : cnstw F 1 = -2 := by
    have h := cnstw_neg (F := F) 1 2 (by rfl) (by norm_num)
    simpa using h
  have h32 : (2 : Nat) ^ 32 = 4294967296 := by norm_num
  have hma : ∀ q ∈ gS60a (lvS60 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS60a_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS60a (lvS60 inputs) hone c0 c1 hlv i hi
  have hmb : ∀ q ∈ gS60b (lvS60 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS60b_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS60b (lvS60 inputs) hone c0 c1 hlv i hi
  have hmc : ∀ q ∈ gS60c (lvS60 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS60c_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS60c (lvS60 inputs) hone c0 c1 hlv i hi
  have hmd : ∀ q ∈ gS60d (lvS60 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [gS60d_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS60d (lvS60 inputs) hone c0 c1 hlv i hi
  have hmp : ∀ q ∈ dsS60 (lvS60 inputs), q.2 = 0 ∨ q.2 = 1 := by
    rw [dsS60_eq]
    intro q hq
    simp only [List.mem_map, List.mem_range] at hq
    obtain ⟨i, hi, rfl⟩ := hq
    exact vbS60p (lvS60 inputs) hone c0 c1 hlv i hi
  obtain ⟨A, B, C, D, P, hA, hB, hC, hD, hP, hAlt, hBlt, hClt, hDlt, hPlt, hres⟩ :=
    SHA256F.wrap_four_words (p := p256w) (gS60a (lvS60 inputs)) (gS60b (lvS60 inputs)) (gS60c (lvS60 inputs))
      (gS60d (lvS60 inputs)) (dsS60 (lvS60 inputs)) (interpDag (raw.toDag (cnstw F)) inputs 10942)
      hma hmb hmc hmd hmp (by norm_num [gS60a]) (by norm_num [gS60b])
      (by norm_num [gS60c]) (by norm_num [gS60d]) (by norm_num [dsS60]) (by norm_num)
      (zval_S60 inputs hin0) (allWrap4 inputs hin0 hroot 44 (by norm_num))
  rw [gS60a_eq] at hA
  have hvA : A = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS60a (lvS60 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 A
      (fun i hi => vbS60a (lvS60 inputs) hone c0 c1 hlv i hi) hA
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS60b_eq] at hB
  have hvB : B = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS60b (lvS60 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 B
      (fun i hi => vbS60b (lvS60 inputs) hone c0 c1 hlv i hi) hB
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS60c_eq] at hC
  have hvC : C = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS60c (lvS60 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 C
      (fun i hi => vbS60c (lvS60 inputs) hone c0 c1 hlv i hi) hC
      (by simp only [p256w]; omega) (by norm_num)
  rw [gS60d_eq] at hD
  have hvD : D = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS60d (lvS60 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 D
      (fun i hi => vbS60d (lvS60 inputs) hone c0 c1 hlv i hi) hD
      (by simp only [p256w]; omega) (by norm_num)
  rw [dsS60_eq] at hP
  have hvP : P = SHA256.ofBits ((List.range 32).map
      (fun i => SHA256F.natBit (vS60p (lvS60 inputs) i))) :=
    SHA256F.group_val_eq' (p := p256w) _ 32 P
      (fun i hi => vbS60p (lvS60 inputs) hone c0 c1 hlv i hi) hP
      (by simp only [p256w]; omega) (by norm_num)
  have hsA : A = SHA256.sigma0 (SHA256.ofBits (bitsOf inputs (wordBits 45))) := by
    rw [hvA, ← bwS60a_eq, SHA256.sigma0_bits (bwS60a inputs) (by rfl)
      (fun b hb => by rw [bwS60a_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS60a inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have hsC : C = SHA256.sigma1 (SHA256.ofBits (bitsOf inputs (wordBits 58))) := by
    rw [hvC, ← bwS60c_eq, SHA256.sigma1_bits (bwS60c inputs) (by rfl)
      (fun b hb => by rw [bwS60c_eq] at hb; exact bitsOf_isBit inputs _ b hb)]
    refine congrArg SHA256.ofBits ?_
    refine List.map_congr_left ?_
    intro i hi
    exact nbS60c inputs hone c0 c1 hlv i (List.mem_range.mp hi)
  have heB : B = SHA256.ofBits (bitsOf inputs (wordBits 53)) := by
    rw [hvB, ← bwS60b_eq]
    rfl
  have heD : D = SHA256.ofBits (bitsOf inputs (wordBits 44)) := by
    rw [hvD, ← bwS60d_eq]
    rfl
  have heP : P = SHA256.ofBits (bitsOf inputs (wordBits 60)) := by
    rw [hvP, ← bwS60p_eq]
    rfl
  rw [← heP, ← heB, ← heD, ← hsA, ← hsC]
  exact hres

