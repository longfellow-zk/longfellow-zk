/-- **Cone `16825`'s leaves are bits**, from the artifact's own `is_boolean` assertions. -/
theorem bl16825 (α : F) (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hz : ∀ e, e < 6656 → interpDag (raw.toDag (consts α)) inputs (assertOfB e) = 0) :
    ∀ i, i < 161 → i ≠ 0 →
      lvAt α inputs map16825 i = 0 ∨ lvAt α inputs map16825 i = 1 := by
  intro i hi hne
  have h := edge16825
  simp only [List.all_eq_true, List.mem_range, Bool.or_eq_true, beq_iff_eq,
    Bool.and_eq_true, decide_eq_true_eq] at h
  rcases h i hi with h0 | ⟨heq, hlt⟩
  · exact absurd h0 hne
  · have hb := allBoolBits α inputs hin0 hz (edgeOf16825 i) hlt
    rw [heq] at hb
    exact hb

