theorem bitOfB_lt : (List.range 6656).all (fun e => decide (bitOfB e < 58258)) = true := by
  decide +kernel

theorem assertOfB_lt : (List.range 6656).all (fun e => decide (assertOfB e < 58258))
    = true := by
  decide +kernel

/-- Every mapped node is real. -/
theorem mapOfB_lt : ∀ e, e < 6656 → ∀ i, i < tnBool.length → mapOfB e i < raw.nodes.length := by
  have hb : ∀ e, e < 6656 → bitOfB e < 58258 := by
    have h := bitOfB_lt
    simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
    exact h
  have ha : ∀ e, e < 6656 → assertOfB e < 58258 := by
    have h := assertOfB_lt
    simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
    exact h
  intro e he i hi
  rw [nodes_len]
  unfold mapOfB
  by_cases h1 : i < 1
  · simp only [h1, if_pos]; norm_num
  · by_cases h2 : i < 2
    · simp only [h1, h2, if_pos, if_false]
      exact hb e he
    · simp only [h1, h2, if_false]
      exact ha e he

