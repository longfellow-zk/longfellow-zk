/-! ## Sanity -/

section Sanity

/-- Every quantity is 32 bits wide. -/
theorem wordBits_length : (List.range 64).all (fun t => (wordBits t).length == 32) = true := by
  decide +kernel

theorem hinBits_length : (List.range 8).all (fun i => (hinBits i).length == 32) = true := by
  decide +kernel

theorem h1Bits_length : (List.range 8).all (fun i => (h1Bits i).length == 32) = true := by
  decide +kernel

theorem outaBits_length : (List.range 64).all (fun t => (outaBits t).length == 32) = true := by
  decide +kernel

theorem outeBits_length : (List.range 64).all (fun t => (outeBits t).length == 32) = true := by
  decide +kernel

/-- All 6,656 bit nodes across every family, gathered. -/
def allBits : List Nat :=
  ((List.range 64).flatMap wordBits) ++ ((List.range 8).flatMap hinBits)
    ++ ((List.range 8).flatMap h1Bits) ++ ((List.range 64).flatMap outaBits)
    ++ ((List.range 64).flatMap outeBits)

theorem allBits_length : allBits.length = 6656 := by decide +kernel

/-- A checksum over every node index, which a shifted or duplicated row would break. Cheap: one
    pass, where a global `List.eraseDups` would be about 22 million kernel comparisons. -/
theorem allBits_sum : allBits.sum = 88685843 := by decide +kernel

/-- **No aliasing within a word.** Each quantity's 32 bits are 32 distinct DAG nodes, so no word
    is secretly narrower than it looks.

    Aliasing *between* words is guaranteed upstream rather than here: `sha256_artifacts.rs` calls
    `layout.assert_covers(raw.ninput)`, which fails the generator if any input position went
    unnamed or was named twice, and `words_probe` panics if two DAG nodes claim one position. So
    position → node is a bijection before any of these lists is written. -/
theorem wordBits_nodup :
    (List.range 64).all (fun t => (wordBits t).eraseDups.length == 32) = true := by
  decide +kernel

theorem stateBits_nodup :
    (List.range 64).all (fun t =>
      ((outaBits t).eraseDups.length == 32) && ((outeBits t).eraseDups.length == 32)) = true := by
  decide +kernel

theorem hBits_nodup :
    (List.range 8).all (fun i =>
      ((hinBits i).eraseDups.length == 32) && ((h1Bits i).eraseDups.length == 32)) = true := by
  decide +kernel

end Sanity

end Sha256Gf2
