theorem bl12770 (α : F) (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hz : ∀ e, e < 6656 → interpDag (raw.toDag (consts α)) inputs (assertOfB e) = 0) :
    ∀ i, i < 161 → i ≠ 0 →
      lvAt α inputs map12770 i = 0 ∨ lvAt α inputs map12770 i = 1 := by
  intro i hi hne
