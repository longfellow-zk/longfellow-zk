/-- Which booleanity edge names each leaf. Leaf 0 is the `one` wire and has none. -/
def edgeOf26205 : Nat → Nat :=
  fun i => ([0, 6111, 6110, 6109, 6108, 6107, 6106, 6105, 6104, 6103, 6102, 6101, 6100, 6099, 6098, 6097, 6096, 6095, 6094, 6093, 6092, 6091, 6090, 6089, 6088, 6087, 6086, 6085, 6084, 6083, 6082, 6081, 6080] : List Nat).getD i 0

theorem edge26205 : (List.range 33).all (fun i =>
    (i == 0) || (decide (bitOfB (edgeOf26205 i) = map26205 i)
      && decide (edgeOf26205 i < 6656))) = true := by decide +kernel

/-- **Cone `26205`'s leaves are bits**, from the artifact's own `is_boolean` assertions. -/
theorem bl26205 (α : F) (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hz : ∀ e, e < 6656 → interpDag (raw.toDag (consts α)) inputs (assertOfB e) = 0) :
    ∀ i, i < 33 → i ≠ 0 →
      lvAt α inputs map26205 i = 0 ∨ lvAt α inputs map26205 i = 1 := by
  intro i hi hne
  have h := edge26205
  simp only [List.all_eq_true, List.mem_range, Bool.or_eq_true, beq_iff_eq,
    Bool.and_eq_true, decide_eq_true_eq] at h
  rcases h i hi with h0 | ⟨heq, hlt⟩
  · exact absurd h0 hne
  · have hb := allBoolBits α inputs hin0 hz (edgeOf26205 i) hlt
    rw [heq] at hb
    exact hb

/-- The bit each of cone `26205`'s rows injects, *defined* rather than assumed. -/
noncomputable def nOf26205 (α : F) (inputs : Nat → F) : Nat → Nat := fun j =>
  bitOf (((ts26205 j).map (fun t =>
    lvAt α inputs map26205 t.1 * lvAt α inputs map26205 t.2)).sum)

/-- **Cone `26205` as a power of α, with only leaf booleanity left.** -/
theorem injB26205 (α : F) (hgen : IsGen α) (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hbl : ∀ i, i < 33 → i ≠ 0 →
      lvAt α inputs map26205 i = 0 ∨ lvAt α inputs map26205 i = 1) :
    interpDag (raw.toDag (consts α)) inputs 26205
      = α ^ (2 ^ 0 * nOf26205 α inputs 64 + 2 ^ 1 * nOf26205 α inputs 63 + 2 ^ 2 * nOf26205 α inputs 61 + 2 ^ 3 * nOf26205 α inputs 60 + 2 ^ 4 * nOf26205 α inputs 57 + 2 ^ 5 * nOf26205 α inputs 56 + 2 ^ 6 * nOf26205 α inputs 54 + 2 ^ 7 * nOf26205 α inputs 53 + 2 ^ 8 * nOf26205 α inputs 49 + 2 ^ 9 * nOf26205 α inputs 48 + 2 ^ 10 * nOf26205 α inputs 46 + 2 ^ 11 * nOf26205 α inputs 45 + 2 ^ 12 * nOf26205 α inputs 42 + 2 ^ 13 * nOf26205 α inputs 41 + 2 ^ 14 * nOf26205 α inputs 39 + 2 ^ 15 * nOf26205 α inputs 38 + 2 ^ 16 * nOf26205 α inputs 33 + 2 ^ 17 * nOf26205 α inputs 32 + 2 ^ 18 * nOf26205 α inputs 30 + 2 ^ 19 * nOf26205 α inputs 29 + 2 ^ 20 * nOf26205 α inputs 26 + 2 ^ 21 * nOf26205 α inputs 25 + 2 ^ 22 * nOf26205 α inputs 23 + 2 ^ 23 * nOf26205 α inputs 22 + 2 ^ 24 * nOf26205 α inputs 18 + 2 ^ 25 * nOf26205 α inputs 17 + 2 ^ 26 * nOf26205 α inputs 15 + 2 ^ 27 * nOf26205 α inputs 14 + 2 ^ 28 * nOf26205 α inputs 11 + 2 ^ 29 * nOf26205 α inputs 10 + 2 ^ 30 * nOf26205 α inputs 8 + 2 ^ 31 * nOf26205 α inputs 7) := by
  have hone : lvAt α inputs map26205 0 = 1 := node0 α inputs hin0
  have hp : ∀ j, j < 72 → ((ts26205 j).map normPair).Perm
      (((formOf26205 j).pairs).map normPair) := by
    have h := perm26205
    simp only [List.all_eq_true, List.mem_range] at h
    exact fun j hj => List.isPerm_iff.mp (h j hj)
  have hw : ∀ j, j < 72 → ∀ i ∈ (formOf26205 j).wires, i < 33 ∧ i ≠ 0 := by
    have h := wire26205
    simp only [List.all_eq_true, List.mem_range, Bool.and_eq_true, decide_eq_true_eq] at h
    intro j hj i hi
    have hx := h j hj i hi
    exact ⟨hx.2, by omega⟩
  have hbit := rows_isBit (lvAt α inputs map26205) 33 72 hone hbl ts26205 formOf26205 hp hw
  have hv := rows_val (lvAt α inputs map26205) 72 ts26205 hbit
  exact inj26205 α hgen inputs (lvAt α inputs map26205) rfl hin0 (nOf26205 α inputs) hv.1 hv.2

/-- **Each row's bit, in the specification's vocabulary.** `Form.spec` is `xb`, `chb` and
    `majb` -- exactly what `SHA/Sigma.lean`'s rotation lemmas consume. -/
theorem spec26205 (α : F) (hgen : IsGen α) (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hz : ∀ e, e < 6656 → interpDag (raw.toDag (consts α)) inputs (assertOfB e) = 0) :
    ∀ j, j < 72 → nOf26205 α inputs j
      = Form.spec (fun i => bitOf (lvAt α inputs map26205 i)) (formOf26205 j) := by
  have hp : ∀ j, j < 72 → ((ts26205 j).map normPair).Perm
      (((formOf26205 j).pairs).map normPair) := by
    have h := perm26205
    simp only [List.all_eq_true, List.mem_range] at h
    exact fun j hj => List.isPerm_iff.mp (h j hj)
  have hw : ∀ j, j < 72 → ∀ i ∈ (formOf26205 j).wires, i < 33 ∧ i ≠ 0 := by
    have h := wire26205
    simp only [List.all_eq_true, List.mem_range, Bool.and_eq_true, decide_eq_true_eq] at h
    intro j hj i hi
    have hx := h j hj i hi
    exact ⟨hx.2, by omega⟩
  exact rows_spec (lvAt α inputs map26205) 33 72 (node0 α inputs hin0)
    (bl26205 α inputs hin0 hz) ts26205 formOf26205 hp hw

/-- **…and with nothing left but the artifact's own assertions.** -/
theorem injZ26205 (α : F) (hgen : IsGen α) (inputs : Nat → F) (hin0 : inputs 0 = 1)
    (hz : ∀ e, e < 6656 → interpDag (raw.toDag (consts α)) inputs (assertOfB e) = 0) :
    interpDag (raw.toDag (consts α)) inputs 26205
      = α ^ (2 ^ 0 * nOf26205 α inputs 64 + 2 ^ 1 * nOf26205 α inputs 63 + 2 ^ 2 * nOf26205 α inputs 61 + 2 ^ 3 * nOf26205 α inputs 60 + 2 ^ 4 * nOf26205 α inputs 57 + 2 ^ 5 * nOf26205 α inputs 56 + 2 ^ 6 * nOf26205 α inputs 54 + 2 ^ 7 * nOf26205 α inputs 53 + 2 ^ 8 * nOf26205 α inputs 49 + 2 ^ 9 * nOf26205 α inputs 48 + 2 ^ 10 * nOf26205 α inputs 46 + 2 ^ 11 * nOf26205 α inputs 45 + 2 ^ 12 * nOf26205 α inputs 42 + 2 ^ 13 * nOf26205 α inputs 41 + 2 ^ 14 * nOf26205 α inputs 39 + 2 ^ 15 * nOf26205 α inputs 38 + 2 ^ 16 * nOf26205 α inputs 33 + 2 ^ 17 * nOf26205 α inputs 32 + 2 ^ 18 * nOf26205 α inputs 30 + 2 ^ 19 * nOf26205 α inputs 29 + 2 ^ 20 * nOf26205 α inputs 26 + 2 ^ 21 * nOf26205 α inputs 25 + 2 ^ 22 * nOf26205 α inputs 23 + 2 ^ 23 * nOf26205 α inputs 22 + 2 ^ 24 * nOf26205 α inputs 18 + 2 ^ 25 * nOf26205 α inputs 17 + 2 ^ 26 * nOf26205 α inputs 15 + 2 ^ 27 * nOf26205 α inputs 14 + 2 ^ 28 * nOf26205 α inputs 11 + 2 ^ 29 * nOf26205 α inputs 10 + 2 ^ 30 * nOf26205 α inputs 8 + 2 ^ 31 * nOf26205 α inputs 7) :=
  injB26205 α hgen inputs hin0 (bl26205 α inputs hin0 hz)

end Sha256Gf2
